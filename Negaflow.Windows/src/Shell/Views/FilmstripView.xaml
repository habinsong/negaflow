<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid x:Name="Root" Background="{ThemeResource NegaflowBarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="6" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Background="{ThemeResource NegaflowSubtleFillBrush}" />
            <Border
                Width="44"
                Height="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource TextFillColorSecondaryBrush}"
                CornerRadius="1" />
            <primitives:Thumb
                x:Name="ResizeThumb"
                Background="Transparent"
                AutomationProperties.AutomationId="negaflow.filmstrip-resize"
                DragCompleted="OnResizeCompleted"
                DragDelta="OnResizeDelta"
                DragStarted="OnResizeStarted"
                IsTabStop="True"
                KeyDown="OnResizeKeyDown" />
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PreviousButton"
                Grid.Column="0"
                Width="34"
                Margin="8,10"
                Padding="0"
                Background="{ThemeResource NegaflowSubtleFillBrush}"
                BorderThickness="0"
                CornerRadius="8"
                IsEnabled="False">
                <FontIcon FontSize="13" Glyph="&#xE76B;" />
            </Button>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE7C8;" />
                <TextBlock x:Uid="noImages" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                Width="34"
                Margin="8,10"
                Padding="0"
                Background="{ThemeResource NegaflowSubtleFillBrush}"
                BorderThickness="0"
                CornerRadius="8"
                IsEnabled="False">
                <FontIcon FontSize="13" Glyph="&#xE76C;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
