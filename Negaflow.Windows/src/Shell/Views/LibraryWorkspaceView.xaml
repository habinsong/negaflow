<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.LibraryWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Grid x:Name="Root" Background="{ThemeResource NegaflowWindowBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ControlsPanel" Grid.Column="0" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="22,10,22,0" Spacing="7">
                <Button
                    x:Name="ImportRailButton"
                    AutomationProperties.AutomationId="negaflow.library.controls.importing"
                    Background="{ThemeResource NegaflowSelectionBrush}"
                    Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE896;" />
                </Button>
                <Button
                    x:Name="FilesRailButton"
                    AutomationProperties.AutomationId="negaflow.library.controls.files"
                    Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                </Button>
                <Button
                    x:Name="CollectionsRailButton"
                    AutomationProperties.AutomationId="negaflow.library.controls.collections"
                    Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE8FD;" />
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE896;" />
                    <TextBlock x:Name="ImportHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0" />
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

                <ScrollViewer Grid.Row="2">
                    <StackPanel Padding="12,14" Spacing="12">
                        <TextBlock x:Name="ImportSectionText" FontSize="13" FontWeight="SemiBold" />
                        <Border Padding="12" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="8">
                            <StackPanel Spacing="9">
                                <TextBlock x:Uid="importHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button x:Name="ImportImagesButton" IsEnabled="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="ControlsResizeThumb"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Background="Transparent"
            DragCompleted="OnResizeCompleted"
            DragDelta="OnResizeDelta"
            DragStarted="OnResizeStarted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Uid="libraryAllPhotos" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibraryCountText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="libraryFilters" Height="28" Padding="6,0" Background="Transparent" BorderThickness="0" IsEnabled="False" />
                    <Button Height="22" Padding="4,0" Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock x:Uid="sortInputOrder" FontSize="11" />
                            <FontIcon FontSize="9" Glyph="&#xE70E;" />
                        </StackPanel>
                    </Button>
                    <Button Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon FontSize="13" Glyph="&#xE80A;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <Grid Grid.Row="2">
                <StackPanel x:Name="EmptyLibraryPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                    <FontIcon FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8FD;" />
                    <TextBlock x:Uid="noImages" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <Button x:Name="EmptyImportImagesButton" HorizontalAlignment="Center" IsEnabled="False" />
                </StackPanel>

                <Grid x:Name="LibraryContentPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 읽지 못한 frame 을 조용히 감추면 사용자에게는 사진이 사라진 것으로 보인다. -->
                    <InfoBar
                        x:Name="LibraryIssueBar"
                        Grid.Row="0"
                        Margin="16,10,16,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <ListView
                        x:Name="FrameListView"
                        Grid.Row="1"
                        Padding="8,6"
                        AutomationProperties.AutomationId="negaflow.library.frames"
                        IsItemClickEnabled="False"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" Spacing="2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Opacity="0.45"
                    Spacing="6">
                    <Border Width="280" Padding="2" Background="{ThemeResource NegaflowSubtleFillBrush}" CornerRadius="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="libraryAllShort" Grid.Column="0" Padding="6,7" TextAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Uid="libraryFolders" Grid.Column="1" Padding="6,7" TextAlignment="Center" FontSize="11" />
                            <TextBlock x:Uid="libraryFilmType" Grid.Column="2" Padding="6,7" TextAlignment="Center" FontSize="11" />
                            <TextBlock x:Uid="libraryOffline" Grid.Column="3" Padding="6,7" TextAlignment="Center" FontSize="11" />
                        </Grid>
                    </Border>
                    <TextBox x:Uid="librarySearchPlaceholder" Width="280" Height="28" IsReadOnly="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
