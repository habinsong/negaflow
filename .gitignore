# 샘플 이미지 / 로컬 분석 데이터
negaflow-mac/samples/
negaflow-mac/LUT_target/

# Python 캐시
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
.coverage.*
htmlcov/

# 로컬 작업 메모 / 초안 설계 (공개 대상 아님)
HIGHLIGHT_TONE_REDESIGN.md
GRAINMEND_DESIGN.md
NEGAFLOW_LIGHTROOM_EXPANSION.md
/PERFORMANCE_STRESS_AUDIT_*.md
/UI_UX_IMPLEMENTATION_REQUESTS.md

# 만드는 과정에서 남긴 기록이다. 끝난 일, 남은 일, 왜 그렇게 정했는지 같은 것들이라
# 공개하지 않는다. 공개하는 문서는 docs/ 와 negaflow-mac/docs/, negaflow-windows/docs/
# 에 둔다.
#
# 여기 규칙은 새 파일에만 걸린다. 이미 추적 중인 파일은 git rm --cached 로 따로
# 빼야 한다 (2026-08-30 에 126 개를 그렇게 뺐다).
/windows_docs/
/negaflow-windows/dev-notes/
/negaflow-mac/dev-notes/
/docs/research/
/docs/*/research/
/docs/validation/
/docs/*/validation/
/docs/product/PROJECT_STATUS.md
/docs/*/product/PROJECT_STATUS.md

# 골든 자료 자체는 공개한다. 테스트가 읽기 때문이다. 다만 그 폴더에 같이 있던 글은
# 맥 쪽에 값을 찍어 달라고 부탁한 기록과 그 진행 메모라서 공개하지 않는다.
/docs/verification/macos-golden/*.md
/docs/verification/macos-golden/*/README.md

# docs/verification/macos-golden 은 공개한다. 개발 기록이 아니라 macOS 판에서 뽑아 둔
# 골든 이미지이고, negaflow-windows/CMakeLists.txt 의 골든 테스트가 이 파일들을 읽는다.
# 빼면 새로 받은 사람이 테스트를 돌릴 수 없다.

# 일회성 코드 감사 / 청크 생성물
/all_swift_files.txt
/chunk_*
/review_chunk_*.md
/codebase_map.md
/codebase_technical_debt.md
/]+

# 중단된 git filter-branch 가 남긴 작업 디렉터리
.git-rewrite/

# libraw.dll 을 만드는 작업 디렉터리 (소스 tarball + 빌드 산출물)
/negaflow-windows/build-libraw/

# 사용자의 로컬 LUT 자료입니다. 저장소에 둘 이유가 없어 추적만 뺐고, 파일은 그대로
# 자리에 있습니다 (10 x 33^3 float64, 2.9 MB).
/g33.npy
