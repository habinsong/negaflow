# SwiftPM / Xcode 빌드 부산물
.build/
build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult/
*.xcarchive/
*.dSYM/
*.xccovreport
*.xccovarchive
*.profraw
*.profdata
*.app/
*.dmg
*.pkg

# 로컬 환경 / 자격 증명
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.mobileprovision

# 로컬 이미지 / 분석 입력
*.tiff
# 아래 경로들은 앞의 *.tiff 규칙에서 빼낸다. 슬래시가 들어간 규칙은 이 파일이 있는
# 자리를 기준으로 잡히므로 negaflow-mac/ 까지 적어야 맞는다. 예전에는 그 앞부분이
# 빠져 있어서 규칙이 걸리지 않았고, 스캐너 코드가 쓰는 리소스 네 개가 계속 제외
# 대상으로 잡혀 있었다.
!negaflow-mac/Sources/ScannerKit/Resources/*.tiff
!docs/verification/macos-golden/**/*.tiff

# macOS / 편집기 메타데이터
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
.idea/
.vscode/
*.swp
*.swo
*~

