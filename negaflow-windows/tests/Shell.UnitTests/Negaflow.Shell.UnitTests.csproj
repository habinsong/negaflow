<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Negaflow.Shell.UnitTests</AssemblyName>
    <RootNamespace>Negaflow.Shell.UnitTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Shell.Core\Negaflow.Shell.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\baseline\swift-ui-metrics.json"
             Link="swift-ui-metrics.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 씨앗 모드가 실제 TIFF 의 화소 수를 읽으려면 네이티브 엔진이 옆에 있어야 합니다.
       시험 자체는 네이티브를 부르지 않으므로, 없으면 그냥 넘어갑니다. -->
  <PropertyGroup>
    <SeedNativePreset Condition="'$(Configuration)' == 'Release'">x64-release</SeedNativePreset>
    <SeedNativePreset Condition="'$(Configuration)' != 'Release'">x64-debug</SeedNativePreset>
    <SeedNativeLibrary>$(MSBuildThisFileDirectory)..\..\out\build\native\$(SeedNativePreset)\$(Configuration)\Negaflow.Native.dll</SeedNativeLibrary>
  </PropertyGroup>
  <Target Name="CopyNativeEngineForSeeding" AfterTargets="Build" Condition="Exists('$(SeedNativeLibrary)')">
    <Copy SourceFiles="$(SeedNativeLibrary)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
