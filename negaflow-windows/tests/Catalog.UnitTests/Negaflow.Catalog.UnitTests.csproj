<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Negaflow.Catalog.UnitTests</AssemblyName>
    <RootNamespace>Negaflow.Catalog.UnitTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Catalog.Core\Negaflow.Catalog.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\fixtures\catalog\develop-route-v1.json"
             Link="develop-route-v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- 앱이 싣는 것과 같은 파일을 그대로 읽습니다. 테스트용 사본을 따로 두면 프로파일이
         바뀌어도 테스트는 통과하는 자리가 생깁니다. -->
    <Content Include="..\..\assets\presets\*.json"
             Link="presets\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
