<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Negaflow.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Negaflow.Shell.Views"
    Title="negaflow">
    <Grid x:Name="WindowRoot">
        <!--  셸이 들어올 자리입니다. **비어 있습니다.**

              셸을 여기 적어 두면 그 XAML(실측 800ms)이 창을 띄우기 전에 펴지고, 그동안
              사용자는 아무 것도 없는 창 - 검은 화면 - 을 봅니다. 로딩 화면도 같은 XAML 에
              있으니 그때는 아직 존재하지도 않아 보일 수가 없습니다.

              창은 로딩 화면만 갖고 즉시 뜨고, 셸은 그 뒤에 코드로 만들어 여기 넣습니다.  -->
        <Grid x:Name="ShellHost" x:FieldModifier="internal" />

        <!--  뜨는 동안 보이는 화면입니다.

              배경을 칠하지 않습니다 - 창은 이미 투명하게 확장돼 있고, 여기에 색을 칠하면
              그것이 곧 사용자가 말한 검은 화면입니다. 아이콘과 이름만 떠 있게 둡니다.

              셸이 첫 프레임을 그리면 걷어냅니다(`MainWindow.OnFirstRendered`).  -->
        <Grid
            x:Name="LoadingOverlay" x:FieldModifier="internal"
            Background="{x:Null}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <Image
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Source="ms-appx:///Assets/AppIcon-App-1024.png" />
                <!--  아방가르드하게 - 굵게, 자간을 넓혀 소문자 이름을 표지처럼 세웁니다.  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    CharacterSpacing="260"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="negaflow" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
