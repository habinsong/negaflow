<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Negaflow.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Negaflow.Shell.Views"
    xmlns:imaging="using:Microsoft.UI.Xaml.Media.Imaging"
    Title="negaflow">
    <Grid x:Name="WindowRoot">
        <!--  셸이 들어올 자리입니다. **비어 있습니다.**

              셸을 여기 적어 두면 그 XAML(실측 800ms)이 창을 띄우기 전에 펴지고, 그동안
              사용자는 아무 것도 없는 창 - 검은 화면 - 을 봅니다. 로딩 화면도 같은 XAML 에
              있으니 그때는 아직 존재하지도 않아 보일 수가 없습니다.

              창은 로딩 화면만 갖고 즉시 뜨고, 셸은 그 뒤에 코드로 만들어 여기 넣습니다.  -->
        <Grid x:Name="ShellHost" x:FieldModifier="internal" />

        <!--  뜨는 동안 보이는 화면입니다.

              배경을 칠하지 않습니다 - 창은 이미 투명하게 확장돼 있고, 여기에 색을 칠하면
              그것이 곧 사용자가 말한 검은 화면입니다. 아이콘과 이름만 떠 있게 둡니다.

              셸이 첫 프레임을 그리면 걷어냅니다(`MainWindow.OnFirstRendered`).  -->
        <Grid
            x:Name="LoadingOverlay" x:FieldModifier="internal"
            Background="{x:Null}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <!--  **작게 디코딩합니다.** 원본은 1024×1024 · 957KB 라, 그대로 펴면
                      실측 4.36 초가 걸려 로고를 보여 줄 시간에 아직 그림이 없습니다.
                      화면에 쓰는 크기만큼만 폅니다.  -->
                <Image
                    x:Name="LoadingIcon" x:FieldModifier="internal"
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    ImageFailed="OnLoadingIconFailed"
                    ImageOpened="OnLoadingIconOpened">
                    <Image.Source>
                        <BitmapImage
                            DecodePixelHeight="96"
                            DecodePixelType="Logical"
                            DecodePixelWidth="96"
                            UriSource="ms-appx:///Assets/AppIcon-1024.png" />
                    </Image.Source>
                </Image>
                <!--  아방가르드하게 - 대문자, 굵게, 자간을 크게 벌려 표지처럼 세웁니다.

                      글꼴은 `Bahnschrift` 입니다. Windows 10 부터 기본 탑재되는 기하학적
                      산세리프라 **따로 싣지 않고 시스템 것을 그대로 쓰므로 라이선스 문제가
                      없습니다.** 없는 기계에서는 XAML 이 기본 글꼴로 물러납니다.

                      앱이 고른 테마를 따릅니다. 다크는 흰색, 라이트는 검정이며, 테마
                      변경 뒤에도 `ThemeResource`가 즉시 다시 풉니다.  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    CharacterSpacing="420"
                    FontFamily="Bahnschrift"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{ThemeResource NegaflowStartupTextBrush}"
                    Text="NEGAFLOW" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
