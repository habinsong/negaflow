<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="Negaflow.Windows" Publisher="CN=Negaflow" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="83dc4a8f-696d-4d0c-9d01-6a588c01d065" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>negaflow</DisplayName>
    <PublisherDisplayName>Negaflow</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <!--
        작업 표시줄·Alt+Tab·작업 보기는 Square44x44Logo 를 쓰고, `altform-unplated` 자산이
        있을 때만 **판 없이** 그립니다. 앞 판은 1024 원본 하나를 그대로 걸어서 그 이름 규칙이
        없었고, 셸이 로고 뒤에 반투명 흰 판을 깔았습니다. 자산은
        `scripts/generate-app-icon.py` 가 투명 원본에서 만듭니다.
      -->
      <uap:VisualElements DisplayName="negaflow" Description="negaflow" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
