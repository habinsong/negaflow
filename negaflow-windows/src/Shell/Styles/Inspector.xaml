<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        인화 인스펙터의 글자 칸과 단추입니다. macOS `PrintInspectorTextField` ·
        `PrintInspectorTransientButtonStyle`(Features/Print/PrintInspectorComponents.swift)
        그대로입니다 — **테두리 없는 투명한 자리**이고, 마우스를 올리거나 글자를 넣을 때만
        음영이 생깁니다. WinUI 기본 TextBox·Button 의 네모 테두리를 쓰지 않습니다.
    -->

    <Style x:Key="NegaflowInspectorTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="InspectorTextRoot" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="InspectorTextSurface" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Disabled"
                            IsHorizontalRailEnabled="False"
                            IsTabStop="False"
                            IsVerticalRailEnabled="False"
                            VerticalAlignment="Center"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            ZoomMode="Disabled"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock
                            x:Name="PlaceholderTextContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsHitTestVisible="False"
                            Text="{TemplateBinding PlaceholderText}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="InspectorTextSurface.Background" Value="{ThemeResource NegaflowSubtleFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="InspectorTextSurface.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="InspectorTextRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        macOS `PrintInspectorTransientButtonStyle` — 평상시 투명, 마우스 올림 primary 8%,
        누름 12%. 라운딩 8 · 좌우 여백 10 · 최소 높이 30.
    -->
    <Style x:Key="NegaflowInspectorButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="InspectorButtonRoot" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="InspectorButtonSurface" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            x:Name="InspectorButtonContent"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="InspectorButtonSurface.Background" Value="{ThemeResource NegaflowSubtleFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="InspectorButtonSurface.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                        <Setter Target="InspectorButtonContent.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="InspectorButtonRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
