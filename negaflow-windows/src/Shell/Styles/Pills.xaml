<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!--
        macOS 의 알약 단추입니다 (DevelopQuickActionsSection.swift 의 QuickTogglePill·
        QuickActionPill, ExportActionPill.swift).

        macOS 는 `.buttonStyle(.plain)` 에 손수 칠한 바탕만 씁니다:
          · 알약 전체       frame(maxWidth: .infinity, minHeight: 32) + contentShape(Rectangle())
          · 켜짐(토글)      Color.accentColor.opacity(0.2), 라운딩 12, 글자·아이콘은 강조색
          · 마우스 올림     Color.primary.opacity(0.12), 라운딩 12
          · 바깥 표면       liquidSurface(cornerRadius: 15) — 알약을 감싼 Border 가 맡습니다.

        WinUI 기본 ToggleButton 판형은 켜지면 ContentPresenter 를 강조색으로 꽉 칠하고
        (강조색 바탕 + 강조색 글자 → 글자가 안 보임), 테두리·안쪽 여백만큼 칠이 작아져
        음영 크기도 어긋납니다. 그래서 판형을 macOS 구조 그대로 다시 짭니다.
    -->

    <Style x:Key="NegaflowPillToggleStyle" TargetType="primitives:ToggleButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ToggleButton">
                    <Grid x:Name="PillRoot" Background="Transparent" CornerRadius="12">
                        <Border x:Name="PillHover" CornerRadius="12" />
                        <Border x:Name="PillFill" CornerRadius="12" />
                        <ContentPresenter
                            x:Name="PillContent"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                        <Setter Target="PillContent.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <!-- WinUI 의 ToggleButton 은 켜짐도 CommonStates 한 무리로 다룹니다.
                                     (WPF 처럼 CheckStates 가 따로 있지 않습니다.) -->
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="PillFill.Background" Value="{ThemeResource NegaflowAccentSoftBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource NegaflowAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillFill.Background" Value="{ThemeResource NegaflowAccentSoftBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource NegaflowAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillFill.Background" Value="{ThemeResource NegaflowAccentSoftBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource NegaflowAccentBrush}" />
                                        <Setter Target="PillContent.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="PillFill.Background" Value="{ThemeResource NegaflowAccentSoftBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource NegaflowAccentBrush}" />
                                        <Setter Target="PillRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NegaflowPillButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="PillRoot" Background="Transparent" CornerRadius="12">
                        <Border x:Name="PillHover" CornerRadius="12" />
                        <ContentPresenter
                            x:Name="PillContent"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                        <Setter Target="PillContent.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 알약 오른쪽의 되돌리기 — macOS 는 24×24 원(Circle)입니다. -->
    <Style
        x:Key="NegaflowPillResetButtonStyle"
        BasedOn="{StaticResource NegaflowPillButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
