<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.WorkspaceShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Negaflow.Shell.Views"
    AutomationProperties.AutomationId="negaflow.main"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    Loaded="OnShellLoadedForShortcuts"
    PreviewKeyDown="OnShellPreviewKeyDown">
    <Grid Background="{ThemeResource NegaflowWindowBrush}">
        <!--  **첫째 줄이 제목 표시줄입니다.** 메뉴, 가운데 사진 표시, 작업 전환과 보기
              단추가 모두 여기 있고, 빈 곳을 두 번 누르면 창이 최대화됩니다.
              둘째 줄에는 스캔·내보내기 단추만 놓입니다.

              메뉴와 동작 단추는 만들어진 뒤 자리를 옮깁니다 — 메뉴는 셸이 이름으로
              들고 있어야 하고(신호를 여기서 받습니다), 동작 단추의 처리기는 툴바가
              들고 있기 때문입니다.  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:WorkspaceToolbarView x:Name="Toolbar" Grid.Row="0" />
        <Border x:Name="ActionBarHost" Grid.Row="1" Padding="12,4,10,6" />
        <views:AppMenuBarView x:Name="AppMenu" Grid.Row="0" Visibility="Collapsed" />
        <Border Grid.Row="2" Background="{ThemeResource NegaflowDividerBrush}" />

        <!--  **세 화면을 한꺼번에 만들지 않습니다.**

              앱이 뜰 때 보여 줄 것은 마지막으로 본 화면 하나뿐인데, 앞 판은 셋을 모두
              만들었습니다. 실측으로 라이브러리 98ms · 현상 358ms · 인화 65ms 이고, 그
              전부가 창이 뜨기 전에 들어갔습니다 - 그동안 사용자는 검은 화면을 봅니다.

              `x:Load="False"` 는 `FindName` 이 부를 때까지 만들지 않습니다. 실체화는
              `Initialize` 가 하고, 그 `Initialize` 는 창을 띄운 뒤에 돕니다.  -->
        <Grid Grid.Row="3">
            <views:LibraryWorkspaceView x:Name="LibraryWorkspace" Visibility="Collapsed" />
            <views:DevelopWorkspaceView x:Name="DevelopWorkspace" />
            <views:PrintWorkspaceView x:Name="PrintWorkspace" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
