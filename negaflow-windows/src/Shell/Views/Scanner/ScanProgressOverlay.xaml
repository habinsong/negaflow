<UserControl
    x:Class="Negaflow.Shell.Views.Scanner.ScanProgressOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--  macOS `ScanProgressOverlay.swift` 그대로입니다.

          .frame(width: 264)                        → Width="264"
          VStack(alignment: .leading, spacing: 6)   → Spacing="6", 왼쪽 정렬
          HStack(spacing: 8)                        → 두 칸 사이 8
          Label(…, systemImage: "scanner")          → 스캐너 glyph + 단계 이름
          .font(.caption.weight(.semibold))         → 11 / SemiBold
          Spacer(minLength: 12)                     → 가운데 빈칸이 벌어짐
          Text("N%") .font(.caption2.monospacedDigit()) .foregroundStyle(.secondary)
          ProgressView(value:) .frame(width: 240)   → Width="240"
          Text(statusCenter.message) .font(.caption2) .foregroundStyle(.secondary)
              .lineLimit(1) .minimumScaleFactor(...)
          .padding(.horizontal, 12) .padding(.vertical, 9)
          .cardSurface(cornerRadius: 10)            → 카드 배경 + 1px 테두리, 반지름 10
    -->
    <Border
        x:Name="Card"
        Width="264"
        Padding="12,9"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Glyph="&#xE8FE;" />
                    <TextBlock
                        x:Name="PhaseText"
                        FontSize="11"
                        FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="2"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <TextBlock.TextDecorations>None</TextBlock.TextDecorations>
                </TextBlock>
            </Grid>

            <ProgressBar
                x:Name="Bar"
                Width="240"
                HorizontalAlignment="Left"
                Maximum="1"
                Minimum="0" />

            <TextBlock
                x:Name="MessageText"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
    </Border>
</UserControl>
