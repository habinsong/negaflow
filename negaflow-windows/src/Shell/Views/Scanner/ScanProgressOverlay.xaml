<UserControl
    x:Class="Negaflow.Shell.Views.Scanner.ScanProgressOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--  macOS `ScanProgressOverlay.swift` 그대로입니다.

          .frame(width: 264)                        → Width="264"
          VStack(alignment: .leading, spacing: 6)   → Spacing="6", 왼쪽 정렬
          HStack(spacing: 8)                        → 두 칸 사이 8
          Label(…, systemImage: "scanner")          → 스캐너 glyph + 단계 이름
          .font(.caption.weight(.semibold))         → 11 / SemiBold
          Spacer(minLength: 12)                     → 가운데 빈칸이 벌어짐
          Text("N%") .font(.caption2.monospacedDigit()) .foregroundStyle(.secondary)
          ProgressView(value:) .frame(width: 240)   → Width="240"
          Text(statusCenter.message) .font(.caption2) .foregroundStyle(.secondary)
              .lineLimit(1) .minimumScaleFactor(...)
          .padding(.horizontal, 12) .padding(.vertical, 9)
          .cardSurface(cornerRadius: 10)            → 카드 배경 + 1px 테두리, 반지름 10

          배경과 글자색은 **테마를 따라가지 않습니다** — 사진 위에 뜨는 카드라
          라이트 테마의 흰 카드는 밝은 사진 위에서 사라집니다. 두 테마 모두 진회색 +
          흰 글자입니다(`NegaflowScanProgress*Brush`).

          배경은 **불투명**이어야 합니다. macOS `CardSurface` 는
          `Color(nsColor: .controlBackgroundColor)` 로 칠하는데 그것이 불투명입니다.
          WinUI 의 `CardBackgroundFillColorDefaultBrush` 는 다크에서 흰색 5% 라 사실상
          투명이고, 사진 위에 얹히면 글자가 그림에 묻혀 읽히지 않습니다. 앱이 이미 쓰는
          `NegaflowCardBrush`(다크 #FF333436 · 라이트 흰색)가 그 자리입니다.
    -->
    <Border
        x:Name="Card"
        Width="264"
        Padding="12,9"
        Background="{ThemeResource NegaflowScanProgressCardBrush}"
        BorderBrush="{ThemeResource NegaflowScanProgressBorderBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource NegaflowScanProgressTextBrush}"
                        Glyph="&#xE8FE;" />
                    <TextBlock
                        x:Name="PhaseText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource NegaflowScanProgressTextBrush}" />
                </StackPanel>

                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="2"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    FontSize="11"
                    Foreground="{ThemeResource NegaflowScanProgressSecondaryTextBrush}">
                    <TextBlock.TextDecorations>None</TextBlock.TextDecorations>
                </TextBlock>
            </Grid>

            <ProgressBar
                x:Name="Bar"
                Width="240"
                HorizontalAlignment="Left"
                Maximum="1"
                Minimum="0" />

            <TextBlock
                x:Name="MessageText"
                FontSize="11"
                Foreground="{ThemeResource NegaflowScanProgressSecondaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>
    </Border>
</UserControl>
