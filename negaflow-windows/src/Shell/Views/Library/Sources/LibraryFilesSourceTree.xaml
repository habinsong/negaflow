<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Library.Sources.LibraryFilesSourceTree"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sources="using:Negaflow.Shell.Views.Library.Sources">
    <!-- macOS `LibraryFolderTreeView` — 사진을 담고 있는 폴더와 그 폴더의 사진만 냅니다. -->
    <sources:LibraryFolderTreeView
        x:Name="FilesTree"
        x:FieldModifier="internal"
        Padding="4,6"
        AutomationProperties.AutomationId="negaflow.library.sources.files" />
</UserControl>
