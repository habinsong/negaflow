<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Library.Defaults.DevelopInputCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="3" HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 최소 창 폭(1350px)에서 긴 언어는 제목이 잘립니다. 말줄임 없이 자르면
                 "Eingangsg" 처럼 단어 중간에서 끊겨 무슨 줄인지 알 수 없습니다 - macOS
                 `Text` 는 꼬리 말줄임이 기본이고, 이 저장소의 다른 카드도 모두
                 `CharacterEllipsis` 를 씁니다(DevelopBaseCard). -->
            <TextBlock x:Name="GammaLabel" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AutomaticReadout" Grid.Column="1" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3,1" />
            <Button x:Name="ValueButton" Grid.Column="1" HorizontalAlignment="Right" FontSize="12"
                    Padding="3,1" Background="Transparent" BorderThickness="0" Click="OnEditValue" />
            <TextBox x:Name="ValueEditor" Grid.Column="1" Visibility="Collapsed" MinWidth="0"
                     MinHeight="0" Padding="3,1" FontSize="12" TextAlignment="Right"
                     BeforeTextChanging="OnBeforeTextChanging" KeyDown="OnEditorKeyDown" LostFocus="OnEditorLostFocus" />
            <!-- 초기화는 숫자 **오른쪽**입니다. 숫자 왼쪽에 두면 값과 제목 사이에 끼어
                 눌러야 할 것으로 보이지 않습니다. -->
            <Button x:Name="ResetButton" Grid.Column="2" Padding="2,0" MinWidth="0" MinHeight="0"
                    Width="18" Height="18" VerticalAlignment="Center" Background="Transparent"
                    BorderThickness="0" Click="OnReset">
                <FontIcon Glyph="&#xE777;" FontSize="10" />
            </Button>
        </Grid>
        <Border Style="{StaticResource NegaflowSegmentTrackStyle}">
            <Grid ColumnSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="AutoModeButton" GroupName="InputGammaMode"
                             Style="{StaticResource NegaflowSegmentStyle}" Checked="OnAutoMode" />
                <RadioButton x:Name="ManualModeButton" Grid.Column="1" GroupName="InputGammaMode"
                             Style="{StaticResource NegaflowSegmentStyle}" Checked="OnManualMode" />
            </Grid>
        </Border>
        <Grid x:Name="ManualTrack" DoubleTapped="OnResetTrack">
            <Slider x:Name="GammaSlider" Minimum="0.1" Maximum="4" Value="2.2" StepFrequency="0.1"
                    SmallChange="0.1" LargeChange="1.0" MinHeight="20"
                    ValueChanged="OnSliderChanged" PreviewKeyDown="OnSliderKeyDown" KeyUp="OnSliderKeyUp"
                    LostFocus="OnSliderLostFocus" />
        </Grid>
    </StackPanel>
</UserControl>
