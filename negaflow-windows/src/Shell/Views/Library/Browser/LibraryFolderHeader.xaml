<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Library.Browser.LibraryFolderHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    HorizontalAlignment="Stretch"
    Tag="{Binding}">
    <UserControl.Resources>
        <controls:ThicknessTextConverter x:Key="ThicknessTextConverter" />
    </UserControl.Resources>
    <!--
        macOS `folderSectionHeader`(`LibraryWorkspaceView+Grid.swift`) 와
        `LibraryFolderDevelopmentControls` 입니다.

          HStack(spacing: 8) { 화살표, 폴더, 이름, N장, 현상 컨트롤, Spacer(minLength: 0) }
          .padding(6).padding(.top, isFirst ? 0 : 16)

        현상 컨트롤만 `HStack(spacing: 7)` 이라 따로 묶습니다 — 바깥 8 과 다른 값입니다.
        머리줄은 왼쪽부터 차례로 붙고 남는 폭은 오른쪽에 남깁니다(Spacer).

         **이 파일은 `x:Class` 를 가진 UserControl 이어야 합니다.** 예전에는 `x:Class` 없는
           ResourceDictionary 안의 DataTemplate 이었는데, WinUI XAML 컴파일러는 그런 파일에
           `IComponentConnector` 를 만들지 않습니다. 그러면 여기 적힌 `Click`·`SelectionChanged`
           가 **한 개도 연결되지 않고** 머리줄 전체가 그려지기만 하는 죽은 UI 가 됩니다
           (생성물 `LibraryFolderHeader.g.cs` 가 빈 파일이고, 페이지의 커넥터에도 이 핸들러
           이름이 없었습니다). 같은 이유로 `LibraryFrameCard` 도 UserControl 입니다.
    -->
    <Grid
        Margin="{Binding HeaderMargin, Converter={StaticResource ThicknessTextConverter}}"
        ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 접기/펼치기. macOS 는 펼침 ⌄ · 접힘 › 입니다. -->
        <Button
            Width="20"
            Height="20"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="negaflow.library.folder.disclosure"
            Background="Transparent"
            BorderThickness="0"
            Click="OnDisclosureClicked">
            <FontIcon
                x:Name="DisclosureIcon"
                FontSize="10"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{Binding DisclosureGlyph}" />
        </Button>
        <FontIcon
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="&#xE8B7;" />
        <!-- macOS `.font(.headline.weight(.semibold))` -->
        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="13"
            FontWeight="SemiBold"
            Text="{Binding Title}"
            TextTrimming="CharacterEllipsis" />
        <!-- macOS `.font(.caption.monospacedDigit()).foregroundStyle(.secondary)` -->
        <TextBlock
            Grid.Column="3"
            VerticalAlignment="Center"
            FontFamily="Consolas"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding FrameCountLabel}" />
        <!-- macOS `LibraryFolderDevelopmentControls` — 이 셋만 `HStack(spacing: 7)` 입니다. -->
        <StackPanel
            Grid.Column="4"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="7">
            <!--  macOS 는 `width: 98` 입니다. 그 폭 안에 SwiftUI 는 `C-41/ECN-2` 를 다
                  담지만, WinUI 콤보박스는 펼침 화살표 칸과 안쪽 여백이 훨씬 커서 같은
                  98 에서는 글자가 잘립니다. 그래서 **최소** 폭으로 둡니다 - macOS 보다
                  좁아지지 않으면서, `Digital Color` 처럼 더 긴 이름이나 다른 언어에서도
                  잘리지 않습니다.  -->
            <ComboBox
                x:Name="ProcessSelector" x:FieldModifier="internal"
                MinWidth="98"
                Height="30"
                CornerRadius="8"
                AutomationProperties.AutomationId="negaflow.library.folder.process"
                DisplayMemberPath="Name"
                FontSize="12"
                ItemsSource="{Binding ProcessChoices}"
                SelectedIndex="{Binding ProcessIndex, Mode=OneWay}"
                SelectionChanged="OnProcessChanged" />
            <ComboBox
                x:Name="TargetSelector" x:FieldModifier="internal"
                MinWidth="84"
                Height="30"
                CornerRadius="8"
                AutomationProperties.AutomationId="negaflow.library.folder.target"
                DisplayMemberPath="Name"
                FontSize="12"
                ItemsSource="{Binding TargetChoices}"
                SelectedIndex="{Binding TargetIndex, Mode=OneWay}"
                SelectionChanged="OnTargetChanged" />
            <Button
                x:Name="ApplyButton" x:FieldModifier="internal"
                Height="30"
                Padding="10,0"
                AutomationProperties.AutomationId="negaflow.library.folder-develop-apply"
                Click="OnApplyClicked"
                CornerRadius="8"
                FontSize="12"
                FontWeight="SemiBold" />
            <!-- macOS `LibraryTaskProgressView(progress:barWidth: 60)`:
                 HStack(spacing: 6) { ProgressView(width 60), "%" minWidth 30 trailing,
                                      "n/N" minWidth 38 trailing }
                 .font(.caption2.monospacedDigit()).foregroundStyle(.secondary)
                 적용을 누른 뒤에만 나타나고, 끝나면 1.2초 뒤 사라집니다. -->
            <StackPanel
                x:Name="ProgressPanel" x:FieldModifier="internal"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <ProgressBar
                    x:Name="ProgressBarControl" x:FieldModifier="internal"
                    Width="60"
                    VerticalAlignment="Center"
                    Maximum="1"
                    Minimum="0" />
                <TextBlock
                    x:Name="ProgressPercentText" x:FieldModifier="internal"
                    MinWidth="30"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right" />
                <TextBlock
                    x:Name="ProgressCountText" x:FieldModifier="internal"
                    MinWidth="38"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
