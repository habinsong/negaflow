<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Library.Browser.LibraryFrameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    Tag="{Binding}">
    <UserControl.Resources>
        <controls:FilmTypeNameConverter x:Key="FilmTypeNameConverter" />
        <controls:PickStateBrushConverter x:Key="PickStateBrushConverter" />
    </UserControl.Resources>
    <!--
        카드 한 장의 구조는 macOS FrameStripItemView 와 같습니다 — 썸네일,
        3pt 간격, 이름, 필름 종류, 그리고 맨 아래 별점입니다. 카드 크기는
        컨테이너에서 정하므로 여기서는 비율만 잡습니다.
    -->
    <Grid
        Padding="8"
        RightTapped="OnCardRightTapped"
        RowSpacing="0"
        Tag="{Binding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Background="{ThemeResource NegaflowThumbnailWellBrush}" CornerRadius="6" />
            <Border
                CornerRadius="6"
                Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
            </Border>
            <FontIcon
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE91B;"
                Visibility="{Binding IsThumbnailPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- macOS 는 깃발을 썸네일 왼쪽 위에 5pt 띄워 답니다. -->
            <FontIcon
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="12"
                Foreground="{Binding PickState, Converter={StaticResource PickStateBrushConverter}}"
                Glyph="{Binding PickGlyph}"
                Visibility="{Binding IsFlagged, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!-- 묶음 배지는 macOS 와 같이 오른쪽 위입니다. -->
            <Border
                Margin="5"
                Padding="6,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#B8000000"
                CornerRadius="9"
                Visibility="{Binding HasStack, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <FontIcon FontSize="10" Foreground="White" Glyph="{Binding StackGlyph}" />
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding StackCount}" />
                </StackPanel>
            </Border>
            <Button x:Name="LibraryLocateOriginalLocalized"
                Margin="5"
                Padding="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#B8000000"
                BorderThickness="0"
                CornerRadius="9"
                FontSize="10"
                Click="OnLocateOriginalClicked"
                Tag="{Binding}"
                Visibility="{Binding IsSourceOffline, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            FontSize="12"
            FontWeight="SemiBold"
            Text="{Binding DisplayName}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Grid.Row="3"
            Margin="0,2,0,0"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding FilmType, Converter={StaticResource FilmTypeNameConverter}}"
            TextTrimming="CharacterEllipsis" />
        <controls:FrameRatingStars
            Grid.Row="4"
            HorizontalAlignment="Left"
            Rating="{Binding Rating}"
            RatingCommitted="OnRatingCommitted"
            Tag="{Binding}" />
    </Grid>
</UserControl>
