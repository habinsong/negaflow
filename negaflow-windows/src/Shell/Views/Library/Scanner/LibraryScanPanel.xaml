<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Library.Scanner.LibraryScanPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="ScanSectionText" x:FieldModifier="internal"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="ScanSectionCard" x:FieldModifier="internal"
                            Padding="12"
                            Background="{ThemeResource NegaflowCardBrush}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="9">
                                <TextBlock
                                    x:Name="ScanStateText" x:FieldModifier="internal"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="ScanApprovePluginButton" x:FieldModifier="internal"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.library.scan.approve"
                                    Click="OnScanApprovePluginClicked"
                                    Visibility="Collapsed" />
                                <ToggleSwitch
                                    x:Name="ScanSimulatorToggle" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="negaflow.library.scan.simulator"
                                    Toggled="OnScanSimulatorToggled" />

                                <StackPanel x:Name="ScanControls" x:FieldModifier="internal" Spacing="9" Visibility="Collapsed">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanDeviceLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox
                                            x:Name="ScanDeviceSelector" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.library.scan.device"
                                            SelectionChanged="OnScanDeviceChanged" />
                                        <Button
                                            x:Name="ScanRescanButton" x:FieldModifier="internal"
                                            Grid.Column="2"
                                            Padding="7,4"
                                            AutomationProperties.AutomationId="negaflow.scanner.rescan"
                                            Click="OnScanRescanClicked"
                                            Content="&#xE72C;"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanFilmLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox
                                            x:Name="ScanFilmSelector" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            MinWidth="132"
                                            AutomationProperties.AutomationId="negaflow.library.scan.film"
                                            SelectionChanged="OnScanFilmChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanFolderNameLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox
                                            x:Name="ScanFolderNameBox" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="negaflow.library.scan.folder-name"
                                            TextAlignment="Right"
                                            TextChanged="OnScanFolderNameChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="ScanResolutionSelector" x:FieldModifier="internal"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="negaflow.library.scan.resolution"
                                            SelectionChanged="OnScanResolutionChanged" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="|" />
                                        <ComboBox
                                            x:Name="ScanColorModeSelector" x:FieldModifier="internal"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.AutomationId="negaflow.library.scan.color-mode"
                                            SelectionChanged="OnScanColorModeChanged" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="ScanBitDepthUnavailableText" x:FieldModifier="internal"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="ScanBitDepthRow" x:FieldModifier="internal" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanBitDepthLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox
                                            x:Name="ScanBitDepthSelector" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            MinWidth="132"
                                            AutomationProperties.AutomationId="negaflow.library.scan.bit-depth"
                                            SelectionChanged="OnScanBitDepthChanged" />
                                    </Grid>
                                    <Grid x:Name="ScanFrameFormatRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanFrameFormatLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox
                                            x:Name="ScanFrameFormatSelector" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            MinWidth="152"
                                            AutomationProperties.AutomationId="negaflow.library.scan.frame-format"
                                            SelectionChanged="OnScanFrameFormatChanged" />
                                    </Grid>
                                    <Grid x:Name="ScanDetectionModeRow" x:FieldModifier="internal" ColumnSpacing="6" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanDetectionModeLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <RadioButton
                                            x:Name="ScanDetectionAutomaticButton" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="negaflow.library.scan.detection.automatic"
                                            Checked="OnScanDetectionModeChecked"
                                            GroupName="FlatbedDetectionMode"
                                            IsChecked="True" />
                                        <RadioButton
                                            x:Name="ScanDetectionManualButton" x:FieldModifier="internal"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="negaflow.library.scan.detection.manual"
                                            Checked="OnScanDetectionModeChecked"
                                            GroupName="FlatbedDetectionMode" />
                                        <Button
                                            x:Name="ScanRefreshFramesButton" x:FieldModifier="internal"
                                            Grid.Column="3"
                                            Padding="7,4"
                                            AutomationProperties.AutomationId="negaflow.library.scan.refresh-frames"
                                            Click="OnScanRefreshFramesClicked"
                                            Content="&#xE72C;"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="12" />
                                    </Grid>
                                    <Grid x:Name="ScanRegionsRow" x:FieldModifier="internal" ColumnSpacing="6" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanRegionsLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <Button x:Name="ScanCopyFrameButton" x:FieldModifier="internal" Grid.Column="1" Padding="7,4" AutomationProperties.AutomationId="negaflow.library.scan.frame.copy" Click="OnScanCopyFrameClicked" Content="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" />
                                        <Button x:Name="ScanPasteFrameButton" x:FieldModifier="internal" Grid.Column="2" Padding="7,4" AutomationProperties.AutomationId="negaflow.library.scan.frame.paste" Click="OnScanPasteFrameClicked" Content="&#xE77F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" />
                                        <Button x:Name="ScanAddFrameButton" x:FieldModifier="internal" Grid.Column="3" Padding="7,4" AutomationProperties.AutomationId="negaflow.library.scan.frame.add" Click="OnScanAddFrameClicked" Content="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" />
                                        <Button x:Name="ScanRemoveFrameButton" x:FieldModifier="internal" Grid.Column="4" Padding="7,4" AutomationProperties.AutomationId="negaflow.library.scan.frame.remove" Click="OnScanRemoveFrameClicked" Content="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" />
                                    </Grid>
                                    <Grid x:Name="ScanFrameCountRow" x:FieldModifier="internal" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScanFrameCountLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                                        <NumberBox
                                            x:Name="ScanFrameCountBox" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            MinWidth="98"
                                            AutomationProperties.AutomationId="negaflow.library.scan.frame-count"
                                            Maximum="12"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnScanFrameCountChanged" />
                                    </Grid>
                                    <ToggleSwitch
                                        x:Name="ScanInfraredToggle" x:FieldModifier="internal"
                                        AutomationProperties.AutomationId="negaflow.library.scan.infrared"
                                        Toggled="OnScanInfraredToggled" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ScanPreviewButton" x:FieldModifier="internal"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.library.scan.preview"
                                            Click="OnScanPreviewClicked" />
                                        <Button
                                            x:Name="ScanStartButton" x:FieldModifier="internal"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.library.scan.start"
                                            Click="OnScanStartClicked"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock
                                    x:Name="ScanStatusText" x:FieldModifier="internal"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
    </StackPanel>
</UserControl>
