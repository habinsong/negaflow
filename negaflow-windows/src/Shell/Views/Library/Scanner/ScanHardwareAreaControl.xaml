<?xml version="1.0" encoding="utf-8"?>
<!--
    macOS `ScannerControlsSection.hardwareScanAreaControls` — 위치 지정이 안 되는 장치(필름 스캐너)의
    스캔 영역입니다. 머리 줄(이름 · 전체 · 펼침)과, 펼치면 너비 · 높이 줄(이름 44 · 슬라이더 · 값)이
    나옵니다. 값을 누르면 입력칸이 되고 Enter 로 적용, Esc 는 최대값으로 되돌립니다.
-->
<UserControl
    x:Class="Negaflow.Shell.Views.Library.Scanner.ScanHardwareAreaControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="HeaderButton"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                FontWeight="Normal"
                AutomationProperties.AutomationId="negaflow.library.scan.hardware-area"
                Click="OnToggleClicked"
                Style="{StaticResource NegaflowScannerPlainButtonStyle}">
                <TextBlock x:Name="HeaderText" FontSize="12" />
            </Button>
            <Button
                x:Name="FullButton"
                Grid.Column="1"
                Padding="7,2"
                FontSize="11"
                AutomationProperties.AutomationId="negaflow.library.scan.hardware-area.full"
                Click="OnFullClicked" />
            <Button
                x:Name="ChevronButton"
                Grid.Column="2"
                Padding="0"
                AutomationProperties.AutomationId="negaflow.library.scan.hardware-area.expand"
                Click="OnToggleClicked"
                Style="{StaticResource NegaflowScannerPlainButtonStyle}">
                <FontIcon x:Name="ChevronIcon" FontSize="10" Glyph="&#xE70D;" />
            </Button>
        </Grid>
        <StackPanel x:Name="DimensionRows" Spacing="8" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WidthLabel" VerticalAlignment="Center" FontSize="12" />
                <Slider
                    x:Name="WidthSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.1"
                    VerticalAlignment="Center"
                    IsThumbToolTipEnabled="False"
                    AutomationProperties.AutomationId="negaflow.library.scan.hardware-area.width"
                    ValueChanged="OnWidthChanged" />
                <Grid Grid.Column="2" MinWidth="62">
                    <Button
                        x:Name="WidthValueButton"
                        Padding="0"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="negaflow.library.scan.hardware-area.width.value"
                        Click="OnValueClicked"
                        Style="{StaticResource NegaflowScannerPlainButtonStyle}">
                        <TextBlock
                            x:Name="WidthValueText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <TextBox
                        x:Name="WidthValueBox"
                        Width="62"
                        MinWidth="0"
                        FontSize="11"
                        TextAlignment="Right"
                        Visibility="Collapsed"
                        KeyDown="OnValueKeyDown"
                        LostFocus="OnValueLostFocus" />
                </Grid>
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeightLabel" VerticalAlignment="Center" FontSize="12" />
                <Slider
                    x:Name="HeightSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    StepFrequency="0.1"
                    VerticalAlignment="Center"
                    IsThumbToolTipEnabled="False"
                    AutomationProperties.AutomationId="negaflow.library.scan.hardware-area.height"
                    ValueChanged="OnHeightChanged" />
                <Grid Grid.Column="2" MinWidth="62">
                    <Button
                        x:Name="HeightValueButton"
                        Padding="0"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="negaflow.library.scan.hardware-area.height.value"
                        Click="OnValueClicked"
                        Style="{StaticResource NegaflowScannerPlainButtonStyle}">
                        <TextBlock
                            x:Name="HeightValueText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <TextBox
                        x:Name="HeightValueBox"
                        Width="62"
                        MinWidth="0"
                        FontSize="11"
                        TextAlignment="Right"
                        Visibility="Collapsed"
                        KeyDown="OnValueKeyDown"
                        LostFocus="OnValueLostFocus" />
                </Grid>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
