<UserControl
    x:Class="Negaflow.Shell.Views.Library.Scanner.FlatbedScanAreaOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="True"
    mc:Ignorable="d">

    <!-- macOS FlatbedScanAreaOverlay - 프리뷰 그림 위에 프레임 사각형을 얹습니다.
         **배경을 칠하지 않습니다.** 칠하면 빈 자리의 눌림을 이 판이 먼저 집어, 그 아래
         캔버스가 사진을 잡고 끄는 동작이 죽습니다. 사각형과 손잡이는 자기 몸에서 직접
         집으므로 배경 없이도 잡힙니다. -->
    <Grid x:Name="Host" x:FieldModifier="internal" Background="{x:Null}" SizeChanged="OnHostSizeChanged">
        <Image
            x:Name="PreviewImage" x:FieldModifier="internal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="negaflow.library.scan.preview.image"
            Stretch="Uniform" />

        <!-- 프레임 사각형과 손잡이는 여기에 절대 좌표로 붙습니다. -->
        <Canvas x:Name="RegionLayer" x:FieldModifier="internal" IsHitTestVisible="True" />
    </Grid>
</UserControl>
