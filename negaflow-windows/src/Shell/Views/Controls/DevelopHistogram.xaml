<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Controls.DevelopHistogram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="118"
    IsTabStop="True"
    AutomationProperties.AutomationId="negaflow.develop.histogram"
    KeyDown="OnKeyDown">
    <Border
        x:Name="Surface"
        HorizontalAlignment="Stretch"
        Padding="8"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="ClippingText"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#FFFFA500"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="ActiveValueText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                    <TextBlock
                        x:Name="RgbText"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#FFE34A4A" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#FF42C85A" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#FF448AFF" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="PlotHost"
                Grid.Row="1"
                Margin="0,2"
                HorizontalAlignment="Stretch"
                PointerCaptureLost="OnPointerCaptureLost"
                PointerExited="OnPointerExited"
                PointerMoved="OnPointerMoved"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnPointerReleased">
                <Border Background="#38000000" CornerRadius="8" />
                <Grid IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26*" />
                        <ColumnDefinition Width="24*" />
                        <ColumnDefinition Width="24*" />
                        <ColumnDefinition Width="26*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="ActiveBand"
                        Grid.Column="2"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        Opacity="0.22"
                        Visibility="Collapsed" />
                    <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#1AFFFFFF" />
                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Background="#1AFFFFFF" />
                    <Border Grid.Column="2" Width="1" HorizontalAlignment="Right" Background="#1AFFFFFF" />
                </Grid>
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#0FFFFFFF" />
                    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="#0FFFFFFF" />
                    <Border Grid.Row="2" Height="1" VerticalAlignment="Bottom" Background="#0FFFFFFF" />
                </Grid>
                <Canvas
                    x:Name="HistogramCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    SizeChanged="OnHistogramCanvasSizeChanged">
                    <Polygon x:Name="LumaArea" Fill="#24FFFFFF" />
                    <Polyline x:Name="LumaLine" Stroke="#66FFFFFF" StrokeThickness="1.35" />
                    <Polyline x:Name="RedLine" Stroke="#E0FF3B30" StrokeThickness="1.35" />
                    <Polyline x:Name="GreenLine" Stroke="#D13DDC55" StrokeThickness="1.35" />
                    <Polyline x:Name="BlueLine" Stroke="#E03A7BFF" StrokeThickness="1.35" />
                </Canvas>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26*" />
                    <ColumnDefinition Width="24*" />
                    <ColumnDefinition Width="24*" />
                    <ColumnDefinition Width="26*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShadowText" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DensityText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ExposureText" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="HighlightText" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
