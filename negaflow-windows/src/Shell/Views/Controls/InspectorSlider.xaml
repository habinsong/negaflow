<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Controls.InspectorSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InspectorSliderValueEditorStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style
            x:Key="InspectorSliderValueEditorErrorStyle"
            BasedOn="{StaticResource InspectorSliderValueEditorStyle}"
            TargetType="TextBox">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="LabelText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12" />
            <Button
                x:Name="ValueButton"
                Grid.Column="1"
                IsTabStop="True"
                Padding="0"
                HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnValueButtonClicked">
                <TextBlock
                    x:Name="ValueText"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right" />
            </Button>
            <TextBox
                x:Name="ValueEditor"
                Grid.Column="1"
                IsTabStop="False"
                Padding="3,1"
                HorizontalContentAlignment="Right"
                VerticalContentAlignment="Center"
                FontFamily="Consolas"
                FontSize="11"
                Style="{StaticResource InspectorSliderValueEditorStyle}"
                TextAlignment="Right"
                Visibility="Collapsed"
                KeyDown="OnEditorKeyDown"
                LostFocus="OnEditorLostFocus"
                TextChanging="OnEditorTextChanging" />
        </Grid>
        <Slider
            x:Name="Slider"
            SmallChange="0.01"
            LargeChange="0.10"
            ThumbToolTipValueConverter="{x:Null}"
            DoubleTapped="OnSliderDoubleTapped"
            KeyDown="OnSliderKeyDown"
            ValueChanged="OnSliderValueChanged" />
    </StackPanel>
</UserControl>
