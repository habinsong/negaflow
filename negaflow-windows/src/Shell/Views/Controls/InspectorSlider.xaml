<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Controls.InspectorSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- macOS 에는 같은 슬라이더가 두 모양으로 나옵니다.
           ① 기본  — `VStack { HStack { 이름, Spacer, 값 }, ResettableSlider }`
                     이름 줄이 위, 슬라이더가 아래. 대부분의 인스펙터 항목이 이 모양입니다.
           ② 촘촘  — `HStack(spacing: 6) { Text(태그).frame(width: 12), 슬라이더, 값(width: 38) }`
                     한 줄짜리. 컬러 믹서 "모두" 의 H·S·L 이 이 모양입니다.
         두 모양이 값 편집·되돌리기·키보드 조작을 똑같이 쓰므로 요소는 하나만 두고
         `Compact` 에 따라 `Grid` 의 행·열만 옮깁니다. -->
    <Grid x:Name="Root" RowSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeadColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ValueColumn" Width="54" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            x:Name="LabelPanel"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="6">
            <!-- macOS `Circle().fill(색).frame(width: 12, height: 12)
                 .overlay(Circle().stroke(.white.opacity(0.3), lineWidth: 0.5))` -->
            <Border
                x:Name="SwatchDot"
                Width="12"
                Height="12"
                VerticalAlignment="Center"
                BorderThickness="0.5"
                CornerRadius="6"
                Visibility="Collapsed">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFFFFFFF" Opacity="0.3" />
                </Border.BorderBrush>
            </Border>
            <TextBlock
                x:Name="LabelText"
                VerticalAlignment="Center"
                FontSize="12" />
        </StackPanel>
        <Button
            x:Name="ValueButton"
            Grid.Row="0"
            Grid.Column="2"
            IsTabStop="False"
            Padding="0"
            HorizontalContentAlignment="Right"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="OnValueButtonClicked">
            <TextBlock
                x:Name="ValueText"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Right" />
        </Button>
        <!-- 보일 때는 탭으로도 닿아야 합니다. 접혀 있으면 어차피 탭 순서에서 빠지므로
             `IsTabStop="False"` 는 얻는 것 없이 포커스만 막습니다. -->
        <TextBox
            x:Name="ValueEditor"
            Grid.Row="0"
            Grid.Column="2"
            Padding="3,1"
            HorizontalContentAlignment="Right"
            VerticalContentAlignment="Center"
            FontFamily="Consolas"
            FontSize="11"
            TextAlignment="Right"
            Visibility="Collapsed"
            KeyDown="OnEditorKeyDown"
            LostFocus="OnEditorLostFocus"
            TextChanging="OnEditorTextChanging" />
        <Grid
            x:Name="SliderHost"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="-8"
            Padding="8"
            Background="Transparent"
            DoubleTapped="OnSliderDoubleTapped">
            <!-- WinUI `StepFrequency` 의 기본값은 1 이고 `SnapsTo` 의 기본값은 StepValues 라,
                 적지 않으면 끌 때 정수로 스냅됩니다. macOS 는 `Slider(value:in:)` 를 step 없이
                 쓰므로 연속입니다 — 화면에 두 자리로 적으므로 0.01 이 그 눈금입니다.

                 `StepFrequency` 는 **끌 때만** 걸립니다. 트랙을 누르면 WinUI 는 눈금을 무시하고
                 포인터 자리를 그대로 넣어 `0.37546181678772` 같은 값이 저장되는데, 화면·편집기·
                 화살표는 모두 두 자리라 같은 칸이 길에 따라 다른 값이 됩니다. 그래서 눈금은
                 `SetControlValue` 한 곳에서 다시 겁니다.

                 값 툴팁의 자릿수는 `ThumbToolTipValueConverter` 가 정하는데, 여기 XAML 로
                 걸면 걸리지 않습니다 — 실측으로 툴팁이 그대로 `0.3600` 이었습니다. 그래서
                 코드비하인드 생성자에서 붙입니다. -->
            <Slider
                x:Name="Slider"
                StepFrequency="0.01"
                SmallChange="0.01"
                LargeChange="0.10"
                KeyDown="OnSliderKeyDown"
                ValueChanged="OnSliderValueChanged" />
        </Grid>
    </Grid>
</UserControl>
