<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Controls.ToneCurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6">
        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RgbChannelButton" Grid.Column="0" Click="OnRgbChannelClicked" />
            <Button x:Name="RedChannelButton" Grid.Column="1" Click="OnRedChannelClicked" />
            <Button x:Name="GreenChannelButton" Grid.Column="2" Click="OnGreenChannelClicked" />
            <Button x:Name="BlueChannelButton" Grid.Column="3" Click="OnBlueChannelClicked" />
        </Grid>
        <Border Height="188" BorderBrush="{ThemeResource NegaflowDividerBrush}" BorderThickness="1" CornerRadius="6">
            <Canvas
                x:Name="CurveCanvas"
                Background="Transparent"
                IsTabStop="True"
                PointerMoved="OnCanvasPointerMoved"
                PointerPressed="OnCanvasPointerPressed"
                PointerReleased="OnCanvasPointerReleased"
                DoubleTapped="OnCanvasDoubleTapped"
                KeyDown="OnCanvasKeyDown"
                SizeChanged="OnCanvasSizeChanged" />
        </Border>
        <Grid x:Name="PointFields" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock x:Name="CurveInputLabel" FontSize="11" />
                <TextBox x:Name="InputEditor" AutomationProperties.Name="Point Curve input percentage" KeyDown="OnPointEditorKeyDown" LostFocus="OnPointEditorLostFocus" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="CurveOutputLabel" FontSize="11" />
                <TextBox x:Name="OutputEditor" AutomationProperties.Name="Point Curve output percentage" KeyDown="OnPointEditorKeyDown" LostFocus="OnPointEditorLostFocus" />
            </StackPanel>
        </Grid>
        <!-- macOS `ToneCurveEditor` 의 마지막 줄: 왼쪽에 조작 안내, 오른쪽에 초기화 하나뿐입니다.
             점 추가·삭제는 **캔버스에서** 합니다(클릭·더블클릭) — 단추를 따로 두면 macOS 에
             없는 것을 지어내는 것이고, 안내문이 없으면 조작법을 알 길이 없습니다. -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="CurveHelpText"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="ResetChannelButton"
                Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                Click="OnResetChannelClicked"
                FontSize="11" />
        </Grid>
    </StackPanel>
</UserControl>
