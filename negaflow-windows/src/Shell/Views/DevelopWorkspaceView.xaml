                                                        <DataTemplate>
                                                            <TextBlock
                                                                Width="76"
                                                                Padding="0,4"
                                                                HorizontalTextAlignment="Center"
                                                                FontSize="12"
                                                                Text="{Binding Text}" />
                                                        </DataTemplate>
                                                    </GridView.ItemTemplate>
                                                </GridView>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
