<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.DevelopWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:Negaflow.Shell.Views">
    <Grid x:Name="Root" Background="{ThemeResource NegaflowWindowBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPanel" Grid.Column="0" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftRailColumn" Width="76" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="22,10,22,0" Spacing="7">
                <Button
                    x:Name="LibraryRailButton"
                    AutomationProperties.AutomationId="negaflow.develop.sources.library"
                    Background="{ThemeResource NegaflowSelectionBrush}"
                    Click="OnDevelopSourceRailClicked"
                    Style="{StaticResource NegaflowSidebarButtonStyle}"
                    Tag="Library">
                    <FontIcon x:Name="LibraryRailIcon" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8FD;" />
                </Button>
                <Button x:Name="FilesRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                </Button>
                <Button x:Name="VersionsRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE823;" />
                </Button>
                <Button x:Name="PresetsRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE9E9;" />
                </Button>
                <Button
                    x:Name="FilmRailButton"
                    AutomationProperties.AutomationId="negaflow.develop.sources.film"
                    Click="OnDevelopSourceRailClicked"
                    Style="{StaticResource NegaflowSidebarButtonStyle}"
                    Tag="Film">
                    <FontIcon x:Name="FilmRailIcon" FontSize="15" Glyph="&#xE722;" />
                </Button>
                <Button
                    x:Name="OutputRailButton"
                    AutomationProperties.AutomationId="negaflow.develop.sources.output"
                    Click="OnDevelopSourceRailClicked"
                    Style="{StaticResource NegaflowSidebarButtonStyle}"
                    Tag="Output">
                    <FontIcon x:Name="OutputRailIcon" FontSize="15" Glyph="&#xE72D;" />
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DevelopSourceIcon" Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE8FD;" />
                    <TextBlock x:Name="LibraryHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="NoFrameHeaderText" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

                <!-- 출력 소스: macOS 의 내보내기 설정 패널입니다. 형식·폴더·파일명 패턴을
                     정하고 미리보기로 실제 파일명을 확인한 뒤 내보냅니다. -->
                <ScrollViewer x:Name="OutputSourcePanel" Grid.Row="2" Visibility="Collapsed">
                    <StackPanel Padding="12,14" Spacing="12">
                        <TextBlock x:Name="ExportSectionText" FontSize="13" FontWeight="SemiBold" />
                        <Border Padding="12" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="8">
                            <StackPanel Spacing="9">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ExportFormatLabel" VerticalAlignment="Center" FontSize="12" />
                                    <ComboBox
                                        x:Name="ExportFormatSelector"
                                        Grid.Column="1"
                                        MinWidth="96"
                                        AutomationProperties.AutomationId="negaflow.develop.output.format"
                                        SelectionChanged="OnExportFormatChanged">
                                        <ComboBoxItem Content="TIFF" Tag="Tiff16" />
                                        <ComboBoxItem Content="PNG" Tag="Png16" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ExportFolderLabel" VerticalAlignment="Center" FontSize="12" />
                                    <Button
                                        x:Name="ExportFolderButton"
                                        Grid.Column="1"
                                        Padding="8,2"
                                        AutomationProperties.AutomationId="negaflow.develop.output.folder"
                                        Click="OnExportFolderClicked"
                                        FontSize="11" />
                                </Grid>
                                <TextBlock
                                    x:Name="ExportFolderPathText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ExportNamePatternLabel" FontSize="12" />
                                <TextBox
                                    x:Name="ExportNamePatternBox"
                                    AutomationProperties.AutomationId="negaflow.develop.output.name-pattern"
                                    TextChanged="OnExportNamePatternChanged" />
                                <TextBlock
                                    x:Name="ExportPreviewText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    x:Name="ExportButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.develop.output.export"
                                    Click="OnExportClicked"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock
                                    x:Name="OutputStatusText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 필름 소스: macOS 처럼 digital source 에서만 고를 수 있고, 스캔 프레임에는
                     안내만 냅니다. 묶음과 순서는 FilmEmulationCatalog 가 정합니다. -->
                <ScrollViewer x:Name="FilmSourcePanel" Grid.Row="2" Visibility="Collapsed">
                    <StackPanel Padding="12,14" Spacing="12">
                        <TextBlock
                            x:Name="FilmLookUnavailableText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="FilmLookControls" Spacing="12" Visibility="Collapsed">
                            <controls:InspectorSlider
                                x:Name="FilmLookIntensityControl"
                                HorizontalAlignment="Stretch"
                                Maximum="1"
                                Minimum="0"
                                ResetValue="0.5"
                                SliderAutomationId="negaflow.develop.film.intensity"
                                ValueChanged="OnFilmLookIntensityChanged" />
                            <ItemsControl x:Name="FilmLookGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="10"
                                            Background="{ThemeResource NegaflowCardBrush}"
                                            CornerRadius="10">
                                            <StackPanel Spacing="7">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}" />
                                                <ItemsControl ItemsSource="{Binding Films}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <RadioButton
                                                                GroupName="FilmLookSelection"
                                                                Checked="OnFilmLookChecked"
                                                                Content="{Binding Name}"
                                                                FontSize="12"
                                                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                Tag="{Binding Emulation}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LibrarySourcePanel" Grid.Row="2">
                    <StackPanel Padding="12,14" Spacing="10">
                        <Button
                            x:Name="ImportButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="negaflow.develop.import"
                            Click="OnImportClicked"
                            />
                        <TextBlock
                            x:Name="ImportStatusText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="NoFrameLeftPanel" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE91B;" />
                            <TextBlock x:Name="NoFrameLeftText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="FramePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock
                                x:Name="SelectedFrameText"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <ComboBox
                                x:Name="FrameSelector"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="negaflow.develop.frame"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="OnFrameSelectionChanged" />
                            <TextBlock
                                x:Name="ExportStatusText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border x:Name="LeftDivider" Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="LeftResizeThumb"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            DragCompleted="OnLeftResizeCompleted"
            DragDelta="OnLeftResizeDelta"
            DragStarted="OnLeftResizeStarted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="CanvasHost"
                Grid.Row="0"
                AutomationProperties.AutomationId="negaflow.canvas"
                Background="{ThemeResource NegaflowCanvasBrush}"
                IsTabStop="True"
                KeyDown="OnCanvasKeyDown"
                PointerCanceled="OnCanvasPointerCancelled"
                PointerCaptureLost="OnCanvasPointerCaptureLost"
                PointerMoved="OnCanvasPointerMoved"
                PointerPressed="OnCanvasPointerPressed"
                PointerReleased="OnCanvasPointerReleased"
                SizeChanged="OnCanvasSizeChanged">
                <StackPanel x:Name="EmptyCanvasPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="42" Foreground="#FF8A8A8A" Glyph="&#xE91B;" />
                    <TextBlock x:Uid="emptyCanvasTitle" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#FFE2E2E2" />
                    <TextBlock
                        x:Uid="emptyCanvasDescription"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="#FFA8A8A8"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Image
                    x:Name="PreviewImage"
                    Margin="24"
                    AutomationProperties.AutomationId="negaflow.canvas.preview"
                    Stretch="Uniform"
                    Visibility="Collapsed" />

                <Canvas x:Name="CropOverlay" Visibility="Collapsed">
                    <Rectangle x:Name="CropDimTop" Fill="#73000000" />
                    <Rectangle x:Name="CropDimBottom" Fill="#73000000" />
                    <Rectangle x:Name="CropDimLeft" Fill="#73000000" />
                    <Rectangle x:Name="CropDimRight" Fill="#73000000" />
                    <Rectangle
                        x:Name="CropSelection"
                        AutomationProperties.AutomationId="negaflow.canvas.crop.selection"
                        Fill="Transparent"
                        RadiusX="2"
                        RadiusY="2"
                        Stroke="White"
                        StrokeThickness="1.5" />
                    <Line x:Name="CropThirdVerticalFirst" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Line x:Name="CropThirdVerticalSecond" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Line x:Name="CropThirdHorizontalFirst" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Line x:Name="CropThirdHorizontalSecond" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Rectangle x:Name="CropHandleTopLeft" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleTop" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleTopRight" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleRight" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleBottomRight" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleBottom" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleBottomLeft" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleLeft" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Border
                        x:Name="CropActionBar"
                        Background="{ThemeResource NegaflowPanelBrush}"
                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CropApplyButton" Click="OnCropApplyClicked" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="CropFullButton" Click="OnCropFullClicked" />
                            <Button x:Name="CropCancelButton" Click="OnCropCancelClicked" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>

            <views:FilmstripView x:Name="Filmstrip" Grid.Row="1" />
            <views:StatusBarView x:Name="StatusBar" Grid.Row="2" />
        </Grid>

        <Border x:Name="RightDivider" Grid.Column="3" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="RightResizeThumb"
            Grid.Column="3"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            DragCompleted="OnRightResizeCompleted"
            DragDelta="OnRightResizeDelta"
            DragStarted="OnRightResizeStarted" />

        <Grid x:Name="RightPanel" Grid.Column="4" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,0" Background="{ThemeResource NegaflowBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE9E9;" />
                <TextBlock x:Name="DevelopHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ISO — · — s · f/— · — mm" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Padding="8,14,20,14" Spacing="12">
                    <Border
                        x:Name="NoFrameCard"
                        MinHeight="180"
                        Padding="18"
                        Background="{ThemeResource NegaflowCardBrush}"
                        CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9E9;" />
                            <TextBlock x:Name="NoFrameInspectorText" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        x:Name="DevelopInspectorContent"
                        HorizontalAlignment="Stretch"
                        Spacing="12"
                        Visibility="Collapsed">
                        <controls:DevelopHistogram
                            x:Name="HistogramView"
                            HorizontalAlignment="Stretch"
                            ValueChanged="OnHistogramValueChanged" />

                        <Border
                            Padding="3"
                            AutomationProperties.AutomationId="negaflow.develop.tabs"
                            Background="{ThemeResource NegaflowSubtleFillBrush}"
                            CornerRadius="18">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="BasicTabButton"
                                    Grid.Column="0"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.basic"
                                    AutomationProperties.PositionInSet="1"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    IsChecked="True"
                                    Tag="Basic">
                                    <FontIcon FontSize="14" Glyph="&#xE9E9;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="BaseTabButton"
                                    Grid.Column="1"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.base"
                                    AutomationProperties.PositionInSet="2"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Base">
                                    <FontIcon FontSize="14" Glyph="&#xE706;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="EditTabButton"
                                    Grid.Column="2"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.edit"
                                    AutomationProperties.PositionInSet="3"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Edit">
                                    <FontIcon FontSize="14" Glyph="&#xE7A8;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="DefectsTabButton"
                                    Grid.Column="3"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.defects"
                                    AutomationProperties.PositionInSet="4"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Defects">
                                    <FontIcon FontSize="14" Glyph="&#xE771;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="InfoTabButton"
                                    Grid.Column="4"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.info"
                                    AutomationProperties.PositionInSet="5"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Info">
                                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="ResetTabButton"
                                    Grid.Column="5"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.reset"
                                    AutomationProperties.PositionInSet="6"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Reset">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                </ToggleButton>
                                <Border Grid.Column="0" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="BaseControlCard"
                            HorizontalAlignment="Stretch"
                            Padding="14"
                            Background="{ThemeResource NegaflowCardBrush}"
                            CornerRadius="14"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE706;" />
                                    <TextBlock x:Name="BaseSectionTitleText" Grid.Column="1" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="ManualBaseValueText"
                                        Grid.Column="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid
                                    x:Name="BaseModeControl"
                                    AutomationProperties.AutomationId="negaflow.develop.base"
                                    AutomationProperties.Name="Film base mode"
                                    ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        x:Name="BaseAutoModeButton"
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="negaflow.develop.base.mode.auto"
                                        GroupName="BaseEstimationMode"
                                        Checked="OnBaseAutoModeChecked" />
                                    <RadioButton
                                        x:Name="BaseFilmModeButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="negaflow.develop.base.mode.film"
                                        GroupName="BaseEstimationMode"
                                        Checked="OnBaseFilmModeChecked" />
                                    <RadioButton
                                        x:Name="BaseManualModeButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="negaflow.develop.base.mode.manual"
                                        GroupName="BaseEstimationMode"
                                        Checked="OnBaseManualModeChecked" />
                                </Grid>
                                <StackPanel x:Name="FilmBaseControls" Spacing="8">
                                    <TextBlock x:Name="FilmStockLabel" FontSize="12" />
                                    <ComboBox
                                        x:Name="FilmStockSelector"
                                        AutomationProperties.AutomationId="negaflow.develop.base.film-stock"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="OnFilmStockSelectionChanged" />
                                    <TextBlock x:Name="LightSourceLabel" FontSize="12" />
                                    <ComboBox
                                        x:Name="LightSourceSelector"
                                        AutomationProperties.AutomationId="negaflow.develop.base.light-source"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="OnLightSourceSelectionChanged" />
                                </StackPanel>
                                <!-- Minimum/Maximum 은 엔진이 알려 준 값으로 코드에서 설정한다. -->
                                <StackPanel x:Name="ManualBaseControls" Spacing="10">
                                    <controls:InspectorSlider
                                        x:Name="BaseRedControl"
                                        CanReset="False"
                                        SliderAutomationId="negaflow.develop.base.red"
                                        ValueChanged="OnManualBaseChanged" />
                                    <controls:InspectorSlider
                                        x:Name="BaseGreenControl"
                                        CanReset="False"
                                        SliderAutomationId="negaflow.develop.base.green"
                                        ValueChanged="OnManualBaseChanged" />
                                    <controls:InspectorSlider
                                        x:Name="BaseBlueControl"
                                        CanReset="False"
                                        SliderAutomationId="negaflow.develop.base.blue"
                                        ValueChanged="OnManualBaseChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="GeometryControlCard"
                            HorizontalAlignment="Stretch"
                            Padding="14"
                            AutomationProperties.AutomationId="negaflow.develop.geometry"
                            Background="{ThemeResource NegaflowCardBrush}"
                            CornerRadius="14"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE7A8;" />
                                    <TextBlock x:Name="GeometrySectionTitleText" Grid.Column="1" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" />
                                </Grid>
