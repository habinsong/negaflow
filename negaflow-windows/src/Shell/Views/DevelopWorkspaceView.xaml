                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE790;" />
                                                <TextBlock x:Name="ColorMixerSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="ColorMixerChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="ColorMixerResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnColorMixerResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <controls:ColorMixerEditor
                                        x:Name="ColorMixerEditor"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="negaflow.develop.color-mixer"
                                        AutomationProperties.Name="Color Mixer"
                                        MixerChanged="OnColorMixerChanged"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ColorGradingSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.color-grading"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="ColorGradingHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.color-grading.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="ColorGrading">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE2B1;" />
                                                <TextBlock x:Name="ColorGradingSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="ColorGradingChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="ColorGradingResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnColorGradingResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <controls:ColorGradingEditor
                                        x:Name="ColorGradingEditor"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="negaflow.develop.color-grading"
                                        AutomationProperties.Name="Color Grading"
                                        GradingChanged="OnColorGradingChanged"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!-- 흑백 토닝: macOS 는 흑백 필름에서만 이 섹션을 냅니다. 컬러에서는
                                 자리째 사라집니다. 색조 두 값은 각도라 0...360 입니다. -->
                            <Border
                                x:Name="BwToningSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.bw-toning"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="BwToningHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.bw-toning.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="BlackAndWhiteToning">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE793;" />
                                                <TextBlock x:Name="BwToningSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="BwToningChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="BwToningResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnBwToningResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <StackPanel
                                        x:Name="BwToningControls"
                                        HorizontalAlignment="Stretch"
                                        Spacing="10"
                                        TabFocusNavigation="Cycle">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BwToningModeLabel" VerticalAlignment="Center" FontSize="12" />
                                            <ComboBox
                                                x:Name="BwToningModeSelector"
                                                Grid.Column="1"
                                                MinWidth="128"
                                                AutomationProperties.AutomationId="negaflow.develop.bw-toning.mode"
                                                SelectionChanged="OnBwToningModeChanged">
                                                <ComboBoxItem x:Name="BwToningOffItem" Tag="None" />
                                                <ComboBoxItem x:Name="BwToningSeleniumItem" Tag="Selenium" />
                                                <ComboBoxItem x:Name="BwToningSepiaItem" Tag="Sepia" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel x:Name="BwToningTintControls" Spacing="10">
                                            <controls:InspectorSlider x:Name="BwToningStrengthControl" HorizontalAlignment="Stretch" Maximum="1" Minimum="0" ResetValue="0" SliderAutomationId="negaflow.develop.bw-toning.strength" ValueChanged="OnBwToningValueChanged" />
                                            <controls:InspectorSlider x:Name="BwToningShadowHueControl" HorizontalAlignment="Stretch" Maximum="360" Minimum="0" ResetValue="0" SliderAutomationId="negaflow.develop.bw-toning.shadow-hue" ValueChanged="OnBwToningValueChanged" />
                                            <controls:InspectorSlider x:Name="BwToningHighlightHueControl" HorizontalAlignment="Stretch" Maximum="360" Minimum="0" ResetValue="0" SliderAutomationId="negaflow.develop.bw-toning.highlight-hue" ValueChanged="OnBwToningValueChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="CalibrationSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.calibration"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="CalibrationHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.calibration.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="Calibration">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE7F8;" />
                                                <TextBlock x:Name="CalibrationSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="CalibrationChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="CalibrationResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnCalibrationResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="CalibrationControls" HorizontalAlignment="Stretch" Spacing="10" Visibility="Collapsed">
                                        <TextBlock x:Name="RedPrimaryText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <controls:InspectorSlider x:Name="RedPrimaryHueControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.calibration.red.hue" ValueChanged="OnPrimaryCalibrationChanged" />
                                        <controls:InspectorSlider x:Name="RedPrimarySaturationControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.calibration.red.saturation" ValueChanged="OnPrimaryCalibrationChanged" />
                                        <Border Height="1" HorizontalAlignment="Stretch" Background="{ThemeResource NegaflowDividerBrush}" />
                                        <TextBlock x:Name="GreenPrimaryText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <controls:InspectorSlider x:Name="GreenPrimaryHueControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.calibration.green.hue" ValueChanged="OnPrimaryCalibrationChanged" />
                                        <controls:InspectorSlider x:Name="GreenPrimarySaturationControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.calibration.green.saturation" ValueChanged="OnPrimaryCalibrationChanged" />
                                        <Border Height="1" HorizontalAlignment="Stretch" Background="{ThemeResource NegaflowDividerBrush}" />
                                        <TextBlock x:Name="BluePrimaryText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <controls:InspectorSlider x:Name="BluePrimaryHueControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.calibration.blue.hue" ValueChanged="OnPrimaryCalibrationChanged" />
                                        <controls:InspectorSlider x:Name="BluePrimarySaturationControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.calibration.blue.saturation" ValueChanged="OnPrimaryCalibrationChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="DetailAndEffectsSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.detail-effects"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="DetailAndEffectsHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.detail-effects.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="DetailAndEffects">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE7C4;" />
                                                <TextBlock x:Name="DetailAndEffectsSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="DetailAndEffectsChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="DetailAndEffectsResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnDetailAndEffectsResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="DetailAndEffectsControls" HorizontalAlignment="Stretch" Spacing="10" Visibility="Collapsed">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NoiseReductionLabelText" Grid.Column="0" VerticalAlignment="Center" FontSize="13" />
                                            <ToggleSwitch x:Name="NoiseReductionToggle" Grid.Column="1" MinWidth="44" Toggled="OnNoiseReductionToggled" />
                                        </Grid>
                                        <StackPanel x:Name="NoiseReductionControls" HorizontalAlignment="Stretch" Spacing="10">
                                            <controls:InspectorSlider x:Name="NoiseReductionStrengthControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.noise-reduction.strength" ValueChanged="OnNoiseReductionChanged" />
                                            <controls:InspectorSlider x:Name="NoiseReductionLumaControl" HorizontalAlignment="Stretch" ResetValue="0.5" SliderAutomationId="negaflow.develop.noise-reduction.luminance" ValueChanged="OnNoiseReductionChanged" />
                                            <controls:InspectorSlider x:Name="NoiseReductionChromaControl" HorizontalAlignment="Stretch" ResetValue="0.5" SliderAutomationId="negaflow.develop.noise-reduction.color" ValueChanged="OnNoiseReductionChanged" />
                                            <controls:InspectorSlider x:Name="NoiseReductionDarkToneControl" HorizontalAlignment="Stretch" ResetValue="0.5" SliderAutomationId="negaflow.develop.noise-reduction.dark-tones" ValueChanged="OnNoiseReductionChanged" />
                                            <controls:InspectorSlider x:Name="NoiseReductionDetailControl" HorizontalAlignment="Stretch" ResetValue="0.5" SliderAutomationId="negaflow.develop.noise-reduction.detail" ValueChanged="OnNoiseReductionChanged" />
                                            <controls:InspectorSlider x:Name="NoiseReductionGrainProtectControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.noise-reduction.grain-protect" ValueChanged="OnNoiseReductionChanged" />
                                        </StackPanel>
                                        <controls:InspectorSlider x:Name="GrainControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.texture.grain" ValueChanged="OnTextureChanged" />
                                        <controls:InspectorSlider x:Name="SharpnessControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.texture.sharpness" ValueChanged="OnTextureChanged" />
                                        <controls:InspectorSlider x:Name="ClarityControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.texture.clarity" ValueChanged="OnTextureChanged" />
                                        <controls:InspectorSlider x:Name="HalationControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.texture.halation" ValueChanged="OnTextureChanged" />
                                        <controls:InspectorSlider x:Name="VignetteControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.texture.vignette" ValueChanged="OnTextureChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
