<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.DevelopWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:Negaflow.Shell.Views"
    xmlns:sources="using:Negaflow.Shell.Views.Develop.Sources"
    xmlns:info="using:Negaflow.Shell.Views.Develop.Info"
    xmlns:inspector="using:Negaflow.Shell.Views.Develop.Inspector"
    xmlns:canvas="using:Negaflow.Shell.Views.Develop.Canvas"
    xmlns:grainmend="using:Negaflow.Shell.Views.Develop.GrainMend"
    xmlns:scanner="using:Negaflow.Shell.Views.Scanner">
    <UserControl.Resources>
        <!-- macOS DevelopInspectorTabLabel: outer radius 18, selected/hover radius 15,
             icon row minimum height 32. WinUI 기본 ToggleButton chrome은 이 형상을 바꾸므로
             이 표면에서만 쓰는 plain template으로 고정합니다. -->
        <Style x:Key="NegaflowDevelopInspectorTabStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowSubtleFillBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                            <Setter Target="Surface.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                            <Setter Target="Surface.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" x:FieldModifier="internal" Background="{ThemeResource NegaflowWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <sources:DevelopSourceSidebar
            x:Name="LeftPanel" x:FieldModifier="internal"
            Grid.Column="0" />

        <!-- 선택/단축키 호환을 위한 비표시 상태 컨트롤입니다. macOS 화면에는
             단일 프레임 ComboBox가 없으므로 렌더링하지 않습니다. -->
        <Grid Visibility="Collapsed">
            <StackPanel x:Name="NoFrameLeftPanel" x:FieldModifier="internal">
                <TextBlock x:Name="NoFrameLeftText" x:FieldModifier="internal" />
            </StackPanel>
            <StackPanel x:Name="FramePanel" x:FieldModifier="internal">
                <TextBlock x:Name="SelectedFrameText" x:FieldModifier="internal" />
                <ComboBox x:Name="FrameSelector" x:FieldModifier="internal" DisplayMemberPath="DisplayName" />
                <TextBlock x:Name="ExportStatusText" x:FieldModifier="internal" />
            </StackPanel>
        </Grid>

        <Border x:Name="LeftDivider" x:FieldModifier="internal" Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="LeftResizeThumb" x:FieldModifier="internal"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <canvas:DevelopPreviewCanvas
                x:Name="PreviewCanvas" x:FieldModifier="internal"
                Grid.Row="0" />

            <!--  macOS `ContentView+CenterStatus.swift`:
                    .overlay(alignment: .bottom) {
                        if model.isScanning {
                            ScanProgressOverlay()
                                .allowsHitTesting(false)
                                .padding(.bottom, 18)
                        }
                    }
                  캔버스 위 **하단 가운데**, 아래 여백 18. 손으로 집히지 않습니다.  -->
            <scanner:ScanProgressOverlay
                x:Name="ScanProgress" x:FieldModifier="internal"
                Grid.Row="0"
                Margin="0,0,0,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Visibility="Collapsed" />

            <views:FilmstripView x:Name="Filmstrip" x:FieldModifier="internal" Grid.Row="1" />
            <views:StatusBarView x:Name="StatusBar" x:FieldModifier="internal" Grid.Row="2" />
        </Grid>

        <Border x:Name="RightDivider" x:FieldModifier="internal" Grid.Column="3" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="RightResizeThumb" x:FieldModifier="internal"
            Grid.Column="3"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            />

        <Grid x:Name="RightPanel" x:FieldModifier="internal" Grid.Column="4" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,0" Background="{ThemeResource NegaflowBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE9E9;" />
                <TextBlock x:Name="DevelopHeaderText" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ISO — · — s · f/— · — mm" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Padding="8,14,20,14" Spacing="12">
                    <Border
                        x:Name="NoFrameCard" x:FieldModifier="internal"
                        MinHeight="180"
                        Padding="18"
                        Background="{ThemeResource NegaflowCardBrush}"
                        CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9E9;" />
                            <TextBlock x:Name="NoFrameInspectorText" x:FieldModifier="internal" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        x:Name="DevelopInspectorContent" x:FieldModifier="internal"
                        HorizontalAlignment="Stretch"
                        Spacing="12"
                        Visibility="Collapsed">
                        <controls:DevelopHistogram
                            x:Name="HistogramView" x:FieldModifier="internal"
                            HorizontalAlignment="Stretch"
                            />

                        <Border
                            HorizontalAlignment="Stretch"
                            Padding="3"
                            AutomationProperties.AutomationId="negaflow.develop.tabs"
                            Background="{ThemeResource NegaflowSubtleFillBrush}"
                            CornerRadius="18">
                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="BasicTabButton" x:FieldModifier="internal"
                                    Grid.Column="0"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.basic"
                                    AutomationProperties.PositionInSet="1"
                                    AutomationProperties.SizeOfSet="6"
                                    IsChecked="True"
                                    Tag="Basic">
                                    <FontIcon FontSize="14" Glyph="&#xE9E9;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="BaseTabButton" x:FieldModifier="internal"
                                    Grid.Column="1"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.base"
                                    AutomationProperties.PositionInSet="2"
                                    AutomationProperties.SizeOfSet="6"

                                    Tag="Base">
                                    <FontIcon FontSize="14" Glyph="&#xE706;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="EditTabButton" x:FieldModifier="internal"
                                    Grid.Column="2"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.edit"
                                    AutomationProperties.PositionInSet="3"
                                    AutomationProperties.SizeOfSet="6"

                                    Tag="Edit">
                                    <FontIcon FontSize="14" Glyph="&#xE7A8;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="DefectsTabButton" x:FieldModifier="internal"
                                    Grid.Column="3"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.defects"
                                    AutomationProperties.PositionInSet="4"
                                    AutomationProperties.SizeOfSet="6"

                                    Tag="Defects">
                                    <FontIcon FontSize="14" Glyph="&#xE771;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="InfoTabButton" x:FieldModifier="internal"
                                    Grid.Column="4"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.info"
                                    AutomationProperties.PositionInSet="5"
                                    AutomationProperties.SizeOfSet="6"

                                    Tag="Info">
                                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="ResetTabButton" x:FieldModifier="internal"
                                    Grid.Column="5"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.reset"
                                    AutomationProperties.PositionInSet="6"
                                    AutomationProperties.SizeOfSet="6"

                                    Tag="Reset">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                </ToggleButton>
                                <Border Grid.Column="0" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <grainmend:DevelopGrainMendPanel
                            x:Name="GrainMendPanel" x:FieldModifier="internal"
                            Visibility="Collapsed" />

                        <info:DevelopInfoCards x:Name="InfoCards" x:FieldModifier="internal" Visibility="Collapsed" />

                        <inspector:DevelopBaseCard x:Name="BaseCard" x:FieldModifier="internal" Visibility="Collapsed" />
                        <inspector:DevelopGeometryCard x:Name="GeometryCard" x:FieldModifier="internal" Visibility="Collapsed" />
                        <!-- macOS `editToolContent` 는 편집 탭에 GeometryToolSection 다음으로
                             LocalAdjustmentSection 을 냅니다. -->
                        <inspector:DevelopLocalAdjustmentSection x:Name="LocalAdjustmentCard" x:FieldModifier="internal" Visibility="Collapsed" />
                        <inspector:DevelopResetCard x:Name="ResetCard" x:FieldModifier="internal" Visibility="Collapsed" />

                        <inspector:DevelopAdjustmentStack x:Name="Adjustments" x:FieldModifier="internal" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
