<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.DevelopWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:Negaflow.Shell.Views">
    <Grid x:Name="Root" Background="{ThemeResource NegaflowWindowBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPanel" Grid.Column="0" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftRailColumn" Width="76" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="22,10,22,0" Spacing="7">
                <Button x:Name="LibraryRailButton" Background="{ThemeResource NegaflowSelectionBrush}" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8FD;" />
                </Button>
                <Button x:Name="FilesRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                </Button>
                <Button x:Name="VersionsRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE823;" />
                </Button>
                <Button x:Name="PresetsRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE9E9;" />
                </Button>
                <Button x:Name="FilmRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE722;" />
                </Button>
                <Button x:Name="OutputRailButton" Style="{StaticResource NegaflowSidebarButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE72D;" />
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE8FD;" />
                    <TextBlock x:Name="LibraryHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="NoFrameHeaderText" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />
                <ScrollViewer Grid.Row="2">
                    <StackPanel Padding="12,14" Spacing="10">
                        <Button
                            x:Name="ImportButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="negaflow.develop.import"
                            Click="OnImportClicked"
                            Content="Import images…" />
                        <TextBlock
                            x:Name="ImportStatusText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="NoFrameLeftPanel" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE91B;" />
                            <TextBlock x:Name="NoFrameLeftText" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="FramePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock
                                x:Name="SelectedFrameText"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <ComboBox
                                x:Name="FrameSelector"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="negaflow.develop.frame"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="OnFrameSelectionChanged" />
                            <TextBlock
                                x:Name="ExportStatusText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border x:Name="LeftDivider" Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="LeftResizeThumb"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            DragCompleted="OnLeftResizeCompleted"
            DragDelta="OnLeftResizeDelta"
            DragStarted="OnLeftResizeStarted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                AutomationProperties.AutomationId="negaflow.canvas"
                Background="{ThemeResource NegaflowCanvasBrush}">
                <StackPanel x:Name="EmptyCanvasPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="42" Foreground="#FF8A8A8A" Glyph="&#xE91B;" />
                    <TextBlock x:Uid="emptyCanvasTitle" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#FFE2E2E2" />
                    <TextBlock
                        x:Uid="emptyCanvasDescription"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="#FFA8A8A8"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Image
                    x:Name="PreviewImage"
                    Margin="24"
                    AutomationProperties.AutomationId="negaflow.canvas.preview"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>

            <views:FilmstripView x:Name="Filmstrip" Grid.Row="1" />
            <views:StatusBarView x:Name="StatusBar" Grid.Row="2" />
        </Grid>

        <Border x:Name="RightDivider" Grid.Column="3" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="RightResizeThumb"
            Grid.Column="3"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            DragCompleted="OnRightResizeCompleted"
            DragDelta="OnRightResizeDelta"
            DragStarted="OnRightResizeStarted" />

        <Grid x:Name="RightPanel" Grid.Column="4" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,0" Background="{ThemeResource NegaflowBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE9E9;" />
                <TextBlock x:Name="DevelopHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ISO — · — s · f/— · — mm" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Padding="8,14,20,14" Spacing="12">
                    <Border
                        x:Name="NoFrameCard"
                        MinHeight="180"
                        Padding="18"
                        Background="{ThemeResource NegaflowCardBrush}"
                        CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9E9;" />
                            <TextBlock x:Name="NoFrameInspectorText" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        x:Name="DevelopInspectorContent"
                        HorizontalAlignment="Stretch"
                        Spacing="12"
                        Visibility="Collapsed">
                        <controls:DevelopHistogram
                            x:Name="HistogramView"
                            HorizontalAlignment="Stretch"
                            ValueChanged="OnHistogramValueChanged" />

                        <Border
                            Padding="3"
                            AutomationProperties.AutomationId="negaflow.develop.tabs"
                            Background="{ThemeResource NegaflowSubtleFillBrush}"
                            CornerRadius="18">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="BasicTabButton"
                                    Grid.Column="0"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.basic"
                                    AutomationProperties.PositionInSet="1"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    IsChecked="True"
                                    Tag="Basic">
                                    <FontIcon FontSize="14" Glyph="&#xE9E9;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="BaseTabButton"
                                    Grid.Column="1"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.base"
                                    AutomationProperties.PositionInSet="2"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Base">
                                    <FontIcon FontSize="14" Glyph="&#xE706;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="EditTabButton"
                                    Grid.Column="2"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.edit"
                                    AutomationProperties.PositionInSet="3"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Edit">
                                    <FontIcon FontSize="14" Glyph="&#xE7A8;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="DefectsTabButton"
                                    Grid.Column="3"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.defects"
                                    AutomationProperties.PositionInSet="4"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Defects">
                                    <FontIcon FontSize="14" Glyph="&#xE771;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="InfoTabButton"
                                    Grid.Column="4"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.info"
                                    AutomationProperties.PositionInSet="5"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Info">
                                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="ResetTabButton"
                                    Grid.Column="5"
                                    MinHeight="30"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.reset"
                                    AutomationProperties.PositionInSet="6"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Reset">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                </ToggleButton>
                                <Border Grid.Column="0" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="BaseControlCard"
                            HorizontalAlignment="Stretch"
                            Padding="14"
                            Background="{ThemeResource NegaflowCardBrush}"
                            CornerRadius="14"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE706;" />
                                    <TextBlock x:Name="BaseSectionTitleText" Grid.Column="1" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="ManualBaseValueText"
                                        Grid.Column="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid
                                    x:Name="BaseModeControl"
                                    AutomationProperties.AutomationId="negaflow.develop.base"
                                    AutomationProperties.Name="Film base mode"
                                    ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        x:Name="BaseAutoModeButton"
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="negaflow.develop.base.mode.auto"
                                        AutomationProperties.Name="Base mode: Auto"
                                        Content="Auto"
                                        GroupName="BaseEstimationMode"
                                        Checked="OnBaseAutoModeChecked" />
                                    <RadioButton
                                        x:Name="BaseFilmModeButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="negaflow.develop.base.mode.film"
                                        AutomationProperties.Name="Base mode: Film"
                                        Content="Film"
                                        GroupName="BaseEstimationMode"
                                        Checked="OnBaseFilmModeChecked" />
                                    <RadioButton
                                        x:Name="BaseManualModeButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="negaflow.develop.base.mode.manual"
                                        AutomationProperties.Name="Base mode: Manual"
                                        Content="Manual"
                                        GroupName="BaseEstimationMode"
                                        Checked="OnBaseManualModeChecked" />
                                </Grid>
                                <StackPanel x:Name="FilmBaseControls" Spacing="8">
                                    <TextBlock FontSize="12" Text="Film stock" />
                                    <ComboBox
                                        x:Name="FilmStockSelector"
                                        AutomationProperties.AutomationId="negaflow.develop.base.film-stock"
                                        AutomationProperties.Name="Film stock"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="OnFilmStockSelectionChanged" />
                                    <TextBlock FontSize="12" Text="Light source" />
                                    <ComboBox
                                        x:Name="LightSourceSelector"
                                        AutomationProperties.AutomationId="negaflow.develop.base.light-source"
                                        AutomationProperties.Name="Light source"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="OnLightSourceSelectionChanged" />
                                </StackPanel>
                                <!-- Minimum/Maximum 은 엔진이 알려 준 값으로 코드에서 설정한다. -->
                                <StackPanel x:Name="ManualBaseControls" Spacing="10">
                                    <controls:InspectorSlider
                                        x:Name="BaseRedControl"
                                        CanReset="False"
                                        Label="Base Red"
                                        SliderAutomationId="negaflow.develop.base.red"
                                        ValueChanged="OnManualBaseChanged" />
                                    <controls:InspectorSlider
                                        x:Name="BaseGreenControl"
                                        CanReset="False"
                                        Label="Base Green"
                                        SliderAutomationId="negaflow.develop.base.green"
                                        ValueChanged="OnManualBaseChanged" />
                                    <controls:InspectorSlider
                                        x:Name="BaseBlueControl"
                                        CanReset="False"
                                        Label="Base Blue"
                                        SliderAutomationId="negaflow.develop.base.blue"
                                        ValueChanged="OnManualBaseChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="CommonAdjustmentStack" HorizontalAlignment="Stretch" Spacing="12">
                            <Border
                                x:Name="QuickActionsCard"
                                HorizontalAlignment="Stretch"
                                Padding="10"
                                AutomationProperties.AutomationId="negaflow.develop.quick-actions"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="AutoToneButton"
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="negaflow.develop.auto-tone"
                                            Click="OnAutoToneClicked" />
                                        <Button
                                            x:Name="AutoWhiteBalanceButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="negaflow.develop.auto-white-balance"
                                            Click="OnAutoWhiteBalanceClicked" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="AutoAdjustStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="BasicToneSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.tone"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="BasicToneHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.tone.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="Tone">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9E9;" />
                                                <TextBlock x:Name="BasicToneSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="BasicToneChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE70D;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="BasicToneResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnBasicToneResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <!-- Minimum/Maximum 은 엔진이 알려 준 값으로 코드에서 설정한다. -->
                                    <StackPanel
                                        x:Name="BasicToneControls"
                                        HorizontalAlignment="Stretch"
                                        Spacing="10"
                                        TabFocusNavigation="Cycle">
                                        <controls:InspectorSlider x:Name="ExposureControl" HorizontalAlignment="Stretch" Label="Exposure" ResetValue="0" SliderAutomationId="negaflow.develop.exposure" ValueChanged="OnExposureChanged" />
                                        <controls:InspectorSlider x:Name="ContrastControl" HorizontalAlignment="Stretch" Label="Contrast" ResetValue="0" SliderAutomationId="negaflow.develop.contrast" ValueChanged="OnBasicToneChanged" />
                                        <controls:InspectorSlider x:Name="HighlightsControl" HorizontalAlignment="Stretch" Label="Highlights" ResetValue="0" SliderAutomationId="negaflow.develop.highlights" ValueChanged="OnBasicToneChanged" />
                                        <controls:InspectorSlider x:Name="ShadowsControl" HorizontalAlignment="Stretch" Label="Shadows" ResetValue="0" SliderAutomationId="negaflow.develop.shadows" ValueChanged="OnBasicToneChanged" />
                                        <controls:InspectorSlider x:Name="WhitesControl" HorizontalAlignment="Stretch" Label="Whites" ResetValue="0" SliderAutomationId="negaflow.develop.whites" ValueChanged="OnBasicToneChanged" />
                                        <controls:InspectorSlider x:Name="BlacksControl" HorizontalAlignment="Stretch" Label="Blacks" ResetValue="0" SliderAutomationId="negaflow.develop.blacks" ValueChanged="OnBasicToneChanged" />
                                        <controls:InspectorSlider x:Name="DensityControl" HorizontalAlignment="Stretch" Label="Density" ResetValue="0" SliderAutomationId="negaflow.develop.density" ValueChanged="OnBasicToneChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ToneCurveSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.tone-curve"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="ToneCurveHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.tone-curve.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="ToneCurve">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE81E;" />
                                                <TextBlock x:Name="ToneCurveSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="ToneCurveChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="ToneCurveResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnToneCurveResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="ToneCurveControls" HorizontalAlignment="Stretch" Spacing="10" Visibility="Collapsed">
                                        <controls:InspectorSlider x:Name="CurveHighlightsControl" HorizontalAlignment="Stretch" Label="Highlights" ResetValue="0" SliderAutomationId="negaflow.develop.curve.highlights" ValueChanged="OnToneCurveChanged" />
                                        <controls:InspectorSlider x:Name="CurveLightsControl" HorizontalAlignment="Stretch" Label="Lights" ResetValue="0" SliderAutomationId="negaflow.develop.curve.lights" ValueChanged="OnToneCurveChanged" />
                                        <controls:InspectorSlider x:Name="CurveDarksControl" HorizontalAlignment="Stretch" Label="Darks" ResetValue="0" SliderAutomationId="negaflow.develop.curve.darks" ValueChanged="OnToneCurveChanged" />
                                        <controls:InspectorSlider x:Name="CurveShadowsControl" HorizontalAlignment="Stretch" Label="Shadows" ResetValue="0" SliderAutomationId="negaflow.develop.curve.shadows" ValueChanged="OnToneCurveChanged" />
                                        <Border Height="2" HorizontalAlignment="Stretch" Background="{ThemeResource NegaflowDividerBrush}" />
                                        <controls:ToneCurveEditor x:Name="PointCurveEditor" HorizontalAlignment="Stretch" CurvesChanged="OnPointCurvesChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ColorMixerSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.color-mixer"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="ColorMixerHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.color-mixer.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="ColorMixer">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE790;" />
                                                <TextBlock x:Name="ColorMixerSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="ColorMixerChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="ColorMixerResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnColorMixerResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <controls:ColorMixerEditor
                                        x:Name="ColorMixerEditor"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="negaflow.develop.color-mixer"
                                        AutomationProperties.Name="Color Mixer"
                                        MixerChanged="OnColorMixerChanged"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ColorGradingSection"
                                HorizontalAlignment="Stretch"
                                Padding="14"
                                AutomationProperties.AutomationId="negaflow.develop.section.color-grading"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="14">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:DisclosureButton
                                            x:Name="ColorGradingHeaderButton"
                                            Grid.Column="0"
                                            MinHeight="26"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="negaflow.develop.section.color-grading.header"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnInspectorSectionHeaderClicked"
                                            ExpansionRequested="OnInspectorSectionExpansionRequested"
                                            Tag="ColorGrading">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE2B1;" />
                                                <TextBlock x:Name="ColorGradingSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                                <FontIcon x:Name="ColorGradingChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                                            </Grid>
                                        </controls:DisclosureButton>
                                        <Button x:Name="ColorGradingResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnColorGradingResetClicked">
                                            <FontIcon FontSize="12" Glyph="&#xE777;" />
                                        </Button>
                                    </Grid>
                                    <controls:ColorGradingEditor
                                        x:Name="ColorGradingEditor"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="negaflow.develop.color-grading"
                                        AutomationProperties.Name="Color Grading"
                                        GradingChanged="OnColorGradingChanged"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
