<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.DevelopWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:Negaflow.Shell.Views"
    xmlns:sources="using:Negaflow.Shell.Views.Develop.Sources"
    xmlns:info="using:Negaflow.Shell.Views.Develop.Info"
    xmlns:inspector="using:Negaflow.Shell.Views.Develop.Inspector">
    <UserControl.Resources>
        <!-- macOS DevelopInspectorTabLabel: outer radius 18, selected/hover radius 15,
             icon row minimum height 32. WinUI 기본 ToggleButton chrome은 이 형상을 바꾸므로
             이 표면에서만 쓰는 plain template으로 고정합니다. -->
        <Style x:Key="NegaflowDevelopInspectorTabStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowSubtleFillBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                            <Setter Target="Surface.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="Surface.Background" Value="{ThemeResource NegaflowCardBrush}" />
                                            <Setter Target="Surface.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NegaflowGrainMendActionStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="7,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="NegaflowGrainMendResetStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="0,0,3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="{ThemeResource NegaflowWindowBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <sources:DevelopSourceSidebar
            x:Name="LeftPanel"
            Grid.Column="0" />

        <!-- 선택/단축키 호환을 위한 비표시 상태 컨트롤입니다. macOS 화면에는
             단일 프레임 ComboBox가 없으므로 렌더링하지 않습니다. -->
        <Grid Visibility="Collapsed">
            <StackPanel x:Name="NoFrameLeftPanel">
                <TextBlock x:Name="NoFrameLeftText" />
            </StackPanel>
            <StackPanel x:Name="FramePanel">
                <TextBlock x:Name="SelectedFrameText" />
                <ComboBox x:Name="FrameSelector" DisplayMemberPath="DisplayName" SelectionChanged="OnFrameSelectionChanged" />
                <TextBlock x:Name="ExportStatusText" />
            </StackPanel>
        </Grid>

        <Border x:Name="LeftDivider" Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="LeftResizeThumb"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            DragCompleted="OnLeftResizeCompleted"
            DragDelta="OnLeftResizeDelta"
            DragStarted="OnLeftResizeStarted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="CanvasHost"
                Grid.Row="0"
                AutomationProperties.AutomationId="negaflow.canvas"
                Background="{ThemeResource NegaflowCanvasBrush}"
                IsTabStop="True"
                KeyDown="OnCanvasKeyDown"
                PointerCanceled="OnCanvasPointerCancelled"
                PointerCaptureLost="OnCanvasPointerCaptureLost"
                PointerMoved="OnCanvasPointerMoved"
                PointerPressed="OnCanvasPointerPressed"
                PointerReleased="OnCanvasPointerReleased"
                SizeChanged="OnCanvasSizeChanged">
                <StackPanel x:Name="EmptyCanvasPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="42" Foreground="#FF8A8A8A" Glyph="&#xE91B;" />
                    <TextBlock x:Uid="emptyCanvasTitle" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#FFE2E2E2" />
                    <TextBlock
                        x:Uid="emptyCanvasDescription"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="#FFA8A8A8"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Image
                    x:Name="PreviewImage"
                    Margin="24"
                    AutomationProperties.AutomationId="negaflow.canvas.preview"
                    Stretch="Uniform"
                    Visibility="Collapsed" />

                <!-- 픽셀 샘플러의 읽은 값입니다. 설정에서 켰을 때만 나옵니다. -->
                <Border
                    x:Name="PixelSamplerPanel"
                    Margin="24"
                    Padding="10,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="negaflow.canvas.pixel-sampler"
                    Background="#CC101010"
                    CornerRadius="9"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel MaxWidth="390" Spacing="5">
                        <TextBlock
                            x:Name="PixelSamplerCoordinate"
                            FontFamily="Consolas"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FFE6E6E6" />
                        <TextBlock
                            x:Name="PixelSamplerOriginal"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#FFCFCFCF" />
                        <TextBlock
                            x:Name="PixelSamplerDisplayed"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#FFCFCFCF" />
                        <TextBlock
                            x:Name="PixelSamplerHint"
                            FontSize="11"
                            Foreground="#FF9A9A9A"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 검출 결과 오버레이입니다. 미리보기와 같은 사각형을 차지하도록 같은
                     여백과 Stretch 를 씁니다 — 어긋나면 표시가 실제 자리와 달라집니다. -->
                <Image
                    x:Name="DefectOverlayImage"
                    Margin="24"
                    AutomationProperties.AutomationId="negaflow.canvas.defect-overlay"
                    IsHitTestVisible="False"
                    Opacity="0.75"
                    Stretch="Uniform"
                    Visibility="Collapsed" />

                <Canvas x:Name="GuidedDefectOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle
                        x:Name="GuidedDefectSelection"
                        AutomationProperties.AutomationId="negaflow.canvas.defect-guided.selection"
                        Fill="#12FFD84A"
                        Stroke="#E6FFD84A"
                        StrokeThickness="1.5" />
                </Canvas>

                <Canvas x:Name="CropOverlay" Visibility="Collapsed">
                    <Rectangle x:Name="CropDimTop" Fill="#73000000" />
                    <Rectangle x:Name="CropDimBottom" Fill="#73000000" />
                    <Rectangle x:Name="CropDimLeft" Fill="#73000000" />
                    <Rectangle x:Name="CropDimRight" Fill="#73000000" />
                    <Rectangle
                        x:Name="CropSelection"
                        AutomationProperties.AutomationId="negaflow.canvas.crop.selection"
                        Fill="Transparent"
                        RadiusX="2"
                        RadiusY="2"
                        Stroke="White"
                        StrokeThickness="1.5" />
                    <Line x:Name="CropThirdVerticalFirst" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Line x:Name="CropThirdVerticalSecond" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Line x:Name="CropThirdHorizontalFirst" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Line x:Name="CropThirdHorizontalSecond" Stroke="#57FFFFFF" StrokeThickness="0.5" />
                    <Rectangle x:Name="CropHandleTopLeft" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleTop" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleTopRight" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleRight" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleBottomRight" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleBottom" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleBottomLeft" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Rectangle x:Name="CropHandleLeft" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
                    <Border
                        x:Name="CropActionBar"
                        Background="{ThemeResource NegaflowPanelBrush}"
                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CropApplyButton" Click="OnCropApplyClicked" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="CropFullButton" Click="OnCropFullClicked" />
                            <Button x:Name="CropCancelButton" Click="OnCropCancelClicked" />
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>

            <views:FilmstripView x:Name="Filmstrip" Grid.Row="1" />
            <views:StatusBarView x:Name="StatusBar" Grid.Row="2" />
        </Grid>

        <Border x:Name="RightDivider" Grid.Column="3" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="RightResizeThumb"
            Grid.Column="3"
            Width="8"
            HorizontalAlignment="Center"
            Background="Transparent"
            DragCompleted="OnRightResizeCompleted"
            DragDelta="OnRightResizeDelta"
            DragStarted="OnRightResizeStarted" />

        <Grid x:Name="RightPanel" Grid.Column="4" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,0" Background="{ThemeResource NegaflowBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE9E9;" />
                <TextBlock x:Name="DevelopHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ISO — · — s · f/— · — mm" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Padding="8,14,20,14" Spacing="12">
                    <Border
                        x:Name="NoFrameCard"
                        MinHeight="180"
                        Padding="18"
                        Background="{ThemeResource NegaflowCardBrush}"
                        CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9E9;" />
                            <TextBlock x:Name="NoFrameInspectorText" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        x:Name="DevelopInspectorContent"
                        HorizontalAlignment="Stretch"
                        Spacing="12"
                        Visibility="Collapsed">
                        <controls:DevelopHistogram
                            x:Name="HistogramView"
                            HorizontalAlignment="Stretch"
                            ValueChanged="OnHistogramValueChanged" />

                        <Border
                            HorizontalAlignment="Stretch"
                            Padding="3"
                            AutomationProperties.AutomationId="negaflow.develop.tabs"
                            Background="{ThemeResource NegaflowSubtleFillBrush}"
                            CornerRadius="18">
                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="BasicTabButton"
                                    Grid.Column="0"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.basic"
                                    AutomationProperties.PositionInSet="1"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    IsChecked="True"
                                    Tag="Basic">
                                    <FontIcon FontSize="14" Glyph="&#xE9E9;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="BaseTabButton"
                                    Grid.Column="1"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.base"
                                    AutomationProperties.PositionInSet="2"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Base">
                                    <FontIcon FontSize="14" Glyph="&#xE706;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="EditTabButton"
                                    Grid.Column="2"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.edit"
                                    AutomationProperties.PositionInSet="3"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Edit">
                                    <FontIcon FontSize="14" Glyph="&#xE7A8;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="DefectsTabButton"
                                    Grid.Column="3"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.defects"
                                    AutomationProperties.PositionInSet="4"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Defects">
                                    <FontIcon FontSize="14" Glyph="&#xE771;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="InfoTabButton"
                                    Grid.Column="4"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.info"
                                    AutomationProperties.PositionInSet="5"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Info">
                                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="ResetTabButton"
                                    Grid.Column="5"
                                    Style="{StaticResource NegaflowDevelopInspectorTabStyle}"
                                    AutomationProperties.AutomationId="negaflow.develop.tabs.reset"
                                    AutomationProperties.PositionInSet="6"
                                    AutomationProperties.SizeOfSet="6"
                                    Click="OnInspectorTabClicked"
                                    Tag="Reset">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                </ToggleButton>
                                <Border Grid.Column="0" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="2" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="3" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                                <Border Grid.Column="4" Width="1" Height="15" HorizontalAlignment="Right" Background="{ThemeResource NegaflowDividerBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- GrainMend: macOS 와 같은 네 도구입니다. 검출 결과는 아래의 명시적
                             제거/취소와 Canvas Enter/Esc에서만 recipe로 확정하거나 버립니다. -->
                        <Border
                            x:Name="GrainMendCard"
                            HorizontalAlignment="Stretch"
                            Padding="14"
                            AutomationProperties.AutomationId="negaflow.develop.grainmend"
                            Background="{ThemeResource NegaflowCardBrush}"
                            CornerRadius="14"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="14" Glyph="&#xE7A8;" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GrainMendTitleText" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="GrainMendAutoPill"
                                        Grid.Column="0"
                                        MinHeight="31"
                                        Background="{ThemeResource NegaflowSubtleFillBrush}"
                                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid ColumnSpacing="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="GrainMendAutoButton"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.auto"
                                                Click="OnGrainMendAutoClicked"
                                                Style="{StaticResource NegaflowGrainMendActionStyle}">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                    <TextBlock x:Name="GrainMendAutoText" />
                                                </Viewbox>
                                            </Button>
                                            <Button
                                                x:Name="GrainMendAutoResetButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.auto.reset"
                                                Click="OnGrainMendAutoResetClicked"
                                                Style="{StaticResource NegaflowGrainMendResetStyle}">
                                                <FontIcon FontSize="11" Glyph="&#xE777;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="GrainMendGuidedPill"
                                        Grid.Column="1"
                                        MinHeight="31"
                                        Background="{ThemeResource NegaflowSubtleFillBrush}"
                                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid ColumnSpacing="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="GrainMendGuidedButton"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.guided"
                                                Click="OnGrainMendGuidedClicked"
                                                Style="{StaticResource NegaflowGrainMendActionStyle}">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                    <TextBlock x:Name="GrainMendGuidedText" />
                                                </Viewbox>
                                            </Button>
                                            <Button
                                                x:Name="GrainMendGuidedResetButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.guided.reset"
                                                Click="OnGrainMendGuidedResetClicked"
                                                Style="{StaticResource NegaflowGrainMendResetStyle}">
                                                <FontIcon FontSize="11" Glyph="&#xE777;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="GrainMendBrushPill"
                                        Grid.Column="2"
                                        MinHeight="31"
                                        Background="{ThemeResource NegaflowSubtleFillBrush}"
                                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid ColumnSpacing="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="GrainMendBrushButton"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.brush"
                                                Click="OnGrainMendBrushClicked"
                                                Style="{StaticResource NegaflowGrainMendActionStyle}">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                    <TextBlock x:Name="GrainMendBrushText" />
                                                </Viewbox>
                                            </Button>
                                            <Button
                                                x:Name="GrainMendBrushResetButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.brush.reset"
                                                Click="OnGrainMendBrushResetClicked"
                                                Style="{StaticResource NegaflowGrainMendResetStyle}">
                                                <FontIcon FontSize="11" Glyph="&#xE777;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="GrainMendClonePill"
                                        Grid.Column="3"
                                        MinHeight="31"
                                        Background="{ThemeResource NegaflowSubtleFillBrush}"
                                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid ColumnSpacing="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="GrainMendCloneButton"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.clone"
                                                Click="OnGrainMendCloneClicked"
                                                Style="{StaticResource NegaflowGrainMendActionStyle}">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                    <TextBlock x:Name="GrainMendCloneText" />
                                                </Viewbox>
                                            </Button>
                                            <Button
                                                x:Name="GrainMendCloneResetButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="negaflow.develop.grainmend.clone.reset"
                                                Click="OnGrainMendCloneResetClicked"
                                                Style="{StaticResource NegaflowGrainMendResetStyle}">
                                                <FontIcon FontSize="11" Glyph="&#xE777;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <StackPanel
                                    x:Name="GrainMendReviewTuning"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="GrainMendSensitivityLabel"
                                        VerticalAlignment="Center"
                                        FontSize="12" />
                                    <Slider
                                        x:Name="GrainMendSensitivitySlider"
                                        Width="110"
                                        Minimum="0.7"
                                        Maximum="6"
                                        StepFrequency="0.1"
                                        SmallChange="0.1"
                                        LargeChange="0.5"
                                        AutomationProperties.AutomationId="negaflow.develop.grainmend.sensitivity"
                                        ValueChanged="OnGrainMendSensitivityValueChanged"
                                        PointerReleased="OnGrainMendSensitivityPointerReleased"
                                        KeyUp="OnGrainMendSensitivityKeyUp" />
                                    <ToggleSwitch
                                        x:Name="GrainMendMicroSpecksToggle"
                                        MinWidth="112"
                                        OffContent=""
                                        OnContent=""
                                        AutomationProperties.AutomationId="negaflow.develop.grainmend.micro-specks"
                                        Toggled="OnGrainMendMicroSpecksToggled" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="GrainMendReviewActions"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <Button
                                        x:Name="GrainMendRemoveButton"
                                        MinHeight="30"
                                        AutomationProperties.AutomationId="negaflow.develop.grainmend.remove"
                                        Click="OnGrainMendRemoveClicked" />
                                    <Button
                                        x:Name="GrainMendCancelButton"
                                        MinHeight="30"
                                        AutomationProperties.AutomationId="negaflow.develop.grainmend.cancel"
                                        Click="OnGrainMendCancelClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- GrainMend 레이어: 적용된 결함 제거를 항목별로 되돌릴 수 있는
                             목록입니다. macOS DefectLayerSection 과 같은 자리, 같은 순서입니다. -->
                        <controls:DefectLayerSection x:Name="DefectLayers" />


                        <info:DevelopInfoCards x:Name="InfoCards" Visibility="Collapsed" />

                        <inspector:DevelopBaseCard x:Name="BaseCard" Visibility="Collapsed" />
                        <inspector:DevelopGeometryCard x:Name="GeometryCard" Visibility="Collapsed" />

                        <inspector:DevelopAdjustmentStack x:Name="Adjustments" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
