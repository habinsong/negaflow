<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.AppMenuBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      macOS 메뉴막대는 화면 맨 위(시스템)에 있습니다. Windows 는 창 안에 두므로
      제목줄 아래 한 줄이 그 자리입니다. 첫 메뉴는 앱 메뉴(.appInfo) 입니다.
    -->
    <MenuBar
        x:Name="Host"
        AutomationProperties.AutomationId="negaflow.menu.bar"
        Background="{ThemeResource NegaflowWindowBrush}">
        <MenuBarItem
            x:Name="AppMenu"
            AutomationProperties.AutomationId="negaflow.menu.app"
            Title="negaflow">
            <MenuFlyoutItem
                x:Name="AboutItem"
                AutomationProperties.AutomationId="negaflow.menu.about"
                Click="OnAboutClick" />
            <MenuFlyoutItem
                x:Name="SettingsItem"
                AutomationProperties.AutomationId="negaflow.menu.settings"
                Click="OnSettingsClick" />
        </MenuBarItem>
        <!--
          macOS AppStandardMenuCommands CommandGroup(after: .newItem) + (after: .importExport).
          Windows 에는 시스템 파일 메뉴가 없어서 이 여섯 항목이 파일 메뉴 전부입니다.
        -->
        <MenuBarItem
            x:Name="FileMenu"
            AutomationProperties.AutomationId="negaflow.menu.file"
            Title="File">
            <MenuFlyoutItem
                x:Name="ImportImagesItem"
                AutomationProperties.AutomationId="negaflow.menu.import-images"
                Click="OnImportImagesClick" />
            <MenuFlyoutItem
                x:Name="ImportFolderItem"
                AutomationProperties.AutomationId="negaflow.menu.import-folder"
                Click="OnImportFolderClick" />
            <MenuFlyoutItem
                x:Name="RefreshLibraryItem"
                AutomationProperties.AutomationId="negaflow.menu.refresh-library"
                Click="OnRefreshLibraryClick" />
            <MenuFlyoutItem
                x:Name="LoadScannerItem"
                AutomationProperties.AutomationId="negaflow.menu.load-scanner"
                Click="OnLoadScannerClick" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="QuickExportItem"
                AutomationProperties.AutomationId="negaflow.menu.quick-export"
                Click="OnQuickExportClick" />
            <MenuFlyoutItem
                x:Name="ExportItem"
                AutomationProperties.AutomationId="negaflow.menu.export"
                Click="OnExportClick" />
        </MenuBarItem>
    </MenuBar>
</UserControl>
