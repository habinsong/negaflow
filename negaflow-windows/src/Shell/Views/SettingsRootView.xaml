<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.SettingsRootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:settings="using:Negaflow.Shell.Views.Settings"
    AutomationProperties.AutomationId="settings.window">
    <!--
        이 파일은 설정 창 하나의 골격입니다 — macOS AppSettingsView.swift 한 벌에 대응하는
        탭바·스크롤러·여백이 여기 한 벌만 있습니다. 화면이 큰 두 탭은 그 골격을 복제하지
        않고 내용만 UserControl 로 옮겼습니다 (Settings/SettingsDiskPage.xaml ·
        Settings/SettingsExportPage.xaml). 탭마다 로직은 부분 클래스에 그대로 있고
        (SettingsRootView.GeneralTab.cs · InterfaceWorkflowTabs.cs · ScanTab.cs · DiskTab.cs ·
        ExportTab.cs · Shortcuts.cs), 배치 수치는 controls/SettingsLayout.cs 한 곳에만 둡니다.
    -->
    <Grid Background="{ThemeResource NegaflowWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            탭바입니다. 여덟 칸이 **모두 같은 폭(56)** 이고 한 덩어리로 가운데 섭니다.
            맥 스크린샷 실측: 선택 배경 x 266..321 = 56, 여덟 칸이 창 가운데.
            폭을 별표(*)로 나누면 창이 넓어질 때 칸이 좌우로 벌어져 맥과 달라집니다.
        -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="0"
            Background="{ThemeResource NegaflowBarBrush}">

            <Button x:Name="GeneralButton" Tag="General" AutomationProperties.AutomationId="settings.category.general" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE713;" />
                    <TextBlock x:Name="GeneralLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="InterfaceButton" Tag="Interface" AutomationProperties.AutomationId="settings.category.interface" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE90C;" />
                    <TextBlock x:Name="InterfaceLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="WorkflowButton" Tag="Workflow" AutomationProperties.AutomationId="settings.category.workflow" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE81E;" />
                    <TextBlock x:Name="WorkflowLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ScanButton" Tag="Scan" AutomationProperties.AutomationId="settings.category.scan" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE8FE;" />
                    <TextBlock x:Name="ScanLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="DiskButton" Tag="Disk" AutomationProperties.AutomationId="settings.category.disk" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xEDA2;" />
                    <TextBlock x:Name="DiskLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ExportSettingsButton" Tag="Export" AutomationProperties.AutomationId="settings.category.export" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE72D;" />
                    <TextBlock x:Name="ExportLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ShortcutsButton" Tag="Shortcuts" AutomationProperties.AutomationId="settings.category.shortcuts" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE765;" />
                    <TextBlock x:Name="ShortcutsLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="LegalButton" Tag="Legal" AutomationProperties.AutomationId="settings.category.legal" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <FontIcon FontSize="19" Glyph="&#xE8A5;" />
                    <TextBlock x:Name="LegalLabel" FontSize="11" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="27,20,27,28">
                <!--
                    macOS AppSettingsView.generalPane 그대로입니다.
                    섹션 셋: 일반(언어/화면 모드/개발자 모드) - 메모리 캐시 - 지원 번들.
                    행 배치는 controls:SettingsRow 가 맡습니다 - 라벨 왼쪽, 컨트롤 오른쪽 제 크기.
                -->
                <StackPanel x:Name="GeneralPage" AutomationProperties.AutomationId="settings.general" Spacing="28">
                    <controls:SettingsSection x:Name="GeneralSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsRow x:Name="LanguageRow">
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    MinWidth="150"
                                    AutomationProperties.AutomationId="settings.language"
                                    SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem x:Name="LanguageSystemItem" Content="System" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="한국어" />
                                    <ComboBoxItem Content="日本語" />
                                    <ComboBoxItem Content="简体中文" />
                                    <ComboBoxItem Content="Français" />
                                    <ComboBoxItem Content="Deutsch" />
                                </ComboBox>
                            </controls:SettingsRow>
                            <controls:SettingsRow x:Name="AppearanceRow">
                                <ComboBox
                                    x:Name="AppearanceComboBox"
                                    MinWidth="150"
                                    AutomationProperties.AutomationId="settings.appearance"
                                    SelectionChanged="OnAppearanceSelectionChanged">
                                    <ComboBoxItem x:Name="SystemAppearanceItem" />
                                    <ComboBoxItem x:Name="DarkAppearanceItem" />
                                    <ComboBoxItem x:Name="LightAppearanceItem" />
                                </ComboBox>
                            </controls:SettingsRow>
                            <controls:SettingsToggleRow
                                x:Name="DeveloperModeRow"
                                AutomationId="settings.developer-mode" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>

                    <controls:SettingsSection x:Name="MemoryCacheSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsRow x:Name="MemoryCacheModeRow">
                                <controls:NegaflowSegmentedPicker
                                    x:Name="MemoryCacheModePicker"
                                    MinWidth="150"
                                    AutomationProperties.AutomationId="settings.memory-cache.mode" />
                            </controls:SettingsRow>
                            <!--
                                macOS MemoryCacheSettingsSection: 자동이면 값 두 줄, 수동이면
                                슬라이더 두 줄 + "자동값으로 되돌리기". 둘을 함께 두고 보임만
                                바꿉니다 - 행을 지웠다 만들면 분리선을 다시 놓아야 합니다.
                            -->
                            <controls:SettingsValueRow x:Name="MemoryCacheCleanedRawRow" />
                            <controls:SettingsValueRow x:Name="MemoryCacheDevelopedRow" />
                            <controls:SettingsSliderRow x:Name="MemoryCacheCleanedRawSlider" Visibility="Collapsed" />
                            <controls:SettingsSliderRow x:Name="MemoryCacheDevelopedSlider" Visibility="Collapsed" />
                            <controls:SettingsRow x:Name="MemoryCacheResetRow" Visibility="Collapsed">
                                <Button
                                    x:Name="MemoryCacheResetButton"
                                    AutomationProperties.AutomationId="settings.memory-cache.reset"
                                    Click="OnMemoryCacheResetClick" />
                            </controls:SettingsRow>
                            <controls:SettingsFootnote x:Name="MemoryCacheHelp" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>

                    <controls:SettingsSection x:Name="SupportBundleSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsRow x:Name="SupportBundleRow">
                                <Button
                                    x:Name="SupportBundleExportButton"
                                    AutomationProperties.AutomationId="settings.support-bundle.export"
                                    Click="OnSupportBundleExportClick" />
                            </controls:SettingsRow>
                            <controls:SettingsFootnote
                                x:Name="SupportBundleResult"
                                Visibility="Collapsed" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                </StackPanel>
                <!-- macOS AppSettingsView.interfacePane: 한 구역, 세 줄. -->
                <StackPanel x:Name="InterfacePage" AutomationProperties.AutomationId="settings.interface" Spacing="30" Visibility="Collapsed">
                    <controls:SettingsSection x:Name="InterfaceSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsRow x:Name="CanvasBackgroundRow">
                                <controls:NegaflowSegmentedPicker
                                    x:Name="CanvasBackgroundPicker"
                                    Width="132"
                                    AutomationProperties.AutomationId="settings.interface.canvas-background" />
                            </controls:SettingsRow>
                            <controls:SettingsToggleRow
                                x:Name="ClippingOverlayRow"
                                AutomationId="settings.interface.clipping-overlay" />
                            <controls:SettingsToggleRow
                                x:Name="PixelSamplerRow"
                                AutomationId="settings.interface.pixel-sampler" />
                            <controls:SettingsFootnote x:Name="PixelSamplerHelp" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                </StackPanel>

                <!-- macOS AppSettingsView.workflowPane: 두 구역. -->
                <StackPanel x:Name="WorkflowPage" AutomationProperties.AutomationId="settings.workflow" Spacing="30" Visibility="Collapsed">
                    <controls:SettingsSection x:Name="WorkflowSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsToggleRow
                                x:Name="ScannerSimulatorRow"
                                AutomationId="settings.workflow.scanner-simulator" />
                            <controls:SettingsToggleRow
                                x:Name="DevelopImportsRow"
                                AutomationId="settings.workflow.develop-imports" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                    <controls:SettingsSection x:Name="MicroSpecksSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsToggleRow
                                x:Name="AutoDefectMicroSpecksRow"
                                AutomationId="settings.workflow.auto-defect-micro-specks" />
                            <controls:SettingsToggleRow
                                x:Name="GuidedDefectMicroSpecksRow"
                                AutomationId="settings.workflow.guided-defect-micro-specks" />
                            <controls:SettingsFootnote x:Name="MicroSpecksHelp" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                </StackPanel>

                <!--
                    macOS AppSettingsView.scanPane + ScannerTruthSettingsSection 입니다.
                    구역 셋 — 스캔(기본 방향 + 도움말) · 스캐너 정보 · 스캐너 플러그인 승인.
                -->
                <StackPanel x:Name="ScanPage" AutomationProperties.AutomationId="settings.scan" Spacing="30" Visibility="Collapsed">
                    <controls:SettingsSection x:Name="ScanSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsRow x:Name="ScanRotationRow">
                                <ComboBox
                                    x:Name="ScanRotationComboBox"
                                    MinWidth="120"
                                    AutomationProperties.AutomationId="settings.scan.default-rotation"
                                    SelectionChanged="OnScanRotationChanged">
                                    <ComboBoxItem x:Name="ScanRotation0Item" />
                                    <ComboBoxItem x:Name="ScanRotation90Item" />
                                    <ComboBoxItem x:Name="ScanRotation180Item" />
                                    <ComboBoxItem x:Name="ScanRotation270Item" />
                                </ComboBox>
                            </controls:SettingsRow>
                            <controls:SettingsFootnote x:Name="ScanRotationHelp" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>

                    <!-- 장치가 스스로 보고한 값만 보여 줍니다. 앱이 지어낸 값은 없습니다. -->
                    <controls:SettingsSection x:Name="ScannerTruthSection" />
                    <controls:SettingsSection x:Name="ScannerPluginSection" Visibility="Collapsed" />
                </StackPanel>

                <settings:SettingsDiskPage x:Name="DiskPage" AutomationProperties.AutomationId="settings.disk" Visibility="Collapsed" />

                <!--
                    macOS AppSettingsView.exportPane + ColorManagementSettingsSection 그대로입니다.
                    구역 셋 — 빠른 내보내기 · 내보내기 무결성 검사 · 색상 관리.
                -->
                <settings:SettingsExportPage x:Name="ExportPage" AutomationProperties.AutomationId="settings.export" Visibility="Collapsed" />

                <!--
                    macOS WorkflowShortcutsSettingsSection 그대로입니다. 구역 셋 —
                    묶음 캡슐 · 그 묶음의 명령 표 · 전체 초기화.
                    실측(단축키.png): 캡슐 트랙 94..778, 명령 줄 높이 51,
                    녹화 칸 402..730(328), 되돌리기 738..778(40).
                -->
                <StackPanel x:Name="ShortcutsPage" AutomationProperties.AutomationId="settings.shortcuts" Spacing="30" Visibility="Collapsed">
                    <controls:SettingsSection x:Name="ShortcutsSection">
                        <controls:SettingsSection.Rows>
                            <Grid Height="54">
                                <controls:NegaflowSegmentedPicker
                                    x:Name="ShortcutGroupPicker"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="settings.shortcuts.group" />
                            </Grid>
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>

                    <controls:SettingsSection x:Name="ShortcutRowsSection" />

                    <controls:SettingsSection x:Name="ShortcutResetSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsRow x:Name="ShortcutResetAllRow">
                                <Button
                                    x:Name="ShortcutResetAllButton"
                                    AutomationProperties.AutomationId="settings.shortcuts.reset-all"
                                    Click="OnResetAllShortcuts" />
                            </controls:SettingsRow>
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                </StackPanel>

                <!-- macOS LegalNoticeSettingsSection: 구역 다섯, 각 카드에 문단 하나. -->
                <StackPanel x:Name="LegalPage" AutomationProperties.AutomationId="settings.legal" Spacing="30" Visibility="Collapsed">
                    <controls:SettingsSection x:Name="LegalLicenseSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsBody x:Name="LegalLicenseBody" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                    <controls:SettingsSection x:Name="LegalTrademarkSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsBody x:Name="LegalTrademarkBody" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                    <controls:SettingsSection x:Name="LegalNamesSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsBody x:Name="LegalNamesBody" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                    <controls:SettingsSection x:Name="LegalProfilesSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsBody x:Name="LegalProfilesBody" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                    <controls:SettingsSection x:Name="LegalAffiliationSection">
                        <controls:SettingsSection.Rows>
                            <controls:SettingsBody x:Name="LegalAffiliationBody" />
                        </controls:SettingsSection.Rows>
                    </controls:SettingsSection>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
