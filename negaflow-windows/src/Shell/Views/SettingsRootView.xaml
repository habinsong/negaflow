<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.SettingsRootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="settings.window">
    <Grid Background="{ThemeResource NegaflowWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="6,5" ColumnSpacing="2" Background="{ThemeResource NegaflowBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="GeneralButton" Grid.Column="0" Tag="General" AutomationProperties.AutomationId="settings.category.general" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE713;" />
                    <TextBlock x:Name="GeneralLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="InterfaceButton" Grid.Column="1" Tag="Interface" AutomationProperties.AutomationId="settings.category.interface" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE700;" />
                    <TextBlock x:Name="InterfaceLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="WorkflowButton" Grid.Column="2" Tag="Workflow" AutomationProperties.AutomationId="settings.category.workflow" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE8B7;" />
                    <TextBlock x:Name="WorkflowLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ScanButton" Grid.Column="3" Tag="Scan" AutomationProperties.AutomationId="settings.category.scan" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE950;" />
                    <TextBlock x:Name="ScanLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="DiskButton" Grid.Column="4" Tag="Disk" AutomationProperties.AutomationId="settings.category.disk" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xEDA2;" />
                    <TextBlock x:Name="DiskLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ExportSettingsButton" Grid.Column="5" Tag="Export" AutomationProperties.AutomationId="settings.category.export" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE72D;" />
                    <TextBlock x:Name="ExportLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="ShortcutsButton" Grid.Column="6" Tag="Shortcuts" AutomationProperties.AutomationId="settings.category.shortcuts" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE765;" />
                    <TextBlock x:Name="ShortcutsLabel" FontSize="11" />
                </StackPanel>
            </Button>
            <Button x:Name="LegalButton" Grid.Column="7" Tag="Legal" AutomationProperties.AutomationId="settings.category.legal" Click="OnCategoryClick" Style="{StaticResource NegaflowSettingsCategoryButtonStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon FontSize="22" Glyph="&#xE8A5;" />
                    <TextBlock x:Name="LegalLabel" FontSize="11" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="26,22,26,28">
                <StackPanel x:Name="GeneralPage" AutomationProperties.AutomationId="settings.general" Spacing="16">
                    <TextBlock x:Name="GeneralHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsLanguagePicker" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="settings.language"
                                    SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem x:Name="LanguageSystemItem" Content="System" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="한국어" />
                                    <ComboBoxItem Content="日本語" />
                                    <ComboBoxItem Content="简体中文" />
                                    <ComboBoxItem Content="Français" />
                                    <ComboBoxItem Content="Deutsch" />
                                </ComboBox>
                            </Grid>
                            <TextBlock
                                x:Name="LanguageRestartHint"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppearanceLabel" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="AppearanceComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="settings.appearance"
                                    SelectionChanged="OnAppearanceSelectionChanged">
                                    <ComboBoxItem x:Name="SystemAppearanceItem" />
                                    <ComboBoxItem x:Name="DarkAppearanceItem" />
                                    <ComboBoxItem x:Name="LightAppearanceItem" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <ToggleSwitch x:Name="DeveloperModeToggle" x:Uid="developerMode" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="InterfacePage" AutomationProperties.AutomationId="settings.interface" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="InterfaceHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsCanvasBackgroundPicker" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" SelectedIndex="0">
                                    <ComboBoxItem x:Uid="canvasBackgroundBlack" />
                                    <ComboBoxItem x:Uid="canvasBackgroundGray" />
                                    <ComboBoxItem x:Uid="canvasBackgroundWhite" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <ToggleSwitch x:Name="ClippingOverlayToggle" x:Uid="colorClippingOverlay" IsEnabled="False" />
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <ToggleSwitch
                                x:Name="PixelSamplerToggle"
                                AutomationProperties.AutomationId="settings.interface.pixel-sampler"
                                Toggled="OnPixelSamplerToggled" />
                            <TextBlock
                                x:Name="PixelSamplerHelp"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="WorkflowPage" AutomationProperties.AutomationId="settings.workflow" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="WorkflowHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="ScannerSimulatorToggle" x:Uid="commandToggleScannerSimulator" IsEnabled="False" />
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <ToggleSwitch x:Name="DevelopImportsToggle" x:Uid="developImportsAutomatically" IsEnabled="False" />
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <TextBlock x:Name="MicroSpecksHeading" FontSize="13" FontWeight="SemiBold" />
                            <ToggleSwitch
                                x:Name="AutoDefectMicroSpecksToggle"
                                AutomationProperties.AutomationId="settings.workflow.auto-defect-micro-specks"
                                Toggled="OnAutoDefectMicroSpecksToggled" />
                            <ToggleSwitch
                                x:Name="GuidedDefectMicroSpecksToggle"
                                AutomationProperties.AutomationId="settings.workflow.guided-defect-micro-specks"
                                Toggled="OnGuidedDefectMicroSpecksToggled" />
                            <TextBlock
                                x:Name="MicroSpecksHelp"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ScanPage" AutomationProperties.AutomationId="settings.scan" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ScanHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ScanRotationLabel" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="ScanRotationComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="settings.scan.default-rotation"
                                    SelectionChanged="OnScanRotationChanged">
                                    <ComboBoxItem x:Name="ScanRotation0Item" />
                                    <ComboBoxItem x:Name="ScanRotation90Item" />
                                    <ComboBoxItem x:Name="ScanRotation180Item" />
                                    <ComboBoxItem x:Name="ScanRotation270Item" />
                                </ComboBox>
                            </Grid>
                            <TextBlock
                                x:Name="ScanRotationHelp"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- 장치가 스스로 보고한 값만 보여 줍니다. 앱이 지어낸 값은 없습니다. -->
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="ScannerTruthHeading" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="ScannerTruthRows" Spacing="6" />
                            <TextBlock
                                x:Name="ScannerTruthEmpty"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DiskPage" AutomationProperties.AutomationId="settings.disk" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="DiskHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="SHA-256" />
                            <ToggleSwitch
                                x:Name="ImageHashToggle"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="settings.disk.image-sha256"
                                Toggled="OnImageHashToggled" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ExportPage" AutomationProperties.AutomationId="settings.export" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ExportHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="quickExportSection" FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsQuickExportFormat" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" SelectedIndex="0">
                                    <ComboBoxItem Content="JPEG" />
                                    <ComboBoxItem Content="PNG" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsQuickExportDPI" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" SelectedIndex="0">
                                    <ComboBoxItem x:Name="SourceDpiItem" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsQuickExportSize" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" SelectedIndex="0">
                                    <ComboBoxItem x:Name="FullSizeItem" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsQuickExportFolder" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="settingsColorManagementSection" FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsExportColorLabel" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="ExportColorSpaceComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="settings.export.colorSpace"
                                    SelectionChanged="OnExportColorSpaceChanged">
                                    <ComboBoxItem Content="sRGB" />
                                    <ComboBoxItem Content="Display P3" />
                                    <ComboBoxItem Content="Adobe RGB" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <ToggleSwitch
                                x:Name="SoftProofToggle"
                                x:Uid="settingsExportSoftProofLabel"
                                AutomationProperties.AutomationId="settings.export.softProof"
                                Toggled="OnSoftProofToggled" />
                            <StackPanel x:Name="SoftProofDetailPanel" Spacing="12" Visibility="Collapsed">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SoftProofProfileName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            x:Name="SoftProofChooseProfileButton"
                                            x:Uid="developExportChangeFolder"
                                            AutomationProperties.AutomationId="settings.export.softProof.chooseProfile"
                                            Click="OnChooseSoftProofProfile" />
                                        <Button
                                            x:Name="SoftProofResetProfileButton"
                                            x:Uid="developTabReset"
                                            Visibility="Collapsed"
                                            AutomationProperties.AutomationId="settings.export.softProof.resetProfile"
                                            Click="OnResetSoftProofProfile" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="SoftProofProfileError"
                                    x:Uid="softProofInvalidICC"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <!-- 인화 대상의 출력 프로파일입니다. 프루프 프로파일과 따로
                                     둡니다 — 화면 목적지와 종이 목적지는 같지 않습니다. -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PrinterProfileName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            x:Name="PrinterProfileButton"
                                            x:Uid="developExportChangeFolder"
                                            AutomationProperties.AutomationId="settings.export.printerProfile.choose"
                                            Click="OnChoosePrinterProfile" />
                                        <Button
                                            x:Name="PrinterProfileResetButton"
                                            x:Uid="developTabReset"
                                            Visibility="Collapsed"
                                            AutomationProperties.AutomationId="settings.export.printerProfile.reset"
                                            Click="OnResetPrinterProfile" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="PrinterProfileError"
                                    x:Uid="softProofInvalidICC"
                                    Visibility="Collapsed"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="settingsExportProofLabel" VerticalAlignment="Center" />
                                    <ComboBox
                                        x:Name="SoftProofSimulationComboBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="settings.export.softProof.simulation"
                                        SelectionChanged="OnSoftProofSimulationChanged">
                                        <ComboBoxItem x:Uid="settingsSoftProofProfileOnly" />
                                        <ComboBoxItem x:Uid="settingsSoftProofPaperAndBlack" />
                                    </ComboBox>
                                </Grid>
                                <ToggleSwitch
                                    x:Name="GamutWarningToggle"
                                    x:Uid="settingsColorGamutWarning"
                                    AutomationProperties.AutomationId="settings.export.gamutWarning"
                                    Toggled="OnGamutWarningToggled" />
                                <TextBlock
                                    x:Name="GamutUnavailableReason"
                                    x:Uid="settingsColorGamutUnavailableReason"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    FontSize="12" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsColorScannerInput" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScannerEmulationSummary" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsColorWorking" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Linear sRGB (Chromabase)" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsColorExport" VerticalAlignment="Center" />
                                <TextBlock x:Name="ExportColorSpaceSummary" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="settingsColorSoftProof" VerticalAlignment="Center" />
                                <TextBlock x:Name="SoftProofSummary" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutsPage" AutomationProperties.AutomationId="settings.shortcuts" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="ShortcutsHeading" FontSize="24" FontWeight="SemiBold" />
                    <!-- macOS 는 묶음 고르개 · 그 묶음의 표 · 전체 초기화 세 덩이입니다. -->
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="14">
                            <StackPanel
                                x:Name="ShortcutGroupBar"
                                AutomationProperties.AutomationId="settings.shortcuts.groups"
                                Orientation="Horizontal"
                                Spacing="4" />
                            <StackPanel
                                x:Name="ShortcutRows"
                                AutomationProperties.AutomationId="settings.shortcuts.rows"
                                Spacing="8" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <Button
                            x:Name="ShortcutResetAllButton"
                            x:Uid="shortcutResetAll"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="settings.shortcuts.reset-all"
                            Click="OnShortcutResetAllClicked" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LegalPage" AutomationProperties.AutomationId="settings.legal" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="LegalHeading" FontSize="24" FontWeight="SemiBold" />
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="legalLicenseTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Uid="legalLicenseBody" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="legalTrademarkTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Uid="legalTrademarkBody" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="legalNamesTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Uid="legalNamesBody" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="legalProfilesTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Uid="legalProfilesBody" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="legalAffiliationTitle" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Uid="legalAffiliationBody" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
