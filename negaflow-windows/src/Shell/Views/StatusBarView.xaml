<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Height="30"
        Padding="10,0"
        Background="{ThemeResource NegaflowBarBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
            <!--  macOS `StatusPhaseIndicator` — 점은 8, 글자와 사이 간격 10. 최근 문제가 있으면
                  빨갛고, 올리면 최신 문제를, 누르면 최근 문제 목록을 보여 줍니다. 누를 자리는
                  사방 4 씩 넓히되 배치 크기는 그대로 둡니다(macOS `.padding(4)` / `.padding(-4)`).  -->
            <Border
                x:Name="StateIndicatorHitArea"
                Margin="-4"
                Padding="4"
                VerticalAlignment="Center"
                Background="Transparent"
                AutomationProperties.AutomationId="negaflow.status.problems"
                Tapped="OnIndicatorTapped">
                <Ellipse x:Name="StateIndicator" Width="8" Height="8" />
                <FlyoutBase.AttachedFlyout>
                    <!--  macOS `RecentErrorsPopover` — 폭 320, 제목과 지우기, 구분선, 최신이 위인 목록.  -->
                    <Flyout>
                        <StackPanel Width="320" Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProblemsTitle" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button
                                    x:Name="ClearProblemsButton"
                                    Grid.Column="1"
                                    Padding="4"
                                    AutomationProperties.AutomationId="negaflow.status.problems.clear"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnClearProblemsClicked">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource NegaflowDividerBrush}" />
                            <ScrollViewer MaxHeight="220">
                                <StackPanel x:Name="ProblemsList" Spacing="8" />
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Border>
            <!--  **글자는 3초 뒤 사라집니다.** macOS 주석 그대로 - 상태가 계속 붙어 있으면
                  하단 바가 늘 지저분하고 가운데 메시지와 겹칠 여지도 커집니다. 폭 92 는
                  유지해 오른쪽 칸이 밀리지 않게 합니다.  -->
            <TextBlock
                x:Name="StateText"
                Width="92"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="StateDetail"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- macOS `statusBar` 의 trailing 묶음입니다. 차례도 그대로 —
             크기 HUD(− 100% +) · 정렬 메뉴 · 범위 메뉴, 사이 간격 10. -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
            <!-- macOS `compactFilmstripItemSizeHUD` — 세 칸이 간격 1 로 붙어 있습니다. -->
            <StackPanel Orientation="Horizontal" Spacing="1">
                <Button
                    x:Name="ThumbnailSmallerButton"
                    Width="22"
                    Height="22"
                    Padding="0"
                    AutomationProperties.AutomationId="negaflow.filmstrip.size.decrease"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnThumbnailSmallerClicked"
                    Content="&#x2212;"
                    FontSize="11" />
                <Button
                    x:Name="ThumbnailSizeButton"
                    Width="32"
                    Height="22"
                    Padding="0"
                    AutomationProperties.AutomationId="negaflow.filmstrip.size"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnThumbnailSizeResetClicked"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="ThumbnailLargerButton"
                    Width="22"
                    Height="22"
                    Padding="0"
                    AutomationProperties.AutomationId="negaflow.filmstrip.size.increase"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnThumbnailLargerClicked"
                    Content="+"
                    FontSize="11" />
            </StackPanel>

            <!-- macOS `bottomSortMenu` — 이름과 방향 화살표 하나. -->
            <DropDownButton
                x:Name="FilmstripSortButton"
                Height="22"
                Padding="4,0"
                AutomationProperties.AutomationId="negaflow.filmstrip.sort"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="FilmstripSortText" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                    <FontIcon x:Name="FilmstripSortDirectionIcon" FontSize="9" Glyph="&#xE74A;" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="FilmstripSortFlyout" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- macOS `bottomScopeMenu` — 이름과 필터 아이콘. -->
            <DropDownButton
                x:Name="FilmstripScopeButton"
                Height="22"
                Padding="4,0"
                AutomationProperties.AutomationId="negaflow.filmstrip.scope"
                Background="Transparent"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="FilmstripScopeText" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                    <FontIcon FontSize="9" Glyph="&#xE71C;" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="FilmstripScopeFlyout" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!--  macOS `StatusBarMessageRow` 의 가운데 상태 메시지 — caption, 한 줄, 최대 폭 320.
              3 초 뒤 사라집니다.  -->
        <TextBlock
            x:Name="MessageText"
            Grid.ColumnSpan="2"
            MaxWidth="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            IsHitTestVisible="False"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="negaflow.status.message" />
    </Grid>
</UserControl>
