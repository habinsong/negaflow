<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.FilmstripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <UserControl.Resources>
        <controls:FilmTypeNameConverter x:Key="FilmTypeNameConverter" />
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid x:Name="Root" Background="{ThemeResource NegaflowBarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="6" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Background="{ThemeResource NegaflowSubtleFillBrush}" />
            <Border
                Width="44"
                Height="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource TextFillColorSecondaryBrush}"
                CornerRadius="1" />
            <primitives:Thumb
                x:Name="ResizeThumb"
                Background="Transparent"
                AutomationProperties.AutomationId="negaflow.filmstrip-resize"
                DragCompleted="OnResizeCompleted"
                DragDelta="OnResizeDelta"
                DragStarted="OnResizeStarted"
                IsTabStop="True"
                KeyDown="OnResizeKeyDown" />
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>

            <!--  좌우 이동 단추는 필름스트립 높이를 따라 세로로 섭니다. 얇은 알약이면
                  누를 자리가 좁고, 썸네일 줄과 눈높이도 맞지 않습니다.  -->
            <Button
                x:Name="PreviousButton"
                Grid.Column="0"
                Width="34"
                Margin="8,12"
                Padding="0"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="{ThemeResource NegaflowSubtleFillBrush}"
                BorderThickness="0"
                Click="OnPreviousClicked"
                CornerRadius="8"
                IsEnabled="False">
                <FontIcon FontSize="13" Glyph="&#xE76B;" />
            </Button>

            <StackPanel
                x:Name="EmptyFilmstripPanel"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="5">
                <FontIcon FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE7C8;" />
                <TextBlock x:Name="NoImagesLocalized" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!--
                필름스트립 카드는 라이브러리 카드와 같은 구조를 쓰되 macOS 처럼 compact 여백입니다.
                크기는 스트립 높이에서 나오므로 컨테이너에서 정합니다.
            -->
            <ListView
                x:Name="FrameStrip"
                Grid.Column="1"
                Padding="4,0"
                AutomationProperties.AutomationId="negaflow.filmstrip.frames"
                ContainerContentChanging="OnFrameContainerChanging"
                ItemContainerStyle="{StaticResource NegaflowFilmstripItemStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                IsItemClickEnabled="True"
                ItemClick="OnFrameItemClick"
                SelectionChanged="OnFrameSelectionChanged"
                SelectionMode="Extended"
                Visibility="Collapsed">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- macOS 는 필름스트립 썸네일에도 격자와 **같은** 메뉴를 답니다. -->
                        <Grid Background="Transparent" RightTapped="OnFrameRightTapped">
                        <!--
                            선택 표시입니다. WinUI 기본은 왼쪽 세로 막대인데 여기서는 위쪽
                            가로 막대입니다. 크기·모양·색은 기본과 같습니다 — 실행 중인 창에서
                            잰 값(배율 1.5): 두께 5px=3, 길이 153px≈102(칸 폭 125 에서 좌우
                            12 씩), 가장자리에서 6px=4, 끝 테이퍼 1px → 반지름 1.5, #007AFF.
                        -->
                        <Rectangle
                            Height="3"
                            Margin="12,4,12,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Fill="{ThemeResource NegaflowAccentBrush}"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid Padding="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Border Background="{ThemeResource NegaflowThumbnailWellBrush}" CornerRadius="5" />
                                <Border
                                    CornerRadius="5"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE91B;"
                                    Visibility="{Binding IsThumbnailPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <TextBlock
                                Grid.Row="2"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,1,0,0"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding FilmType, Converter={StaticResource FilmTypeNameConverter}}"
                                TextTrimming="CharacterEllipsis" />
                            <controls:FrameRatingStars
                                Grid.Row="4"
                                HorizontalAlignment="Left"
                                GlyphSize="10"
                                Rating="{Binding Rating}" />
                        </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                Width="34"
                Margin="8,12"
                Padding="0"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="{ThemeResource NegaflowSubtleFillBrush}"
                BorderThickness="0"
                Click="OnNextClicked"
                CornerRadius="8"
                IsEnabled="False">
                <FontIcon FontSize="13" Glyph="&#xE76C;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
