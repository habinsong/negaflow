<?xml version="1.0" encoding="utf-8"?>
<!--
    macOS Features/Canvas/CanvasToolHUD.swift
    순서: minus.magnifyingglass · plus.magnifyingglass · 퍼센트 · fit · 1.magnifyingglass
    수치는 CanvasToolHudPolicy (HStack 4 · padding 3 · 모서리 10 · 단추 22 · 아이콘 13).
    글리프는 SF Symbols 경로를 베끼지 않고, 스크린샷 현상뷰_기본의 같은 다섯 그림을
    선으로 그린 것입니다.
-->
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Canvas.CanvasToolHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HudContentBrush" Color="#FFF7F7F7" />
        <Style x:Key="CanvasToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
    </UserControl.Resources>
    <Border
        x:Name="Surface"
        Padding="3"
        AutomationProperties.AutomationId="negaflow.canvas.zoom"
        Background="#FF333333"
        BorderBrush="#38F7F7F7"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="ZoomOutButton"
                AutomationProperties.AutomationId="negaflow.canvas.zoom.out"
                Click="OnZoomOutClicked"
                Style="{StaticResource CanvasToolButtonStyle}">
                <Viewbox Width="13" Height="13">
                    <Canvas Width="22" Height="22">
                        <Ellipse
                            Canvas.Left="3.2"
                            Canvas.Top="3.2"
                            Width="11.2"
                            Height="11.2"
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeThickness="1.4" />
                        <Line
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.6"
                            X1="12.6"
                            Y1="12.6"
                            X2="18.2"
                            Y2="18.2" />
                        <Line
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.3"
                            X1="5.6"
                            Y1="8.8"
                            X2="12.0"
                            Y2="8.8" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button
                x:Name="ZoomInButton"
                AutomationProperties.AutomationId="negaflow.canvas.zoom.in"
                Click="OnZoomInClicked"
                Style="{StaticResource CanvasToolButtonStyle}">
                <Viewbox Width="13" Height="13">
                    <Canvas Width="22" Height="22">
                        <Ellipse
                            Canvas.Left="3.2"
                            Canvas.Top="3.2"
                            Width="11.2"
                            Height="11.2"
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeThickness="1.4" />
                        <Line
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.6"
                            X1="12.6"
                            Y1="12.6"
                            X2="18.2"
                            Y2="18.2" />
                        <Line
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.3"
                            X1="5.6"
                            Y1="8.8"
                            X2="12.0"
                            Y2="8.8" />
                        <Line
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.3"
                            X1="8.8"
                            Y1="5.6"
                            X2="8.8"
                            Y2="12.0" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button
                x:Name="ZoomPercentButton"
                AutomationProperties.AutomationId="negaflow.canvas.zoom.percent"
                Width="46"
                Height="22"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="OnZoomPercentClicked"
                CornerRadius="7">
                <Button.Flyout>
                    <Flyout x:Name="ZoomEditorFlyout" Placement="Bottom">
                        <StackPanel
                            Width="176"
                            Padding="12"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBox
                                x:Name="ZoomPercentField"
                                Width="72"
                                FontFamily="Cascadia Mono, Consolas"
                                KeyDown="OnZoomPercentKeyDown" />
                            <TextBlock
                                x:Name="ZoomPercentSuffix"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Text="%" />
                            <Button
                                x:Name="ZoomApplyButton"
                                Click="OnZoomApplyClicked"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <TextBlock
                    x:Name="ZoomPercentText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11"
                    FontWeight="Medium"
                    Foreground="{StaticResource HudContentBrush}" />
            </Button>
            <Button
                x:Name="FitButton"
                AutomationProperties.AutomationId="negaflow.canvas.zoom.fit"
                Click="OnFitClicked"
                Style="{StaticResource CanvasToolButtonStyle}">
                <Viewbox Width="13" Height="13">
                    <Canvas Width="22" Height="22">
                        <Path
                            Data="M 5,9 L 5,5 L 9,5 M 13,5 L 17,5 L 17,9 M 17,13 L 17,17 L 13,17 M 9,17 L 5,17 L 5,13"
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.4" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button
                x:Name="ActualSizeButton"
                AutomationProperties.AutomationId="negaflow.canvas.zoom.actual"
                Click="OnActualSizeClicked"
                Style="{StaticResource CanvasToolButtonStyle}">
                <Viewbox Width="13" Height="13">
                    <Canvas Width="22" Height="22">
                        <Ellipse
                            Canvas.Left="3.2"
                            Canvas.Top="3.2"
                            Width="11.2"
                            Height="11.2"
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeThickness="1.4" />
                        <Line
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.6"
                            X1="12.6"
                            Y1="12.6"
                            X2="18.2"
                            Y2="18.2" />
                        <Path
                            Data="M 8.2,6.4 L 8.2,11.4 M 7.2,6.4 L 9.4,6.4"
                            Stroke="{StaticResource HudContentBrush}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.3" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
