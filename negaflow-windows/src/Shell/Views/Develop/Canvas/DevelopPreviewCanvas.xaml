<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Canvas.DevelopPreviewCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Negaflow.Shell.Views.Develop.Canvas"
    xmlns:grainmend="using:Negaflow.Shell.Views.Develop.GrainMend">
    <!-- 확대한 사진이 위 막대와 왼쪽 패널 위로 뚫고 나가지 않게 잘라 냅니다. WinUI 에는
         ClipToBounds 가 없어 크기가 바뀔 때마다 Clip 사각형을 다시 잡습니다
         (OnCanvasSizeChanged). 이것이 없어서 확대하면 사진이 창 전체를 덮었습니다. -->
    <Grid
        x:Name="CanvasHost"
        x:FieldModifier="internal"
        AutomationProperties.AutomationId="negaflow.canvas"
    IsTabStop="True"
    KeyDown="OnCanvasKeyDown"
    PointerCanceled="OnCanvasPointerCancelled"
    PointerCaptureLost="OnCanvasPointerCaptureLost"
    PointerMoved="OnCanvasPointerMoved"
    PointerPressed="OnCanvasPointerPressed"
    PointerReleased="OnCanvasPointerReleased"
    PointerWheelChanged="OnCanvasPointerWheel"
    SizeChanged="OnCanvasSizeChanged">
    <StackPanel x:Name="EmptyCanvasPanel" x:FieldModifier="internal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <FontIcon FontSize="42" Foreground="#FF8A8A8A" Glyph="&#xE91B;" />
        <TextBlock x:Name="EmptyCanvasTitleLocalized" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#FFE2E2E2" />
        <TextBlock x:Name="EmptyCanvasDescriptionLocalized"
            MaxWidth="420"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            Foreground="#FFA8A8A8"
            TextWrapping="Wrap" />
    </StackPanel>

    <Image
        x:Name="PreviewImage" x:FieldModifier="internal"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        AutomationProperties.AutomationId="negaflow.canvas.preview"
        Stretch="Fill"
        Visibility="Collapsed" />

    <!-- macOS splitVerticalImage / splitHorizontalImage 의 before. after 는 PreviewImage. -->
    <Image
        x:Name="CompareBeforeImage" x:FieldModifier="internal"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        AutomationProperties.AutomationId="negaflow.canvas.compare.before"
        IsHitTestVisible="False"
        Stretch="Fill"
        Visibility="Collapsed" />

    <Canvas
        x:Name="CompareDividerLayer" x:FieldModifier="internal"
        IsHitTestVisible="False"
        Visibility="Collapsed">
        <Rectangle
            x:Name="CompareDividerLine" x:FieldModifier="internal"
            Fill="#BFFFFFFF" />
        <Rectangle
            x:Name="CompareDividerHandle" x:FieldModifier="internal"
            Fill="#E6FFFFFF"
            RadiusX="2"
            RadiusY="2"
            Stroke="#40000000"
            StrokeThickness="1" />
    </Canvas>

    <local:CanvasCompareLabels
        x:Name="CompareLabels"
        x:FieldModifier="internal"
        Visibility="Collapsed" />

    <!-- 픽셀 샘플러의 읽은 값입니다. 설정에서 켰을 때만 나옵니다. -->
    <Border
        x:Name="PixelSamplerPanel" x:FieldModifier="internal"
        Margin="24"
        Padding="10,8"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        AutomationProperties.AutomationId="negaflow.canvas.pixel-sampler"
        Background="#CC101010"
        CornerRadius="9"
        IsHitTestVisible="False"
        Visibility="Collapsed">
        <StackPanel MaxWidth="390" Spacing="5">
            <TextBlock
                x:Name="PixelSamplerCoordinate" x:FieldModifier="internal"
                FontFamily="Consolas"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#FFE6E6E6" />
            <TextBlock
                x:Name="PixelSamplerOriginal" x:FieldModifier="internal"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="#FFCFCFCF" />
            <TextBlock
                x:Name="PixelSamplerDisplayed" x:FieldModifier="internal"
                FontFamily="Consolas"
                FontSize="11"
                Foreground="#FFCFCFCF" />
            <TextBlock
                x:Name="PixelSamplerHint" x:FieldModifier="internal"
                FontSize="11"
                Foreground="#FF9A9A9A"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>

    <!-- 검출 결과 오버레이입니다. 미리보기와 같은 사각형을 차지하도록 같은
         여백과 Stretch 를 씁니다 — 어긋나면 표시가 실제 자리와 달라집니다.
         불투명도는 macOS 와 같이 색마다 정해집니다(예: 성분은 0.35 + 0.5×신뢰도, 브러시 칠은
         0.45). 표면 전체에 한 번 더 곱하면 macOS 보다 흐려지고, 복제 도장이 원 안에 보여 주는
         소스 화소는 불투명해야 하므로 아예 보이지 않습니다. -->
    <Image
        x:Name="DefectOverlayImage" x:FieldModifier="internal"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        AutomationProperties.AutomationId="negaflow.canvas.defect-overlay"
        IsHitTestVisible="False"
        Stretch="Fill"
        Visibility="Collapsed" />

    <!-- macOS `basePickerOverlay` — 스포이드 모드일 때 사진 위에 안내 캡슐을 띄웁니다.
         아이콘 + 문구, 가로 패딩 10 · 세로 5, 모서리 8, 위 12. 클릭은 캔버스가 받습니다. -->
    <Border
        x:Name="BasePickerPrompt" x:FieldModifier="internal"
        Margin="0,12,0,0"
        Padding="10,5"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        AutomationProperties.AutomationId="negaflow.canvas.base-picker.prompt"
        Background="#CC101010"
        CornerRadius="8"
        IsHitTestVisible="False"
        Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="12" Foreground="#FFE6E6E6" Glyph="&#xEF3C;" />
            <TextBlock
                x:Name="BasePickerPromptText" x:FieldModifier="internal"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FFE6E6E6" />
        </StackPanel>
    </Border>

    <!-- macOS `LocalAdjustmentOverlay.promptBar` — 그리는 동안 사진 위에 뜹니다.
         `HStack(spacing: 8) { 종류 아이콘, "사진 위에 그리세요", (다각형이고 꼭짓점 3개 이상이면)
         [다각형 완료], [] }` 에 가로 여백 11 · 세로 6 · 라운딩 9 · 위 12 입니다.
         베이스 스포이드 안내와 달리 단추가 있으므로 클릭을 받습니다. -->
    <Border
        x:Name="LocalAdjustmentPrompt" x:FieldModifier="internal"
        Margin="0,12,0,0"
        Padding="11,6"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        AutomationProperties.AutomationId="negaflow.canvas.local.prompt"
        Background="#CC101010"
        CornerRadius="9"
        Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon
                x:Name="LocalAdjustmentPromptIcon" x:FieldModifier="internal"
                FontSize="12"
                Foreground="#FFE6E6E6"
                Glyph="&#xE790;" />
            <TextBlock
                x:Name="LocalAdjustmentPromptText" x:FieldModifier="internal"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FFE6E6E6" />
            <Button
                x:Name="LocalAdjustmentFinishPolygonButton" x:FieldModifier="internal"
                Height="22"
                Padding="8,0"
                AutomationProperties.AutomationId="negaflow.canvas.local.finish-polygon"
                Click="OnLocalAdjustmentFinishPolygonClicked"
                CornerRadius="6"
                FontSize="11"
                FontWeight="SemiBold"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="LocalAdjustmentCloseButton" x:FieldModifier="internal"
                Width="22"
                Height="22"
                Padding="0"
                AutomationProperties.AutomationId="negaflow.canvas.local.close"
                Background="Transparent"
                BorderThickness="0"
                Click="OnLocalAdjustmentCloseClicked">
                <FontIcon FontSize="10" Foreground="#FFE6E6E6" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Border>

    <Canvas x:Name="GuidedDefectOverlay" x:FieldModifier="internal" IsHitTestVisible="False" Visibility="Collapsed">
        <Rectangle
            x:Name="GuidedDefectSelection" x:FieldModifier="internal"
            AutomationProperties.AutomationId="negaflow.canvas.defect-guided.selection"
            Fill="#12FFD84A"
            Stroke="#E6FFD84A"
            StrokeThickness="1.5" />
    </Canvas>

    <Canvas x:Name="CropOverlay" x:FieldModifier="internal" Visibility="Collapsed">
        <Rectangle x:Name="CropDimTop" x:FieldModifier="internal" Fill="#73000000" />
        <Rectangle x:Name="CropDimBottom" x:FieldModifier="internal" Fill="#73000000" />
        <Rectangle x:Name="CropDimLeft" x:FieldModifier="internal" Fill="#73000000" />
        <Rectangle x:Name="CropDimRight" x:FieldModifier="internal" Fill="#73000000" />
        <Rectangle
            x:Name="CropSelection" x:FieldModifier="internal"
            AutomationProperties.AutomationId="negaflow.canvas.crop.selection"
            Fill="Transparent"
            RadiusX="2"
            RadiusY="2"
            Stroke="White"
            StrokeThickness="1.5" />
        <Line x:Name="CropThirdVerticalFirst" x:FieldModifier="internal" Stroke="#57FFFFFF" StrokeThickness="0.5" />
        <Line x:Name="CropThirdVerticalSecond" x:FieldModifier="internal" Stroke="#57FFFFFF" StrokeThickness="0.5" />
        <Line x:Name="CropThirdHorizontalFirst" x:FieldModifier="internal" Stroke="#57FFFFFF" StrokeThickness="0.5" />
        <Line x:Name="CropThirdHorizontalSecond" x:FieldModifier="internal" Stroke="#57FFFFFF" StrokeThickness="0.5" />
        <Rectangle x:Name="CropHandleTopLeft" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleTop" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleTopRight" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleRight" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleBottomRight" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleBottom" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleBottomLeft" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Rectangle x:Name="CropHandleLeft" x:FieldModifier="internal" Fill="White" RadiusX="2" RadiusY="2" Stroke="#66000000" StrokeThickness="1" />
        <Border
            x:Name="CropActionBar" x:FieldModifier="internal"
            Background="{ThemeResource NegaflowPanelBrush}"
            BorderBrush="{ThemeResource NegaflowDividerBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="CropApplyButton" x:FieldModifier="internal" Click="OnCropApplyClicked" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="CropFullButton" x:FieldModifier="internal" Click="OnCropFullClicked" />
                <Button x:Name="CropCancelButton" x:FieldModifier="internal" Click="OnCropCancelClicked" />
            </StackPanel>
        </Border>
    </Canvas>

    <!-- macOS RegionDefectOverlay 의 캡슐 두 줄입니다. 크롭과 결함 도구는 서로를 끄므로
         가장 위에 두어도 다투지 않습니다. -->
    <grainmend:DevelopGrainMendHud x:Name="GrainMendHud" x:FieldModifier="internal" />

    <!-- macOS CanvasCompareToggle — 기본 위치는 왼쪽 위 margin 12. -->
    <local:CanvasCompareHud
        x:Name="CompareHud"
        x:FieldModifier="internal"
        AutomationProperties.AutomationId="negaflow.canvas.compare-hud"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Visibility="Collapsed"
        SizeChanged="OnCompareHudSizeChanged" />

    <!-- macOS CanvasToolHUD — `resolvedCanvasHUDOrigins` 가 좌표를 잡는다. -->
    <local:CanvasToolHud
        x:Name="ZoomHud"
        x:FieldModifier="internal"
        AutomationProperties.AutomationId="negaflow.canvas.zoom-hud"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        SizeChanged="OnZoomHudSizeChanged" />
</Grid>
</UserControl>
