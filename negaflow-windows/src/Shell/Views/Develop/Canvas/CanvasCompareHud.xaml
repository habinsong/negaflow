<?xml version="1.0" encoding="utf-8"?>
<!--
    macOS Features/Canvas/CanvasCompareControls.swift `CanvasCompareToggle`
    순서: 원본 · 현상본 · 좌우분할 · 상하분할
    수치는 CanvasCompareHudPolicy (HStack 2 · padding 2 · 모서리 10 · 높이 24).
    분할 아이콘은 SF 경로를 베끼지 않고 스크린샷과 같은 반쪽 채움 사각형을 선으로 그림.
-->
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Canvas.CanvasCompareHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CompareContentBrush" Color="#FFF7F7F7" />
        <Style x:Key="CompareTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="CompareIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
    </UserControl.Resources>
    <Border
        x:Name="Surface"
        Padding="2"
        AutomationProperties.AutomationId="negaflow.canvas.compare"
        Background="#FF333333"
        BorderBrush="#38F7F7F7"
        BorderThickness="1"
        CornerRadius="10">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                x:Name="RawButton"
                AutomationProperties.AutomationId="negaflow.canvas.compare.raw"
                Click="OnRawClicked"
                Style="{StaticResource CompareTextButtonStyle}">
                <TextBlock x:Name="RawText" FontSize="12" />
            </Button>
            <Button
                x:Name="DevelopedButton"
                AutomationProperties.AutomationId="negaflow.canvas.compare.developed"
                Click="OnDevelopedClicked"
                Style="{StaticResource CompareTextButtonStyle}">
                <TextBlock x:Name="DevelopedText" FontSize="12" />
            </Button>
            <Button
                x:Name="SplitVerticalButton"
                AutomationProperties.AutomationId="negaflow.canvas.compare.split-vertical"
                Click="OnSplitVerticalClicked"
                Style="{StaticResource CompareIconButtonStyle}">
                <Viewbox Width="12" Height="12">
                    <Canvas Width="16" Height="12">
                        <Rectangle
                            Width="15"
                            Height="11"
                            Canvas.Left="0.5"
                            Canvas.Top="0.5"
                            Stroke="{StaticResource CompareContentBrush}"
                            StrokeThickness="1.1"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                        <Rectangle
                            Width="6.5"
                            Height="10"
                            Canvas.Left="1"
                            Canvas.Top="1"
                            Fill="{StaticResource CompareContentBrush}" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button
                x:Name="SplitHorizontalButton"
                AutomationProperties.AutomationId="negaflow.canvas.compare.split-horizontal"
                Click="OnSplitHorizontalClicked"
                Style="{StaticResource CompareIconButtonStyle}">
                <Viewbox Width="12" Height="12">
                    <Canvas Width="16" Height="12">
                        <Rectangle
                            Width="15"
                            Height="11"
                            Canvas.Left="0.5"
                            Canvas.Top="0.5"
                            Stroke="{StaticResource CompareContentBrush}"
                            StrokeThickness="1.1"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                        <Rectangle
                            Width="14"
                            Height="4.5"
                            Canvas.Left="1"
                            Canvas.Top="1"
                            Fill="{StaticResource CompareContentBrush}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
