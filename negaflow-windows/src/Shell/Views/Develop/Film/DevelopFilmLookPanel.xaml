<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Film.DevelopFilmLookPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">
    <ScrollViewer>
        <StackPanel Padding="12,14" Spacing="12">
            <TextBlock
                x:Name="FilmLookUnavailableText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <StackPanel x:Name="FilmLookControls" Spacing="12" Visibility="Collapsed">
                <controls:InspectorSlider
                    x:Name="FilmLookIntensityControl"
                    HorizontalAlignment="Stretch"
                    Maximum="1"
                    Minimum="0"
                    ResetValue="0.5"
                    SliderAutomationId="negaflow.develop.film.intensity"
                    ValueChanged="OnFilmLookIntensityChanged" />
                <ItemsControl x:Name="FilmLookGroups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="{ThemeResource NegaflowCardBrush}"
                                CornerRadius="10">
                                <StackPanel Spacing="7">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Films}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton
                                                    GroupName="FilmLookSelection"
                                                    Checked="OnFilmLookChecked"
                                                    Content="{Binding Name}"
                                                    FontSize="12"
                                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                    Tag="{Binding Emulation}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
