<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Info.DevelopInfoCards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:info="using:Negaflow.Shell.Views.Develop.Info">
    <StackPanel HorizontalAlignment="Stretch" Spacing="12">
        <info:DevelopInfoCard x:Name="InfoCard" x:FieldModifier="internal" Visibility="Collapsed" />
        <info:DevelopAppMetadataCard x:Name="AppMetadata" x:FieldModifier="internal" Visibility="Collapsed" />
        <info:DevelopFilmShotCard x:Name="FilmShot" x:FieldModifier="internal" Visibility="Collapsed" />
        <info:DevelopRollRecordCard x:Name="RollCard" x:FieldModifier="internal" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
