<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Info.DevelopRollRecordCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 롤 기록: 이 롤의 빈 칸을 채우는 원본입니다. -->
    <Border
        x:Name="Card"
        x:FieldModifier="internal"
        HorizontalAlignment="Stretch"
        Padding="14"
        AutomationProperties.AutomationId="negaflow.develop.roll-record"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <StackPanel HorizontalAlignment="Stretch" Spacing="8">
            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE7C1;" />
                <TextBlock
                    x:Name="TitleText"
                    x:FieldModifier="internal"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="RollNameText"
                    x:FieldModifier="internal"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock
                x:Name="MissingText"
                x:FieldModifier="internal"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <Button
                x:Name="CreateButton"
                x:FieldModifier="internal"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="negaflow.develop.roll-record.create"
                Click="OnCreateClicked"
                Visibility="Collapsed" />
            <StackPanel x:Name="Fields" x:FieldModifier="internal" Spacing="8">
                <TextBox
                    x:Name="CodeBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.roll-record.code"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="CameraMakeBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.roll-record.camera-make"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="CameraModelBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.roll-record.camera-model"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="LensModelBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.roll-record.lens"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="FilmStockBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.roll-record.film"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="NotesBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.roll-record.notes"
                    LostFocus="OnCommitted" />
                <TextBlock
                    x:Name="FillHintText"
                    x:FieldModifier="internal"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
