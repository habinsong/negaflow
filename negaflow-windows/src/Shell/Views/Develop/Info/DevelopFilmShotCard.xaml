<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Info.DevelopFilmShotCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 촬영 기록: 필름 카메라가 남기지 않는 값을 사용자가 적습니다. -->
    <Border
        x:Name="Card"
        x:FieldModifier="internal"
        HorizontalAlignment="Stretch"
        Padding="14"
        AutomationProperties.AutomationId="negaflow.develop.film-shot"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <StackPanel HorizontalAlignment="Stretch" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE722;" />
                <TextBlock
                    x:Name="TitleText"
                    x:FieldModifier="internal"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold" />
            </StackPanel>
            <TextBox
                x:Name="CameraMakeBox"
                x:FieldModifier="internal"
                AutomationProperties.AutomationId="negaflow.develop.film-shot.camera-make"
                LostFocus="OnCommitted" />
            <TextBox
                x:Name="CameraModelBox"
                x:FieldModifier="internal"
                AutomationProperties.AutomationId="negaflow.develop.film-shot.camera-model"
                LostFocus="OnCommitted" />
            <TextBox
                x:Name="LensModelBox"
                x:FieldModifier="internal"
                AutomationProperties.AutomationId="negaflow.develop.film-shot.lens"
                LostFocus="OnCommitted" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FilmStockBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.film-shot.film"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="IsoSpeedBox"
                    x:FieldModifier="internal"
                    Grid.Column="1"
                    MinWidth="86"
                    AutomationProperties.AutomationId="negaflow.develop.film-shot.iso"
                    LostFocus="OnCommitted" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ShutterBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="negaflow.develop.film-shot.shutter"
                    LostFocus="OnCommitted" />
                <TextBox
                    x:Name="ApertureBox"
                    x:FieldModifier="internal"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="negaflow.develop.film-shot.aperture"
                    LostFocus="OnCommitted" />
            </Grid>
            <TextBox
                x:Name="FocalLengthBox"
                x:FieldModifier="internal"
                AutomationProperties.AutomationId="negaflow.develop.film-shot.focal-length"
                LostFocus="OnCommitted" />
        </StackPanel>
    </Border>
</UserControl>
