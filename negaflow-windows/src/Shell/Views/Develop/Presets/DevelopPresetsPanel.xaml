<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Presets.DevelopPresetsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
                    <StackPanel Padding="12,14" Spacing="16">
                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" VerticalAlignment="Center" />
                                <TextBlock x:Name="CopyPasteSectionText" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="CopyDevelopSettingsButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.copy"
                                    Click="OnCopyDevelopSettingsClicked" />
                                <Button
                                    x:Name="PasteDevelopSettingsButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.paste"
                                    Click="OnPasteDevelopSettingsClicked" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PasteScopeLabel" VerticalAlignment="Center" FontSize="12" />
                                <DropDownButton
                                    x:Name="PasteScopeButton"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.scope"
                                    FontSize="11">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                x:Name="PasteScopeAllItem"
                                                AutomationProperties.AutomationId="negaflow.develop.presets.scope.all"
                                                Click="OnPasteScopeAllClicked" />
                                            <MenuFlyoutSeparator />
                                            <ToggleMenuFlyoutItem
                                                x:Name="PasteScopeBaseItem"
                                                AutomationProperties.AutomationId="negaflow.develop.presets.scope.base"
                                                Click="OnPasteScopeToggled"
                                                Tag="Base" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="PasteScopeToneItem"
                                                AutomationProperties.AutomationId="negaflow.develop.presets.scope.tone"
                                                Click="OnPasteScopeToggled"
                                                Tag="Tone" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="PasteScopeColorItem"
                                                AutomationProperties.AutomationId="negaflow.develop.presets.scope.color"
                                                Click="OnPasteScopeToggled"
                                                Tag="Color" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="PasteScopeDetailItem"
                                                AutomationProperties.AutomationId="negaflow.develop.presets.scope.detail"
                                                Click="OnPasteScopeToggled"
                                                Tag="Detail" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="PasteScopeGeometryItem"
                                                AutomationProperties.AutomationId="negaflow.develop.presets.scope.geometry"
                                                Click="OnPasteScopeToggled"
                                                Tag="Geometry" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE9E9;" VerticalAlignment="Center" />
                                <TextBlock x:Name="UserPresetSectionText" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UserPresetLabel" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox
                                    x:Name="UserPresetSelector"
                                    Grid.Column="1"
                                    MinWidth="128"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.user"
                                    SelectionChanged="OnUserPresetSelectionChanged" />
                            </Grid>
                            <!--
                                이름 입력은 저장을 누를 때만 나옵니다. 비워 두고 넘기면 겹치지
                                않는 번호 이름이 붙습니다. Enter 로 저장하고 Esc 로 물러납니다.
                            -->
                            <TextBox
                                x:Name="UserPresetNameBox"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="negaflow.develop.presets.name"
                                KeyDown="OnUserPresetNameKeyDown" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="SaveUserPresetButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.save"
                                    Click="OnSaveUserPresetClicked" />
                                <Button
                                    x:Name="ApplyUserPresetButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.apply"
                                    Click="OnApplyUserPresetClicked" />
                                <Button
                                    x:Name="DeleteUserPresetButton"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="negaflow.develop.presets.delete"
                                    Click="OnDeleteUserPresetClicked" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
    </ScrollViewer>
</UserControl>
