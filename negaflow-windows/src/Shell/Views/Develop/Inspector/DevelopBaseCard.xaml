<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Inspector.DevelopBaseCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">

<!--
    카드가 보이는지는 인스펙터 탭이 정합니다(DevelopInspectorChrome 이 이 UserControl 의
    Visibility 를 켭니다). 이 안쪽 Border 까지 Collapsed 로 두면 탭을 눌러도 빈 자리만
    보이고, 아무도 이것을 다시 켜지 않았습니다 — 베이스 탭이 "눌러도 아무 일도 없다"던
    이유입니다.
-->
<Border
    x:Name="BaseControlCard"
    HorizontalAlignment="Stretch"
    Padding="14"
    Background="{ThemeResource NegaflowCardBrush}"
    CornerRadius="14">
    <StackPanel HorizontalAlignment="Stretch" Spacing="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- macOS `circle.lefthalf.filled` — 왼쪽 절반만 채운 원입니다. Segoe MDL2 에는
                 같은 그림이 없어(E706 은 밝기 아이콘) 직접 그립니다. 바깥 원 지름 14,
                 왼쪽 반원을 채웁니다. -->
            <Viewbox Grid.Column="0" Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                        StrokeThickness="1.3" />
                    <Path
                        Data="M 8,1 A 7,7 0 0 0 8,15 Z"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Viewbox>
            <TextBlock x:Name="BaseSectionTitleText" Grid.Column="1" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" />
            <TextBlock
                x:Name="ManualBaseValueText"
                Grid.Column="2"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <!-- macOS `SegmentedPicker` — 자동/필름/수동이 **붙어 있는 한 덩어리**입니다.
             라디오 3개를 간격 4로 떼어 놓으면 모양이 다릅니다. 테두리 한 겹 안에 칸을
             나누고 선택된 칸만 바탕을 칠합니다. -->
        <Border
            x:Name="BaseModeControl"
            AutomationProperties.AutomationId="negaflow.develop.base"
            AutomationProperties.Name="Film base mode"
            BorderBrush="{ThemeResource NegaflowDividerBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Padding="1">
            <Grid ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    x:Name="BaseAutoModeButton"
                    Grid.Column="0"
                    Style="{StaticResource NegaflowSegmentStyle}"
                    AutomationProperties.AutomationId="negaflow.develop.base.mode.auto"
                    GroupName="BaseEstimationMode"
                    Checked="OnBaseAutoModeChecked" />
                <RadioButton
                    x:Name="BaseFilmModeButton"
                    Grid.Column="1"
                    Style="{StaticResource NegaflowSegmentStyle}"
                    AutomationProperties.AutomationId="negaflow.develop.base.mode.film"
                    GroupName="BaseEstimationMode"
                    Checked="OnBaseFilmModeChecked" />
                <RadioButton
                    x:Name="BaseManualModeButton"
                    Grid.Column="2"
                    Style="{StaticResource NegaflowSegmentStyle}"
                    AutomationProperties.AutomationId="negaflow.develop.base.mode.manual"
                    GroupName="BaseEstimationMode"
                    Checked="OnBaseManualModeChecked" />
            </Grid>
        </Border>
        <!-- macOS `basePresetPickerRow`: 라벨 폭 86, 피커 maxWidth 276, 줄 간격 12, 최소 높이 26. -->
        <StackPanel x:Name="FilmBaseControls" Spacing="8">
            <Grid MinHeight="26" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FilmStockLabel" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ComboBox
                    x:Name="FilmStockSelector"
                    Grid.Column="1"
                    MinHeight="24"
                    MaxWidth="276"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.base.film-stock"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnFilmStockSelectionChanged" />
            </Grid>
            <Grid MinHeight="26" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LightSourceLabel" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ComboBox
                    x:Name="LightSourceSelector"
                    Grid.Column="1"
                    MinHeight="24"
                    MaxWidth="276"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.base.light-source"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnLightSourceSelectionChanged" />
            </Grid>
            <Grid MinHeight="26" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ScannerProfileLabel" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ComboBox
                    x:Name="ScannerProfileSelector"
                    Grid.Column="1"
                    MinHeight="24"
                    MaxWidth="276"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.base.scanner-profile"
                    DisplayMemberPath="Label"
                    SelectionChanged="OnScannerProfileSelectionChanged" />
            </Grid>
        </StackPanel>
        <!-- macOS `InspectorActionPill(pickBase)` — 스포이드 토글과 초기화가 한 캡슐입니다.
             본문 최소 높이 31, 왼쪽 여백 7, 초기화 원 23×23, 오른쪽 여백 3, 캡슐 테두리.
             켜져 있으면 강조색 0.18 바탕에 0.45 테두리, 꺼져 있으면 0.06/0.12 입니다. -->
        <Border
            x:Name="BasePickerPill"
            HorizontalAlignment="Stretch"
            BorderThickness="1"
            CornerRadius="16">
            <Grid ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BasePickerButton"
                    Grid.Column="0"
                    MinHeight="31"
                    Padding="7,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="negaflow.develop.base.pick"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBasePickerToggled"
                    CornerRadius="12">
                    <TextBlock x:Name="BasePickerText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button
                    x:Name="BasePickerResetButton"
                    Grid.Column="1"
                    Width="23"
                    Height="23"
                    Margin="0,0,3,0"
                    Padding="0"
                    AutomationProperties.AutomationId="negaflow.develop.base.pick.reset"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBasePickerResetClicked"
                    CornerRadius="12">
                    <FontIcon FontSize="11" Glyph="&#xE10E;" />
                </Button>
            </Grid>
        </Border>
        <!-- 범위는 macOS 와 같은 0…1 입니다(코드에서 설정). -->
        <StackPanel x:Name="ManualBaseControls" Spacing="10">
            <controls:InspectorSlider
                x:Name="BaseRedControl"
                CanReset="False"
                SliderAutomationId="negaflow.develop.base.red"
                ValueChanged="OnManualBaseChanged" />
            <controls:InspectorSlider
                x:Name="BaseGreenControl"
                CanReset="False"
                SliderAutomationId="negaflow.develop.base.green"
                ValueChanged="OnManualBaseChanged" />
            <controls:InspectorSlider
                x:Name="BaseBlueControl"
                CanReset="False"
                SliderAutomationId="negaflow.develop.base.blue"
                ValueChanged="OnManualBaseChanged" />
        </StackPanel>
    </StackPanel>
</Border>
</UserControl>
