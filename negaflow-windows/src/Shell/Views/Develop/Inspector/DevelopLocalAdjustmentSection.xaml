<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Inspector.DevelopLocalAdjustmentSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">
    <!-- macOS `LocalAdjustmentSection` — `InspectorCard { VStack(spacing: 9) {
             InspectorCardHeader; maskPicker; modePicker; newMaskControls; adjustmentList } }`
         (스크린샷 `현상뷰_우측탭_아이콘6탭바_편집.png`). -->
    <Border
        x:Name="LocalAdjustmentCard"
        HorizontalAlignment="Stretch"
        Padding="14"
        AutomationProperties.AutomationId="negaflow.develop.section.local"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <StackPanel HorizontalAlignment="Stretch" Spacing="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:VectorIcon
                    Grid.Column="0"
                    Width="20"
                    IconSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Kind="HalfCircleStriped" />
                <TextBlock
                    x:Name="LocalSectionTitleText" x:FieldModifier="internal"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold" />
            </Grid>

            <!-- macOS `maskPicker` — `HStack(spacing: 5)` 에 네 종류가 폭을 똑같이 나눠 갖고,
                 그리는 중인 종류만 강조색 18% 바탕에 라운딩 6 입니다. -->
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="LocalBrushButton" x:FieldModifier="internal"
                    Grid.Column="0"
                    Padding="0,5"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.local.mask.brush"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnMaskKindClicked"
                    CornerRadius="6"
                    Tag="Brush">
                    <controls:VectorIcon IconSize="14" Kind="Paintbrush" />
                </Button>
                <Button
                    x:Name="LocalRadialButton" x:FieldModifier="internal"
                    Grid.Column="1"
                    Padding="0,5"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.local.mask.radial"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnMaskKindClicked"
                    CornerRadius="6"
                    Tag="Radial">
                    <controls:VectorIcon IconSize="14" Kind="RadialMask" />
                </Button>
                <Button
                    x:Name="LocalLinearButton" x:FieldModifier="internal"
                    Grid.Column="2"
                    Padding="0,5"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.local.mask.linear"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnMaskKindClicked"
                    CornerRadius="6"
                    Tag="Linear">
                    <controls:VectorIcon IconSize="14" Kind="LinearMask" />
                </Button>
                <Button
                    x:Name="LocalPolygonButton" x:FieldModifier="internal"
                    Grid.Column="3"
                    Padding="0,5"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.local.mask.polygon"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnMaskKindClicked"
                    CornerRadius="6"
                    Tag="Polygon">
                    <controls:VectorIcon IconSize="14" Kind="PolygonMask" />
                </Button>
            </Grid>

            <!-- macOS `modePicker` — `HStack(spacing: 0) { 닷지, 1pt 구분선, 번 }` 에 여백 2 ·
                 라운딩 16. 고른 칸은 강조색 18% · 라운딩 12 · 높이 24 입니다. -->
            <Border
                Padding="2"
                Background="{ThemeResource NegaflowSubtleFillBrush}"
                CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="LocalDodgeButton" x:FieldModifier="internal"
                        Grid.Column="0"
                        Height="24"
                        Padding="6,0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="negaflow.develop.local.mode.dodge"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnModeClicked"
                        CornerRadius="12"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Tag="Dodge" />
                    <Border
                        Grid.Column="1"
                        Width="1"
                        Height="16"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource NegaflowDividerBrush}" />
                    <Button
                        x:Name="LocalBurnButton" x:FieldModifier="internal"
                        Grid.Column="2"
                        Height="24"
                        Padding="6,0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="negaflow.develop.local.mode.burn"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnModeClicked"
                        CornerRadius="12"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Tag="Burn" />
                </Grid>
            </Border>

            <!-- macOS `newMaskControls` — `VStack(spacing: 6)` 에 양·페더, 브러시일 때만 크기.
                 줄은 `HStack(spacing: 8) { 이름(width 52), Slider, 값(width 28, trailing) }`. -->
            <StackPanel x:Name="LocalNewMaskControls" x:FieldModifier="internal" Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LocalAmountLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                    <Slider
                        x:Name="LocalAmountSlider" x:FieldModifier="internal"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="negaflow.develop.local.amount"
                        Maximum="1"
                        Minimum="0"
                        StepFrequency="0.01"
                        ThumbToolTipValueConverter="{x:Null}"
                        ValueChanged="OnAmountChanged" />
                    <TextBlock
                        x:Name="LocalAmountValue" x:FieldModifier="internal"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        TextAlignment="Right" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LocalFeatherLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                    <Slider
                        x:Name="LocalFeatherSlider" x:FieldModifier="internal"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="negaflow.develop.local.feather"
                        Maximum="1"
                        Minimum="0"
                        StepFrequency="0.01"
                        ThumbToolTipValueConverter="{x:Null}"
                        ValueChanged="OnFeatherChanged" />
                    <TextBlock
                        x:Name="LocalFeatherValue" x:FieldModifier="internal"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        TextAlignment="Right" />
                </Grid>
                <!-- macOS 는 브러시일 때만 크기 줄을 냅니다. -->
                <Grid x:Name="LocalSizeRow" x:FieldModifier="internal" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LocalSizeLabel" x:FieldModifier="internal" VerticalAlignment="Center" FontSize="12" />
                    <Slider
                        x:Name="LocalSizeSlider" x:FieldModifier="internal"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="negaflow.develop.local.size"
                        Maximum="0.25"
                        StepFrequency="0.005"
                        ThumbToolTipValueConverter="{x:Null}"
                        ValueChanged="OnSizeChanged" />
                    <TextBlock
                        x:Name="LocalSizeValue" x:FieldModifier="internal"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- macOS `adjustmentList` — 비어 있으면 안내 한 줄, 아니면 구분선 뒤에 줄 목록. -->
            <TextBlock
                x:Name="LocalEmptyText" x:FieldModifier="internal"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border
                x:Name="LocalListDivider" x:FieldModifier="internal"
                Height="1"
                Background="{ThemeResource NegaflowDividerBrush}"
                Visibility="Collapsed" />
            <StackPanel x:Name="LocalAdjustmentList" x:FieldModifier="internal" Spacing="6" />
        </StackPanel>
    </Border>
</UserControl>
