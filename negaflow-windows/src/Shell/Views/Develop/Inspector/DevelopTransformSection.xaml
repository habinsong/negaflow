<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Inspector.DevelopTransformSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">

    <!-- macOS `TransformSection` — 모드 캡슐 두 줄, 슬라이더 일곱 개, 자르기 제한. -->
    <Border
        x:Name="TransformSectionBorder"
        HorizontalAlignment="Stretch"
        Padding="14"
        AutomationProperties.AutomationId="negaflow.develop.section.transform"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <StackPanel HorizontalAlignment="Stretch" Spacing="12">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:DisclosureButton
                    x:Name="TransformHeaderButton"
                    Grid.Column="0"
                    MinHeight="26"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.section.transform.header"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnInspectorSectionHeaderClicked"
                    ExpansionRequested="OnInspectorSectionExpansionRequested"
                    Tag="Transform">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:VectorIcon Grid.Column="0" Width="20" IconSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Kind="Crop" />
                        <TextBlock x:Name="TransformSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        <FontIcon x:Name="TransformChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                    </Grid>
                </controls:DisclosureButton>
                <Button
                    x:Name="TransformResetButton"
                    Grid.Column="1"
                    Width="30"
                    Height="26"
                    Margin="6,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Click="OnTransformResetClicked">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                </Button>
            </Grid>
            <StackPanel x:Name="TransformControls" HorizontalAlignment="Stretch" Spacing="10" Visibility="Collapsed">
                <!-- 컬러 그레이딩의 어두운 영역·중간 톤·밝은 영역과 같은 캡슐을 두 줄로 둡니다. 두 줄이
                     한 묶음(GroupName)이라 하나만 고릅니다. -->
                <StackPanel Spacing="6">
                    <Border Style="{StaticResource NegaflowCapsuleSegmentTrackStyle}">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="ModeOffButton" Grid.Column="0" Style="{StaticResource NegaflowCapsuleSegmentStyle}" GroupName="TransformMode" Checked="OnModeChecked" Tag="Off" />
                            <RadioButton x:Name="ModeAutoButton" Grid.Column="1" Style="{StaticResource NegaflowCapsuleSegmentStyle}" GroupName="TransformMode" Checked="OnModeChecked" Tag="Auto" />
                            <RadioButton x:Name="ModeGuidedButton" Grid.Column="2" Style="{StaticResource NegaflowCapsuleSegmentStyle}" GroupName="TransformMode" Checked="OnModeChecked" Tag="Guided" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource NegaflowCapsuleSegmentTrackStyle}">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="ModeLevelButton" Grid.Column="0" Style="{StaticResource NegaflowCapsuleSegmentStyle}" GroupName="TransformMode" Checked="OnModeChecked" Tag="Level" />
                            <RadioButton x:Name="ModeVerticalButton" Grid.Column="1" Style="{StaticResource NegaflowCapsuleSegmentStyle}" GroupName="TransformMode" Checked="OnModeChecked" Tag="Vertical" />
                            <RadioButton x:Name="ModeFullButton" Grid.Column="2" Style="{StaticResource NegaflowCapsuleSegmentStyle}" GroupName="TransformMode" Checked="OnModeChecked" Tag="Full" />
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="GuidedHintText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Button x:Name="ClearGuidesButton" HorizontalAlignment="Left" FontSize="12" Click="OnClearGuidesClicked" Visibility="Collapsed" />
                <Border Height="1" HorizontalAlignment="Stretch" Opacity="0.4" Background="{ThemeResource NegaflowDividerBrush}" />
                <controls:InspectorSlider x:Name="VerticalControl" HorizontalAlignment="Stretch" Minimum="-100" Maximum="100" ResetValue="0" DisplayFormat="+0;-0;0" SliderAutomationId="negaflow.develop.transform.vertical" ValueChanged="OnSliderChanged" />
                <controls:InspectorSlider x:Name="HorizontalControl" HorizontalAlignment="Stretch" Minimum="-100" Maximum="100" ResetValue="0" DisplayFormat="+0;-0;0" SliderAutomationId="negaflow.develop.transform.horizontal" ValueChanged="OnSliderChanged" />
                <controls:InspectorSlider x:Name="RotateControl" HorizontalAlignment="Stretch" Minimum="-10" Maximum="10" ResetValue="0" DisplayFormat="+0.0;-0.0;0.0" SliderAutomationId="negaflow.develop.transform.rotate" ValueChanged="OnSliderChanged" />
                <controls:InspectorSlider x:Name="AspectControl" HorizontalAlignment="Stretch" Minimum="-100" Maximum="100" ResetValue="0" DisplayFormat="+0;-0;0" SliderAutomationId="negaflow.develop.transform.aspect" ValueChanged="OnSliderChanged" />
                <controls:InspectorSlider x:Name="ScaleControl" HorizontalAlignment="Stretch" Minimum="50" Maximum="150" ResetValue="100" Value="100" DisplayFormat="0" SliderAutomationId="negaflow.develop.transform.scale" ValueChanged="OnSliderChanged" />
                <controls:InspectorSlider x:Name="OffsetXControl" HorizontalAlignment="Stretch" Minimum="-100" Maximum="100" ResetValue="0" DisplayFormat="+0.0;-0.0;0.0" SliderAutomationId="negaflow.develop.transform.offset-x" ValueChanged="OnSliderChanged" />
                <controls:InspectorSlider x:Name="OffsetYControl" HorizontalAlignment="Stretch" Minimum="-100" Maximum="100" ResetValue="0" DisplayFormat="+0.0;-0.0;0.0" SliderAutomationId="negaflow.develop.transform.offset-y" ValueChanged="OnSliderChanged" />
                <CheckBox x:Name="ConstrainCropCheck" FontSize="12" Checked="OnConstrainCropChanged" Unchecked="OnConstrainCropChanged" AutomationProperties.AutomationId="negaflow.develop.transform.constrain-crop" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
