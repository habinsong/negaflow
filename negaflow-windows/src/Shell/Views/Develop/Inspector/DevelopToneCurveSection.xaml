<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Inspector.DevelopToneCurveSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">

    <Border
        x:Name="ToneCurveSection"
        HorizontalAlignment="Stretch"
        Padding="14"
        AutomationProperties.AutomationId="negaflow.develop.section.tone-curve"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <StackPanel HorizontalAlignment="Stretch" Spacing="12">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:DisclosureButton
                    x:Name="ToneCurveHeaderButton"
                    Grid.Column="0"
                    MinHeight="26"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.section.tone-curve.header"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnInspectorSectionHeaderClicked"
                    ExpansionRequested="OnInspectorSectionExpansionRequested"
                    Tag="ToneCurve">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:VectorIcon Grid.Column="0" Width="20" IconSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Kind="ToneCurve" />
                        <TextBlock x:Name="ToneCurveSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        <FontIcon x:Name="ToneCurveChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE76C;" />
                    </Grid>
                </controls:DisclosureButton>
                <Button x:Name="ToneCurveResetButton" Grid.Column="1" Width="30" Height="26" Margin="6,0,0,0" Padding="0" Click="OnToneCurveResetClicked">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                </Button>
            </Grid>
            <StackPanel x:Name="ToneCurveControls" HorizontalAlignment="Stretch" Spacing="10" Visibility="Collapsed">
                <controls:InspectorSlider x:Name="CurveHighlightsControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.curve.highlights" ValueChanged="OnToneCurveChanged" />
                <controls:InspectorSlider x:Name="CurveLightsControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.curve.lights" ValueChanged="OnToneCurveChanged" />
                <controls:InspectorSlider x:Name="CurveDarksControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.curve.darks" ValueChanged="OnToneCurveChanged" />
                <controls:InspectorSlider x:Name="CurveShadowsControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.curve.shadows" ValueChanged="OnToneCurveChanged" />
                <Border Height="2" HorizontalAlignment="Stretch" Background="{ThemeResource NegaflowDividerBrush}" />
                <controls:ToneCurveEditor x:Name="PointCurveEditor" HorizontalAlignment="Stretch" CurvesChanged="OnPointCurvesChanged" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
