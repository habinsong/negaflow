<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Inspector.DevelopToneSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">

    <Border
        x:Name="BasicToneSection"
        HorizontalAlignment="Stretch"
        Padding="14"
        AutomationProperties.AutomationId="negaflow.develop.section.tone"
        Background="{ThemeResource NegaflowCardBrush}"
        CornerRadius="14">
        <StackPanel HorizontalAlignment="Stretch" Spacing="12">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:DisclosureButton
                    x:Name="BasicToneHeaderButton"
                    Grid.Column="0"
                    MinHeight="26"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="negaflow.develop.section.tone.header"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnInspectorSectionHeaderClicked"
                    ExpansionRequested="OnInspectorSectionExpansionRequested"
                    Tag="Tone">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Width="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9E9;" />
                        <TextBlock x:Name="BasicToneSectionTitleText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        <FontIcon x:Name="BasicToneChevron" Grid.Column="2" Margin="8,0,0,0" FontSize="12" Glyph="&#xE70D;" />
                    </Grid>
                </controls:DisclosureButton>
                <Button
                    x:Name="BasicToneResetButton"
                    Grid.Column="1"
                    Width="30"
                    Height="26"
                    Margin="6,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="OnBasicToneResetClicked"
                    CornerRadius="0"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                </Button>
            </Grid>
            <!-- Minimum/Maximum 은 엔진이 알려 준 값으로 코드에서 설정한다. -->
            <StackPanel
                x:Name="BasicToneControls"
                HorizontalAlignment="Stretch"
                Spacing="10"
                TabFocusNavigation="Cycle">
                <controls:InspectorSlider x:Name="ExposureControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.exposure" ValueChanged="OnExposureChanged" />
                <controls:InspectorSlider x:Name="ContrastControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.contrast" ValueChanged="OnBasicToneChanged" />
                <controls:InspectorSlider x:Name="HighlightsControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.highlights" ValueChanged="OnBasicToneChanged" />
                <controls:InspectorSlider x:Name="ShadowsControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.shadows" ValueChanged="OnBasicToneChanged" />
                <controls:InspectorSlider x:Name="WhitesControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.whites" ValueChanged="OnBasicToneChanged" />
                <controls:InspectorSlider x:Name="BlacksControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.blacks" ValueChanged="OnBasicToneChanged" />
                <controls:InspectorSlider x:Name="DensityControl" HorizontalAlignment="Stretch" ResetValue="0" SliderAutomationId="negaflow.develop.density" ValueChanged="OnBasicToneChanged" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
