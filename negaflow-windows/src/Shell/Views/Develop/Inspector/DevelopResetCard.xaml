<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Inspector.DevelopResetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<!--
    macOS ResetControlsSection — InspectorCard 안에 머리줄(arrow.counterclockwise.circle)과
    단추 둘입니다. 사이 간격 8, 단추는 controlSize .large 에 maxWidth .infinity 입니다.
    첫 단추는 role: .destructive 라 글자가 빨간 계열입니다.
-->
<Border
    x:Name="ResetControlCard"
    HorizontalAlignment="Stretch"
    Padding="14"
    AutomationProperties.AutomationId="negaflow.develop.reset"
    Background="{ThemeResource NegaflowCardBrush}"
    CornerRadius="14">
    <StackPanel HorizontalAlignment="Stretch" Spacing="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Width="20"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE777;" />
            <TextBlock
                x:Name="ResetSectionTitleText"
                Grid.Column="1"
                Margin="8,0,0,0"
                FontSize="14"
                FontWeight="SemiBold" />
        </Grid>
        <StackPanel Spacing="8">
            <Button
                x:Name="ResetAllAdjustmentsButton"
                MinHeight="36"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.AutomationId="negaflow.develop.reset.adjustments"
                Click="OnResetAllAdjustmentsClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE71C;" />
                    <TextBlock
                        x:Name="ResetAllAdjustmentsText"
                        FontSize="13"
                        FontWeight="Medium" />
                </StackPanel>
            </Button>
            <Button
                x:Name="ResetPhotoAngleButton"
                MinHeight="36"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.AutomationId="negaflow.develop.reset.photo-angle"
                Click="OnResetPhotoAngleClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7AD;" />
                    <TextBlock
                        x:Name="ResetPhotoAngleText"
                        FontSize="13"
                        FontWeight="Medium" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Border>
</UserControl>
