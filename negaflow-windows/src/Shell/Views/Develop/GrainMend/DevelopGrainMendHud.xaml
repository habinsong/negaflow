<?xml version="1.0" encoding="utf-8"?>
<!--
    macOS Features/Defects/RegionDefectOverlay.swift 의 캡슐 두 줄입니다. 위 가운데가 컨트롤
    바(검출 상태·민감도·미세 입자·취소·결함 제거), 아래 가운데가 종류별 칩입니다. 오른쪽 카드가
    아니라 사진 위에 있어야 검출 결과를 보면서 손이 사진을 떠나지 않습니다.

    글리프는 Segoe Fluent 에서 뜻이 같은 것을 고른 것입니다 — scope 는 GrainMend 카드 머리와
    같은 E7A8, bandage 는 GrainMend 레이어 카드 머리와 같은 E90F, slider.horizontal.3 은
    프리셋 레일과 같은 E9E9 입니다.
-->
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.GrainMend.DevelopGrainMendHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls">
    <UserControl.Resources>
        <!-- macOS .buttonStyle(.plain) 아이콘 단추 -->
        <Style x:Key="NegaflowHudGlyphButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!--
            macOS DefectClassChip: 배경은 중성, 색은 점에만.
            모서리는 알약처럼 **직사각형에 모서리만 둥글게** 입니다. 999 를 넣으면 짧은 변의
            절반으로 잘려 찌그러진 타원이 됩니다 — 앱의 다른 캡슐(도구 알약 16, 카드 14)과
            같은 값을 씁니다.
        -->
        <Style x:Key="NegaflowHudChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource NegaflowSubtleFillBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NegaflowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>
        <DataTemplate x:Key="GrainMendClassChipTemplate">
            <Button
                AutomationProperties.Name="{Binding AutomationName}"
                Click="OnChipClicked"
                Style="{StaticResource NegaflowHudChipStyle}"
                Tag="{Binding Classification}"
                ToolTipService.ToolTip="{Binding Name}">
                <!-- macOS HStack(spacing: 5) -->
                <StackPanel
                    Orientation="Horizontal"
                    Opacity="{Binding Opacity}"
                    Spacing="5">
                    <Ellipse
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{Binding Dot}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Medium"
                        Text="{Binding Name}"
                        TextDecorations="{Binding NameDecorations}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding CountText}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ConfidenceText}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 캡슐이 없는 자리는 그대로 캔버스입니다 — 배경을 칠하면 드래그가 막힙니다. -->
    <Grid x:Name="HudRoot" Visibility="Collapsed">
        <!-- macOS: VStack { controlBar; Spacer; classChipsBar }.padding(.vertical, 12) -->
        <Border
            x:Name="ControlCapsule"
            Margin="0,12,0,0"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="negaflow.canvas.grainmend.capsule"
            Background="{ThemeResource NegaflowPanelBrush}"
            BorderBrush="{ThemeResource NegaflowDividerBrush}"
            BorderThickness="1"
            CornerRadius="18">
            <!-- macOS HStack(spacing: 10) -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- macOS Image(systemName: "scope").foregroundStyle(.red) -->
                <controls:VectorIcon
                    VerticalAlignment="Center"
                    IconSize="14"
                    Foreground="#FFFF3B30"
                    Kind="Scope" />
                <ProgressRing
                    x:Name="DetectingRing"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.status"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border
                    x:Name="FirstDivider"
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}"
                    Visibility="Collapsed" />
                <!-- macOS HStack(spacing: 6) { slider.horizontal.3, Slider(width: 110) } -->
                <StackPanel
                    x:Name="SensitivityGroup"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE9E9;" />
                    <Slider
                        x:Name="SensitivitySlider"
                        Width="110"
                        VerticalAlignment="Center"
                        Minimum="0.7"
                        Maximum="6"
                        StepFrequency="0.1"
                        SmallChange="0.1"
                        LargeChange="0.5"
                        AutomationProperties.AutomationId="negaflow.canvas.grainmend.sensitivity"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="OnSensitivityValueChanged"
                        PointerCaptureLost="OnSensitivityCommitted"
                        KeyUp="OnSensitivityKeyUp" />
                </StackPanel>
                <!-- macOS Toggle(...).toggleStyle(.checkbox).font(.caption) -->
                <CheckBox
                    x:Name="MicroSpecksCheck"
                    VerticalAlignment="Center"
                    MinWidth="0"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.micro-specks"
                    Checked="OnMicroSpecksToggled"
                    Unchecked="OnMicroSpecksToggled">
                    <TextBlock x:Name="MicroSpecksText" FontSize="12" />
                </CheckBox>
                <Border
                    x:Name="SecondDivider"
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}"
                    Visibility="Collapsed" />
                <!--
                    macOS RegionDefectOverlay 의 대기 상태 되돌리기입니다:
                    `if frame.canUndoDefects { Divider(); Button { Label(undo, "arrow.uturn.backward") } }`.
                    브러시·복제 되돌리기와 같은 E7A7 글리프이고, 마지막 결함 편집 한 칸을
                    되돌립니다(도구가 무엇이었든 히스토리를 공유합니다).
                -->
                <Border
                    x:Name="RegionUndoDivider"
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="RegionUndoButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.undo"
                    Click="OnRegionUndoClicked"
                    Style="{StaticResource NegaflowHudGlyphButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon FontSize="12" Glyph="&#xE7A7;" />
                </Button>
                <!-- macOS Button { Image(systemName: "xmark") } -->
                <Button
                    x:Name="CancelButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.cancel"
                    Click="OnCancelClicked"
                    Style="{StaticResource NegaflowHudGlyphButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
                <!-- macOS Button { Label(removeDefects, systemImage: "bandage") }.buttonStyle(.borderedProminent) -->
                <Button
                    x:Name="RemoveButton"
                    VerticalAlignment="Center"
                    MinHeight="28"
                    Padding="10,3"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.remove"
                    Click="OnRemoveClicked"
                    CornerRadius="14"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:VectorIcon
                            x:Name="RemoveIcon"
                            VerticalAlignment="Center"
                            IconSize="12"
                            Visibility="Visible"
                            Kind="Bandage" />
                        <TextBlock
                            x:Name="RemoveText"
                            VerticalAlignment="Center"
                            FontSize="12" />
                        <ProgressRing
                            x:Name="RemovingRing"
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!--
            macOS Features/Defects/Brush/BrushControlBar.swift — 브러시 도구를 켜면 검출
            캡슐 대신 이것이 위 가운데에 섭니다(CanvasHUDLayer 도 .padding(.top, 12)).
            글리프: 브러시는 결함 탭 머리와 같은 E771, 굵기는 민감도 슬라이더와 같은 E9E9,
            되돌리기 E7A7, 지우기 E74D, 초기화(eraser) E75C, 제거(bandage) E90F.
        -->
        <Border
            x:Name="BrushCapsule"
            Margin="0,12,0,0"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="negaflow.canvas.grainmend.brush-bar"
            Background="{ThemeResource NegaflowPanelBrush}"
            BorderBrush="{ThemeResource NegaflowDividerBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="Collapsed">
            <!-- macOS HStack(spacing: 10) -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- macOS Image(systemName: "paintbrush.pointed.fill").foregroundStyle(.red) -->
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#FFFF3B30"
                    Glyph="&#xE771;" />
                <!-- macOS HStack(spacing: 6) { lineweight, Slider(0.004...0.06, width: 110) } -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE9E9;" />
                    <Slider
                        x:Name="BrushThicknessSlider"
                        Width="110"
                        VerticalAlignment="Center"
                        Minimum="0.004"
                        Maximum="0.06"
                        StepFrequency="0.001"
                        SmallChange="0.001"
                        LargeChange="0.005"
                        AutomationProperties.AutomationId="negaflow.canvas.grainmend.brush-thickness"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="OnBrushThicknessChanged" />
                </StackPanel>
                <Border
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}" />
                <!-- macOS Button { Image(systemName: "arrow.uturn.backward") } -->
                <Button
                    x:Name="BrushUndoButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.brush-undo"
                    Click="OnBrushUndoClicked"
                    Style="{StaticResource NegaflowHudGlyphButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE7A7;" />
                </Button>
                <!-- macOS Button { Image(systemName: "trash") } -->
                <Button
                    x:Name="BrushClearButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.brush-clear"
                    Click="OnBrushClearClicked"
                    Style="{StaticResource NegaflowHudGlyphButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                </Button>
                <!-- macOS Button { Image(systemName: "eraser.fill") } — 적용된 것을 되돌립니다 -->
                <Button
                    x:Name="BrushResetButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.brush-reset"
                    Click="OnBrushResetClicked"
                    Style="{StaticResource NegaflowHudGlyphButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE75C;" />
                </Button>
                <!-- macOS Button { Label(removeDefects, systemImage: "bandage") }.buttonStyle(.borderedProminent) -->
                <Button
                    x:Name="BrushApplyButton"
                    VerticalAlignment="Center"
                    MinHeight="28"
                    Padding="10,3"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.brush-apply"
                    Click="OnBrushApplyClicked"
                    CornerRadius="14"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:VectorIcon VerticalAlignment="Center" IconSize="12" Kind="Bandage" />
                        <TextBlock
                            x:Name="BrushApplyText"
                            VerticalAlignment="Center"
                            FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!--
            macOS Features/Defects/CloneStamp/CloneStampOverlay.swift 의 controlBar 입니다.
            소스를 지정하기 전에는 안내와 구분선이 먼저 서고, 그 뒤에 크기(4~512px)·경도(0~1)
            슬라이더와 되돌리기가 옵니다. 위치도 같습니다(.padding(.top, 12)).
            글리프: rectangle.on.rectangle 은 겹친 사각형 E7C4, 되돌리기 E7A7.
        -->
        <Border
            x:Name="CloneCapsule"
            Margin="0,12,0,0"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="negaflow.canvas.grainmend.clone-bar"
            Background="{ThemeResource NegaflowPanelBrush}"
            BorderBrush="{ThemeResource NegaflowDividerBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="Collapsed">
            <!-- macOS HStack(spacing: 10) -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <controls:VectorIcon
                    VerticalAlignment="Center"
                    IconSize="14"
                    Foreground="#FFFF3B30"
                    Kind="CloneStamp" />
                <!-- macOS: sourceBase == nil 일 때만 안내 + 구분선 -->
                <TextBlock
                    x:Name="CloneSourceHint"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border
                    x:Name="CloneHintDivider"
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}" />
                <!-- macOS HStack(spacing: 6) { 크기, Slider(4...512, width: 96), "Npx"(width 42) } -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CloneSizeLabel"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider
                        x:Name="CloneSizeSlider"
                        Width="96"
                        VerticalAlignment="Center"
                        Maximum="512"
                        StepFrequency="1"
                        SmallChange="1"
                        LargeChange="8"
                        AutomationProperties.AutomationId="negaflow.canvas.grainmend.clone-size"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="OnCloneSizeChanged" />
                    <TextBlock
                        x:Name="CloneSizeValue"
                        Width="42"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Right" />
                </StackPanel>
                <Border
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}" />
                <!-- macOS HStack(spacing: 6) { 경도, Slider(0...1, width: 80), "N%"(width 34) } -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CloneHardnessLabel"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider
                        x:Name="CloneHardnessSlider"
                        Width="80"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.01"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        AutomationProperties.AutomationId="negaflow.canvas.grainmend.clone-hardness"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="OnCloneHardnessChanged" />
                    <TextBlock
                        x:Name="CloneHardnessValue"
                        Width="34"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Right" />
                </StackPanel>
                <Border
                    Width="1"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource NegaflowDividerBrush}" />
                <Button
                    x:Name="CloneUndoButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="negaflow.canvas.grainmend.clone-undo"
                    Click="OnCloneUndoClicked"
                    Style="{StaticResource NegaflowHudGlyphButtonStyle}">
                    <FontIcon FontSize="12" Glyph="&#xE7A7;" />
                </Button>
            </StackPanel>
        </Border>

        <!-- macOS classChipsBar: 콘텐츠 폭에 딱 맞춰 가운데. -->
        <Border
            x:Name="ChipsCapsule"
            Margin="0,0,0,12"
            Padding="10,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="negaflow.canvas.grainmend.class-chips"
            Background="{ThemeResource NegaflowPanelBrush}"
            BorderBrush="{ThemeResource NegaflowDividerBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="Collapsed">
            <ItemsControl
                x:Name="ClassChips"
                ItemTemplate="{StaticResource GrainMendClassChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
