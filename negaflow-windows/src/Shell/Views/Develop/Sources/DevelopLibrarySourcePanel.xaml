<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Sources.DevelopLibrarySourcePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:defaults="using:Negaflow.Shell.Views.Library.Defaults"
    xmlns:scanner="using:Negaflow.Shell.Views.Library.Scanner">
    <UserControl.Resources>
        <!-- macOS ImportGlassAction: 한 줄, 24 high, horizontal padding 6,
             hover surface radius 12. 긴 번역은 내부 Viewbox가 아래로만 줄입니다. -->
        <Style x:Key="NegaflowImportActionStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <!-- macOS LibrarySourceSection(content: .combined): 가져오기 3분할 캡슐과
         현재 프레임 폴더 트리를 같은 스크롤 패널에 둡니다. -->
    <ScrollViewer>
        <StackPanel Padding="12,14" Spacing="14">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE896;" />
                    <TextBlock
                        x:Name="LibraryImportSectionText"
                        x:FieldModifier="internal"
                        FontSize="13"
                        FontWeight="SemiBold" />
                </StackPanel>
                <Border
                    Padding="2"
                    Background="{ThemeResource NegaflowSubtleFillBrush}"
                    CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ImportButton"
                            x:FieldModifier="internal"
                            AutomationProperties.AutomationId="negaflow.develop.import.image"
                            Click="OnImportClicked"
                            Style="{StaticResource NegaflowImportActionStyle}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="12" Glyph="&#xE91B;" />
                                    <TextBlock x:Name="ImportImageText" x:FieldModifier="internal" />
                                </StackPanel>
                            </Viewbox>
                        </Button>
                        <Border Grid.Column="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource NegaflowDividerBrush}" />
                        <Button
                            x:Name="ImportFolderButton"
                            x:FieldModifier="internal"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="negaflow.develop.import.folder"
                            Click="OnImportFolderClicked"
                            Style="{StaticResource NegaflowImportActionStyle}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                                    <TextBlock x:Name="ImportFolderText" x:FieldModifier="internal" />
                                </StackPanel>
                            </Viewbox>
                        </Button>
                        <Border Grid.Column="3" Height="16" VerticalAlignment="Center" Background="{ThemeResource NegaflowDividerBrush}" />
                        <Button
                            x:Name="ImportScannerButton"
                            x:FieldModifier="internal"
                            Grid.Column="4"
                            AutomationProperties.AutomationId="negaflow.develop.import.scanner"
                            Click="OnImportScannerClicked"
                            Style="{StaticResource NegaflowImportActionStyle}">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="12" Glyph="&#xE950;" />
                                    <TextBlock x:Name="ImportScannerText" x:FieldModifier="internal" />
                                </StackPanel>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock
                x:Name="ImportStatusText"
                x:FieldModifier="internal"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <!-- macOS 좌측탭은 가져오기 다음에 스캔이 옵니다(`현상뷰_기본.png`).
                 라이브러리뷰와 같은 컨트롤을 씁니다 — 스캐너 상태를 두 벌로 들면 갈라집니다. -->
            <scanner:LibraryScanPanel x:Name="ScanPanel" x:FieldModifier="internal" />
            <!-- macOS `WorkflowSidebar` 의 library 탭은 `LibrarySourceSection` 을
                 `showsDevelopDefaults: true` 로 띄웁니다 — 프로세스·타깃·필름 프로파일·룩이
                 라이브러리뷰뿐 아니라 **현상뷰 좌측탭에도** 같이 옵니다. 라이브러리뷰가 쓰는
                 것과 같은 컨트롤을 그대로 씁니다. 두 벌을 만들면 갈라집니다. -->
            <defaults:LibraryDevelopDefaultsPanel
                x:Name="DevelopDefaultsPanel"
                x:FieldModifier="internal" />
            <TreeView
                x:Name="LibraryTree"
                x:FieldModifier="internal"
                Padding="0"
                AutomationProperties.AutomationId="negaflow.develop.sources.library-tree"
                CanDragItems="False"
                CanReorderItems="False"
                ItemInvoked="OnLibraryTreeItemInvoked"
                SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="TreeViewNode">
                        <TreeViewItem
                            AutomationProperties.Name="{Binding Content.Title, Mode=OneWay}"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            ItemsSource="{Binding Children}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{Binding Content.Glyph, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Content.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Content.Detail, Mode=OneWay}" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
