<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Sources.DevelopLibrarySourcePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sources="using:Negaflow.Shell.Views.Library.Sources"
    xmlns:defaults="using:Negaflow.Shell.Views.Library.Defaults"
    xmlns:scanner="using:Negaflow.Shell.Views.Library.Scanner">
    <!-- macOS LibrarySourceSection(content: .combined): 가져오기 3분할 캡슐과
         현재 프레임 폴더 트리를 같은 스크롤 패널에 둡니다. -->
    <ScrollViewer>
        <StackPanel Padding="12,14" Spacing="14">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE896;" />
                    <TextBlock
                        x:Name="LibraryImportSectionText"
                        x:FieldModifier="internal"
                        FontSize="13"
                        FontWeight="SemiBold" />
                </StackPanel>
                <Border
                    Padding="2"
                    Background="{ThemeResource NegaflowSubtleFillBrush}"
                    CornerRadius="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ImportButton"
                            x:FieldModifier="internal"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="negaflow.develop.import.image"
                            Click="OnImportClicked"
                            Style="{StaticResource NegaflowImportActionStyle}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE91B;" />
                                <TextBlock x:Name="ImportImageText" x:FieldModifier="internal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1" Height="16" VerticalAlignment="Center" Background="{ThemeResource NegaflowDividerBrush}" />
                        <Button
                            x:Name="ImportFolderButton"
                            x:FieldModifier="internal"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="negaflow.develop.import.folder"
                            Click="OnImportFolderClicked"
                            Style="{StaticResource NegaflowImportActionStyle}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE8B7;" />
                                <TextBlock x:Name="ImportFolderText" x:FieldModifier="internal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Height="16" VerticalAlignment="Center" Background="{ThemeResource NegaflowDividerBrush}" />
                        <Button
                            x:Name="ImportScannerButton"
                            x:FieldModifier="internal"
                            Grid.Column="4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="negaflow.develop.import.scanner"
                            Click="OnImportScannerClicked"
                            Style="{StaticResource NegaflowImportActionStyle}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Glyph="&#xE950;" />
                                <TextBlock x:Name="ImportScannerText" x:FieldModifier="internal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock
                x:Name="ImportStatusText"
                x:FieldModifier="internal"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <!-- macOS 좌측탭은 가져오기 다음에 스캔이 옵니다(`현상뷰_기본.png`).
                 라이브러리뷰와 같은 컨트롤을 씁니다 — 스캐너 상태를 두 벌로 들면 갈라집니다. -->
            <scanner:LibraryScanPanel x:Name="ScanPanel" x:FieldModifier="internal" />
            <!-- macOS `WorkflowSidebar` 의 library 탭은 `LibrarySourceSection` 을
                 `showsDevelopDefaults: true` 로 띄웁니다 — 프로세스·타깃·필름 프로파일·룩이
                 라이브러리뷰뿐 아니라 **현상뷰 좌측탭에도** 같이 옵니다. 라이브러리뷰가 쓰는
                 것과 같은 컨트롤을 그대로 씁니다. 두 벌을 만들면 갈라집니다. -->
            <defaults:LibraryDevelopDefaultsPanel
                x:Name="DevelopDefaultsPanel"
                x:FieldModifier="internal" />
            <!-- macOS `LibraryFolderTreeView` — 사진을 담고 있는 폴더와 그 사진만 냅니다. -->
            <sources:LibraryFolderTreeView
                x:Name="LibraryTree"
                x:FieldModifier="internal"
                Padding="0"
                AutomationProperties.AutomationId="negaflow.develop.sources.library-tree" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
