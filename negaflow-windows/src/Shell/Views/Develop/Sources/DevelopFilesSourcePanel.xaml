<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Sources.DevelopFilesSourcePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TreeView
        x:Name="FilesTree"
        x:FieldModifier="internal"
        Padding="4,6"
        AutomationProperties.AutomationId="negaflow.develop.sources.files"
        CanDragItems="False"
        CanReorderItems="False"
        ItemInvoked="OnFilesTreeItemInvoked"
        SelectionMode="Single">
        <TreeView.ItemTemplate>
            <DataTemplate x:DataType="TreeViewNode">
                <TreeViewItem
                    AutomationProperties.Name="{Binding Content.Title, Mode=OneWay}"
                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                    ItemsSource="{Binding Children}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{Binding Content.Glyph, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Text="{Binding Content.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Content.Detail, Mode=OneWay}" />
                    </Grid>
                </TreeViewItem>
            </DataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>
