<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.Develop.Sources.DevelopSourceSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:export="using:Negaflow.Shell.Views.Develop.Export"
    xmlns:versions="using:Negaflow.Shell.Views.Develop.Versions"
    xmlns:presets="using:Negaflow.Shell.Views.Develop.Presets"
    xmlns:film="using:Negaflow.Shell.Views.Develop.Film"
    xmlns:sources="using:Negaflow.Shell.Views.Develop.Sources">
    <Grid Background="{ThemeResource NegaflowPanelBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftRailColumn" x:FieldModifier="internal" Width="76" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <sources:DevelopSourceRail
            x:Name="SourceRail"
            x:FieldModifier="internal"
            Grid.Column="0" />

        <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="DevelopSourceHeader" x:FieldModifier="internal" Grid.Row="0" Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="DevelopSourceIcon" x:FieldModifier="internal" Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE8FD;" />
                <TextBlock x:Name="LibraryHeaderText" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="NoFrameHeaderText" x:FieldModifier="internal" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <!-- 출력 소스: macOS 의 내보내기 설정 패널입니다. 형식·폴더·파일명 패턴을
                 정하고 미리보기로 실제 파일명을 확인한 뒤 내보냅니다. -->
            <export:DevelopExportPanel
                x:Name="ExportPanel"
                x:FieldModifier="internal"
                Grid.Row="2"
                Visibility="Collapsed" />

            <!-- 버전 소스: 지금 recipe 를 이름 붙여 담아 두고 되돌립니다. -->
            <versions:DevelopVersionsPanel
                x:Name="VersionsPanel"
                x:FieldModifier="internal"
                Grid.Row="2"
                Visibility="Collapsed" />

            <!-- 프리셋 소스: macOS 의 복사/붙여넣기와 사용자 프리셋입니다. -->
            <presets:DevelopPresetsPanel
                x:Name="PresetsPanel"
                x:FieldModifier="internal"
                Grid.Row="2"
                Visibility="Collapsed" />

            <!-- 필름 소스: macOS 처럼 digital source 에서만 고를 수 있습니다. -->
            <film:DevelopFilmLookPanel
                x:Name="FilmLookPanel"
                x:FieldModifier="internal"
                Grid.Row="2"
                Visibility="Collapsed" />

            <sources:DevelopFilesSourcePanel
                x:Name="FilesPanel"
                x:FieldModifier="internal"
                Grid.Row="2"
                Visibility="Collapsed" />

            <sources:DevelopLibrarySourcePanel
                x:Name="LibraryPanel"
                x:FieldModifier="internal"
                Grid.Row="2" />
        </Grid>
    </Grid>
</UserControl>
