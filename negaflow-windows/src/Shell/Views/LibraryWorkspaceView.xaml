<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.LibraryWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <UserControl.Resources>
        <!-- ItemsPath 가 없으면 그룹 자체를 열거해 그리드가 항목을 전부 realize 합니다.
             200장에서 200개가 모두 만들어지는 것을 계측으로 확인했습니다. -->
        <CollectionViewSource
            x:Name="FolderGroupedItems"
            IsSourceGrouped="True"
            ItemsPath="Items" />
        <controls:FilmTypeNameConverter x:Key="FilmTypeNameConverter" />
    </UserControl.Resources>
    <Grid x:Name="Root" Background="{ThemeResource NegaflowWindowBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ControlsPanel" Grid.Column="0" Background="{ThemeResource NegaflowPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Padding="22,10,22,0" Spacing="7">
                <Button
                    x:Name="ImportRailButton"
                    AutomationProperties.AutomationId="negaflow.library.controls.importing"
                    Background="{ThemeResource NegaflowSelectionBrush}"
                    Click="OnSourceRailClicked"
                    Style="{StaticResource NegaflowSidebarButtonStyle}"
                    Tag="Importing">
                    <FontIcon x:Name="ImportRailIcon" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE896;" />
                </Button>
                <Button
                    x:Name="FilesRailButton"
                    AutomationProperties.AutomationId="negaflow.library.controls.files"
                    Click="OnSourceRailClicked"
                    Style="{StaticResource NegaflowSidebarButtonStyle}"
                    Tag="Files">
                    <FontIcon x:Name="FilesRailIcon" FontSize="15" Glyph="&#xE8B7;" />
                </Button>
                <Button
                    x:Name="CollectionsRailButton"
                    AutomationProperties.AutomationId="negaflow.library.controls.collections"
                    Click="OnSourceRailClicked"
                    Style="{StaticResource NegaflowSidebarButtonStyle}"
                    Tag="Collections">
                    <FontIcon x:Name="CollectionsRailIcon" FontSize="15" Glyph="&#xE8FD;" />
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SourceHeaderIcon" Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14" Glyph="&#xE896;" />
                    <TextBlock x:Name="ImportHeaderText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceHeaderCountText" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0" />
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

                <ScrollViewer x:Name="ImportSourcePanel" Grid.Row="2">
                    <StackPanel Padding="12,14" Spacing="12">
                        <TextBlock x:Name="ImportSectionText" FontSize="13" FontWeight="SemiBold" />
                        <Border Padding="12" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="8">
                            <StackPanel Spacing="9">
                                <TextBlock x:Uid="importHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button x:Name="ImportImagesButton" Click="OnImportClicked" />
                                <Button x:Name="ImportFoldersButton" Click="OnImportFoldersClicked" />
                                <TextBlock x:Name="ImportStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 파일 소스: 폴더를 펼쳐 그 안의 frame 이름까지 보이는 macOS 트리입니다. -->
                <TreeView
                    x:Name="FilesSourceTree"
                    Grid.Row="2"
                    Padding="4,6"
                    AutomationProperties.AutomationId="negaflow.library.sources.files"
                    CanDragItems="False"
                    CanReorderItems="False"
                    ItemInvoked="OnSourceTreeItemInvoked"
                    SelectionMode="Single"
                    Visibility="Collapsed">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="TreeViewNode">
                            <TreeViewItem
                                AutomationProperties.Name="{Binding Content.Title, Mode=OneWay}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                ItemsSource="{Binding Children}">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{Binding Content.Glyph, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding Content.Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Content.Detail, Mode=OneWay}" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel
                    x:Name="CollectionsSourcePanel"
                    Grid.Row="2"
                    Padding="16,24"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8FD;" />
                    <TextBlock
                        x:Name="CollectionsEmptyText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="ControlsResizeThumb"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Background="Transparent"
            DragCompleted="OnResizeCompleted"
            DragDelta="OnResizeDelta"
            DragStarted="OnResizeStarted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Uid="libraryAllPhotos" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibraryCountText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <ToggleButton
                        x:Name="FiltersButton"
                        Height="28"
                        Padding="6,0"
                        AutomationProperties.AutomationId="negaflow.library.filters"
                        Background="Transparent"
                        BorderThickness="0"
                        Checked="OnFiltersToggled"
                        Unchecked="OnFiltersToggled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="FiltersIcon" FontSize="12" Glyph="&#xE71C;" />
                            <TextBlock x:Name="FiltersText" FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </ToggleButton>
                    <DropDownButton
                        x:Name="SortButton"
                        Height="22"
                        Padding="4,0"
                        AutomationProperties.AutomationId="negaflow.library.sort"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <FontIcon x:Name="SortDirectionIcon" FontSize="9" Glyph="&#xE74A;" />
                            <TextBlock x:Name="SortKeyText" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="SortInputOrderItem" Tag="InputOrder" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortTimeItem" Tag="Time" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortNameItem" Tag="Name" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortFlagItem" Tag="Flag" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortRatingItem" Tag="Rating" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortFileSizeItem" Tag="FileSize" Click="OnSortKeyClicked" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="SortAscendingItem" Tag="Ascending" Click="OnSortDirectionClicked" />
                                <MenuFlyoutItem x:Name="SortDescendingItem" Tag="Descending" Click="OnSortDirectionClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <Button
                            x:Name="CardSizeDecreaseButton"
                            Width="22"
                            Height="22"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.card-size.decrease"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardSizeDecreaseClicked"
                            Content="&#x2212;" />
                        <Button
                            x:Name="CardSizeResetButton"
                            Width="38"
                            Height="22"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.card-size"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardSizeResetClicked"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="CardSizeIncreaseButton"
                            Width="22"
                            Height="22"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.card-size.increase"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardSizeIncreaseClicked"
                            Content="+" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <!-- 필터를 켰을 때만 나오는 줄입니다. macOS 는 팝오버지만 여기서는 헤더 바로 아래에
                 붙여 두 화면 모두에서 같은 순서·같은 항목으로 보이게 합니다. -->
            <ScrollViewer
                x:Name="FilterBar"
                Grid.Row="2"
                Padding="16,6"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <DropDownButton
                        x:Name="RatingFilterButton"
                        Height="26"
                        Padding="8,0"
                        AutomationProperties.AutomationId="negaflow.library.filter.rating"
                        CornerRadius="13"
                        FontSize="11">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="RatingFilterAnyItem" Tag="0" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterOneItem" Tag="1" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterTwoItem" Tag="2" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterThreeItem" Tag="3" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterFourItem" Tag="4" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterFiveItem" Tag="5" Click="OnRatingFilterClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <ToggleButton x:Name="PickedFilterToggle" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.picked" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="RejectedFilterToggle" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.rejected" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="OfflineFilterToggle" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.offline" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="InfraredFilterToggle" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.infrared" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="DefectRecipeFilterToggle" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.defect-recipe" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <Button x:Name="ClearFiltersButton" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.clear" Background="Transparent" BorderThickness="0" Click="OnClearFiltersClicked" FontSize="11" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3">
                <StackPanel x:Name="EmptyLibraryPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                    <FontIcon FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8FD;" />
                    <TextBlock x:Uid="noImages" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <Button x:Name="EmptyImportImagesButton" HorizontalAlignment="Center" Click="OnImportClicked" />
                </StackPanel>

                <Grid x:Name="LibraryContentPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 읽지 못한 frame 을 조용히 감추면 사용자에게는 사진이 사라진 것으로 보인다. -->
                    <InfoBar
                        x:Name="LibraryIssueBar"
                        Grid.Row="0"
                        Margin="16,10,16,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <GridView
                        x:Name="FrameListView"
                        Grid.Row="1"
                        Padding="8,6"
                        AutomationProperties.AutomationId="negaflow.library.frames"
                        ContainerContentChanging="OnFrameContainerChanging"
                        DoubleTapped="OnFrameDoubleTapped"
                        IsItemClickEnabled="False"
                        SelectionMode="Single">
                        <GridView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,12,6,2" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Count}" />
                                            <!-- macOS 는 폴더 머리줄에 현상 프로세스와 적용을 답니다. -->
                                            <ComboBox
                                                Grid.Column="2"
                                                MinWidth="128"
                                                Height="26"
                                                Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="negaflow.library.folder.process"
                                                DisplayMemberPath="Name"
                                                FontSize="11"
                                                ItemsSource="{Binding ProcessChoices}"
                                                SelectedIndex="{Binding ProcessIndex, Mode=OneWay}"
                                                SelectionChanged="OnFolderProcessChanged"
                                                Tag="{Binding}" />
                                            <Button
                                                x:Uid="libraryLocateFolder"
                                                Grid.Column="3"
                                                Margin="8,0,0,0"
                                                Tag="{Binding}"
                                                Padding="4,0"
                                                AutomationProperties.AutomationId="negaflow.library.relink-folder"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnLocateFolderClicked"
                                                Visibility="{Binding IsRegistered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>
                        <!--
                            카드 한 장의 구조는 macOS FrameStripItemView 와 같습니다 — 썸네일,
                            3pt 간격, 이름, 필름 종류, 그리고 맨 아래 별점입니다. 카드 크기는
                            컨테이너에서 정하므로 여기서는 비율만 잡습니다.
                        -->
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Border Background="{ThemeResource NegaflowThumbnailWellBrush}" CornerRadius="6" />
                                        <Border
                                            CornerRadius="6"
                                            Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Border>
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE91B;"
                                            Visibility="{Binding IsThumbnailPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button
                                            x:Uid="libraryLocateOriginal"
                                            Margin="5"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Background="#B8000000"
                                            BorderThickness="0"
                                            CornerRadius="9"
                                            FontSize="10"
                                            Click="OnLocateOriginalClicked"
                                            Tag="{Binding}"
                                            Visibility="{Binding IsSourceOffline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding FilmType, Converter={StaticResource FilmTypeNameConverter}}"
                                        TextTrimming="CharacterEllipsis" />
                                    <controls:FrameRatingStars
                                        Grid.Row="4"
                                        HorizontalAlignment="Left"
                                        Rating="{Binding Rating}"
                                        RatingCommitted="OnRatingCommitted"
                                        Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <StackPanel
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Spacing="6">
                    <Border Width="280" Padding="2" Background="{ThemeResource NegaflowSubtleFillBrush}" CornerRadius="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AllModeButton" Grid.Column="0" Padding="6,0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="negaflow.library.view.all" Click="OnAllModeClicked" />
                            <Button x:Name="FoldersModeButton" Grid.Column="1" Padding="6,0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="negaflow.library.view.folders" Click="OnFoldersModeClicked" />
                            <DropDownButton x:Name="FilmTypeModeButton" Grid.Column="2" Padding="6,0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="negaflow.library.view.film-type">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="ColorNegativeFilmTypeItem" Tag="ColorNegative" Click="OnFilmTypeClicked" />
                                        <MenuFlyoutItem x:Name="ColorPositiveFilmTypeItem" Tag="ColorPositive" Click="OnFilmTypeClicked" />
                                        <MenuFlyoutItem x:Name="BlackAndWhiteNegativeFilmTypeItem" Tag="BlackAndWhiteNegative" Click="OnFilmTypeClicked" />
                                        <MenuFlyoutItem x:Name="BlackAndWhitePositiveFilmTypeItem" Tag="BlackAndWhitePositive" Click="OnFilmTypeClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="OfflineModeButton" Grid.Column="3" Padding="6,0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="negaflow.library.view.offline" Click="OnOfflineModeClicked" />
                        </Grid>
                    </Border>
                    <TextBox
                        x:Name="LibrarySearchBox"
                        x:Uid="librarySearchPlaceholder"
                        Width="280"
                        Height="28"
                        AutomationProperties.AutomationId="negaflow.library.search"
                        TextChanged="OnLibrarySearchTextChanged" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
