<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.LibraryWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:scanner="using:Negaflow.Shell.Views.Library.Scanner"
    xmlns:culling="using:Negaflow.Shell.Views.Library.Culling"
    xmlns:sources="using:Negaflow.Shell.Views.Library.Sources"
    xmlns:collections="using:Negaflow.Shell.Views.Library.Collections"
    xmlns:browser="using:Negaflow.Shell.Views.Library.Browser">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- ItemsPath 가 없으면 그룹 자체를 열거해 그리드가 항목을 전부 realize 합니다.
                 200장에서 200개가 모두 만들어지는 것을 계측으로 확인했습니다. -->
            <CollectionViewSource
                x:Name="FolderGroupedItems" x:FieldModifier="internal"
                IsSourceGrouped="True"
                ItemsPath="Items" />
            <controls:FilmTypeNameConverter x:Key="FilmTypeNameConverter" />
            <controls:PickStateBrushConverter x:Key="PickStateBrushConverter" />
            <!-- 각 보기 모드 칸은 항상 1/4 폭을 유지하고, 긴 번역만 칸 안에서 축소합니다. -->
            <DataTemplate x:Key="LibraryModeTextTemplate">
                <Viewbox
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    StretchDirection="DownOnly">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding}"
                        TextAlignment="Center"
                        TextWrapping="NoWrap" />
                </Viewbox>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root" x:FieldModifier="internal" Background="{ThemeResource NegaflowWindowBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <sources:LibrarySourcePanel x:Name="ControlsPanel" x:FieldModifier="internal" Grid.Column="0" />

        <Border Grid.Column="1" Background="{ThemeResource NegaflowDividerBrush}" />
        <primitives:Thumb
            x:Name="ControlsResizeThumb" x:FieldModifier="internal"
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Background="Transparent"
            DragCompleted="OnResizeCompleted"
            DragDelta="OnResizeDelta"
            DragStarted="OnResizeStarted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="LibraryAllPhotosLocalized" x:FieldModifier="internal" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibraryCountText" x:FieldModifier="internal" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <ToggleButton
                        x:Name="FiltersButton" x:FieldModifier="internal"
                        Height="28"
                        Padding="6,0"
                        AutomationProperties.AutomationId="negaflow.library.filters"
                        Background="Transparent"
                        BorderThickness="0"
                        Checked="OnFiltersToggled"
                        Unchecked="OnFiltersToggled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="FiltersIcon" x:FieldModifier="internal" FontSize="12" Glyph="&#xE71C;" />
                            <TextBlock x:Name="FiltersText" x:FieldModifier="internal" FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </ToggleButton>
                    <DropDownButton
                        x:Name="SortButton" x:FieldModifier="internal"
                        Height="22"
                        Padding="4,0"
                        AutomationProperties.AutomationId="negaflow.library.sort"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <FontIcon x:Name="SortDirectionIcon" x:FieldModifier="internal" FontSize="9" Glyph="&#xE74A;" />
                            <TextBlock x:Name="SortKeyText" x:FieldModifier="internal" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="SortInputOrderItem" x:FieldModifier="internal" Tag="InputOrder" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortTimeItem" x:FieldModifier="internal" Tag="Time" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortNameItem" x:FieldModifier="internal" Tag="Name" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortFlagItem" x:FieldModifier="internal" Tag="Flag" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortRatingItem" x:FieldModifier="internal" Tag="Rating" Click="OnSortKeyClicked" />
                                <MenuFlyoutItem x:Name="SortFileSizeItem" x:FieldModifier="internal" Tag="FileSize" Click="OnSortKeyClicked" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="SortAscendingItem" x:FieldModifier="internal" Tag="Ascending" Click="OnSortDirectionClicked" />
                                <MenuFlyoutItem x:Name="SortDescendingItem" x:FieldModifier="internal" Tag="Descending" Click="OnSortDirectionClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <!-- macOS LibraryCullingModePicker: 격자와 살펴보기 두 칸, 그리고 고른 수. -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="CullingGridButton" x:FieldModifier="internal"
                            Width="27"
                            Height="24"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.culling.grid"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCullingModeClicked"
                            CornerRadius="6"
                            Tag="Grid">
                            <controls:VectorIcon IconSize="12" Kind="GridTwoByTwo" />
                        </Button>
                        <Button
                            x:Name="CullingSurveyButton" x:FieldModifier="internal"
                            Width="27"
                            Height="24"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.culling.survey"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCullingModeClicked"
                            CornerRadius="6"
                            Tag="Survey">
                            <controls:VectorIcon IconSize="12" Kind="SurveyGrid" />
                        </Button>
                        <Button
                            x:Name="CullingCompareButton" x:FieldModifier="internal"
                            Width="27"
                            Height="24"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.culling.compare"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCullingModeClicked"
                            CornerRadius="6"
                            Tag="Compare">
                            <controls:VectorIcon IconSize="12" Kind="CompareSplit" />
                        </Button>
                        <TextBlock
                            x:Name="CullingSelectionCountText" x:FieldModifier="internal"
                            MinWidth="22"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="1">
                        <Button
                            x:Name="CardSizeDecreaseButton" x:FieldModifier="internal"
                            Width="22"
                            Height="22"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.card-size.decrease"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardSizeDecreaseClicked"
                            Content="&#x2212;" />
                        <Button
                            x:Name="CardSizeResetButton" x:FieldModifier="internal"
                            Width="38"
                            Height="22"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.card-size"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardSizeResetClicked"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="CardSizeIncreaseButton" x:FieldModifier="internal"
                            Width="22"
                            Height="22"
                            Padding="0"
                            AutomationProperties.AutomationId="negaflow.library.card-size.increase"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardSizeIncreaseClicked"
                            Content="+" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource NegaflowDividerBrush}" />

            <!-- 필터를 켰을 때만 나오는 줄입니다. macOS 는 팝오버지만 여기서는 헤더 바로 아래에
                 붙여 두 화면 모두에서 같은 순서·같은 항목으로 보이게 합니다. -->
            <ScrollViewer
                x:Name="FilterBar" x:FieldModifier="internal"
                Grid.Row="2"
                Padding="16,6"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <DropDownButton
                        x:Name="RatingFilterButton" x:FieldModifier="internal"
                        Height="26"
                        Padding="8,0"
                        AutomationProperties.AutomationId="negaflow.library.filter.rating"
                        CornerRadius="13"
                        FontSize="11">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="RatingFilterAnyItem" x:FieldModifier="internal" Tag="0" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterOneItem" x:FieldModifier="internal" Tag="1" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterTwoItem" x:FieldModifier="internal" Tag="2" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterThreeItem" x:FieldModifier="internal" Tag="3" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterFourItem" x:FieldModifier="internal" Tag="4" Click="OnRatingFilterClicked" />
                                <MenuFlyoutItem x:Name="RatingFilterFiveItem" x:FieldModifier="internal" Tag="5" Click="OnRatingFilterClicked" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <ToggleButton x:Name="CurrentRollFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.current-roll" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="PickedFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.picked" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="RejectedFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.rejected" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="OfflineFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.offline" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="InfraredFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.infrared" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="DefectRecipeFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.defect-recipe" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="UnvalidatedProfileFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.unvalidated-profile" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <ToggleButton x:Name="MetadataUnknownFilterToggle" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.metadata-unknown" CornerRadius="13" Checked="OnQuickFilterToggled" FontSize="11" Unchecked="OnQuickFilterToggled" />
                    <Button x:Name="ClearFiltersButton" x:FieldModifier="internal" Height="26" Padding="8,0" AutomationProperties.AutomationId="negaflow.library.filter.clear" Background="Transparent" BorderThickness="0" Click="OnClearFiltersClicked" FontSize="11" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3">
                <StackPanel x:Name="EmptyLibraryPanel" x:FieldModifier="internal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                    <FontIcon FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8FD;" />
                    <TextBlock x:Name="NoImagesLocalized" x:FieldModifier="internal" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <Button x:Name="EmptyImportImagesButton" x:FieldModifier="internal" HorizontalAlignment="Center" Click="OnImportClicked" />
                </StackPanel>

                <Grid x:Name="LibraryContentPanel" x:FieldModifier="internal" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 읽지 못한 frame 을 조용히 감추면 사용자에게는 사진이 사라진 것으로 보인다. -->
                    <InfoBar
                        x:Name="LibraryIssueBar" x:FieldModifier="internal"
                        Grid.Row="0"
                        Margin="16,10,16,0"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <GridView
                        x:Name="FrameListView" x:FieldModifier="internal"
                        Grid.Row="1"
                        Padding="8,6"
                        AutomationProperties.AutomationId="negaflow.library.frames"
                        CanDragItems="True"
                        ContainerContentChanging="OnFrameContainerChanging"
                        DoubleTapped="OnFrameDoubleTapped"
                        DragItemsStarting="OnFrameDragStarting"
                        IsItemClickEnabled="False"
                        SelectionChanged="OnFrameSelectionChanged"
                        SelectionMode="Extended">
                        <!-- 머리줄은 `LibraryFolderHeader` UserControl 입니다. 여기 적은
                             이벤트가 이 페이지의 커넥터에 연결되므로 실제로 동작합니다 —
                             `x:Class` 없는 ResourceDictionary 의 DataTemplate 에 적으면
                             한 개도 연결되지 않습니다. -->
                        <GridView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <browser:LibraryFolderHeader
                                            ApplyClicked="OnFolderApplyClicked"
                                            DisclosureClicked="OnFolderDisclosureClicked"
                                            ProcessChanged="OnFolderProcessChanged"
                                            TargetChanged="OnFolderTargetChanged" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <browser:LibraryFrameCard
                                    CardRightTapped="OnFrameRightTapped"
                                    LocateOriginalClicked="OnLocateOriginalClicked"
                                    RatingCommitted="OnRatingCommitted" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <culling:LibraryCullingSurface
                        x:Name="CullingSurface" x:FieldModifier="internal"
                        Grid.Row="1"
                        Visibility="Collapsed" />

                </Grid>

                <StackPanel
                    x:Name="LibraryBottomBar" x:FieldModifier="internal"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Spacing="6">
                    <!-- macOS 기준 280pt에서, 다국어 캡슐 문구가 잘리지 않도록
                         사용자 요청에 따라 20% 확장한 336pt입니다. -->
                    <Border Width="336" Padding="2" Background="{ThemeResource NegaflowCardBrush}" CornerRadius="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- macOS `LibraryViewMode.allCases` 차례 그대로입니다 —
                                 폴더별 · 필름 종류 · 오프라인 · 전체. 칸은 높이 28 · 좌우 여백 6 ·
                                 라운딩 14 · 글꼴 `.caption.weight(.semibold)` 입니다. -->
                            <Button x:Name="FoldersModeButton" x:FieldModifier="internal" Grid.Column="0" Height="28" MinHeight="28" MinWidth="0" Padding="4,0" CornerRadius="14" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{StaticResource LibraryModeTextTemplate}" AutomationProperties.AutomationId="negaflow.library.view.folders" Click="OnFoldersModeClicked" />
                            <Button x:Name="FilmTypeModeButton" x:FieldModifier="internal" Grid.Column="1" Height="28" MinHeight="28" MinWidth="0" Padding="4,0" CornerRadius="14" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{StaticResource LibraryModeTextTemplate}" AutomationProperties.AutomationId="negaflow.library.view.film-type">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="ColorNegativeFilmTypeItem" x:FieldModifier="internal" Tag="ColorNegative" Click="OnFilmTypeClicked" />
                                        <MenuFlyoutItem x:Name="ColorPositiveFilmTypeItem" x:FieldModifier="internal" Tag="ColorPositive" Click="OnFilmTypeClicked" />
                                        <MenuFlyoutItem x:Name="BlackAndWhiteNegativeFilmTypeItem" x:FieldModifier="internal" Tag="BlackAndWhiteNegative" Click="OnFilmTypeClicked" />
                                        <MenuFlyoutItem x:Name="BlackAndWhitePositiveFilmTypeItem" x:FieldModifier="internal" Tag="BlackAndWhitePositive" Click="OnFilmTypeClicked" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="OfflineModeButton" x:FieldModifier="internal" Grid.Column="2" Height="28" MinHeight="28" MinWidth="0" Padding="4,0" CornerRadius="14" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{StaticResource LibraryModeTextTemplate}" AutomationProperties.AutomationId="negaflow.library.view.offline" Click="OnOfflineModeClicked" />
                            <Button x:Name="AllModeButton" x:FieldModifier="internal" Grid.Column="3" Height="28" MinHeight="28" MinWidth="0" Padding="4,0" CornerRadius="14" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{StaticResource LibraryModeTextTemplate}" AutomationProperties.AutomationId="negaflow.library.view.all" Click="OnAllModeClicked" />
                        </Grid>
                    </Border>
                    <!-- macOS `LibrarySearchField` — `HStack(spacing: 7) { 돋보기, TextField, 지우기 }`
                         에 좌우 여백 9 · 336×28 · 라운딩 7 · 테두리 primary 12% 입니다.
                         지우기는 글자가 있을 때만 나옵니다. -->
                    <Border
                        Width="336"
                        Height="28"
                        Padding="9,0"
                        BorderBrush="{ThemeResource NegaflowDividerBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource NegaflowCardBrush}"
                        CornerRadius="7">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE721;" />
                            <TextBox
                                x:Name="LibrarySearchBox" x:FieldModifier="internal"
                                Grid.Column="1"
                                Height="28"
                                MinHeight="0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Padding="0,5,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                TextWrapping="NoWrap"
                                AutomationProperties.AutomationId="negaflow.library.search"
                                TextChanged="OnLibrarySearchTextChanged" />
                            <Button
                                x:Name="LibraryClearSearchButton" x:FieldModifier="internal"
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="negaflow.library.search.clear"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnLibraryClearSearchClicked"
                                Visibility="Collapsed">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE10A;" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
