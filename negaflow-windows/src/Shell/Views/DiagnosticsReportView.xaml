<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.DiagnosticsReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="negaflow.diagnostics.panel">
    <!--
        macOS DiagnosticsReportView 와 같은 골격입니다 - 머리줄(제목·생성 시각·전체 복사·
        새로고침) 아래 구역 카드 넷: 최근 문제 · 최근 실패 이벤트 · 라이브러리 상태 · 스캐너.
        수치도 그대로입니다: 안쪽 여백 20 · 구역 사이 14 · 내용 폭 500.
    -->
    <Grid Background="{ThemeResource NegaflowWindowBrush}" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="Bold"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="GeneratedText"
                Grid.Column="1"
                FontSize="11"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="CopyAllButton"
                Grid.Column="2"
                Height="26"
                AutomationProperties.AutomationId="negaflow.diagnostics.copy-all"
                Click="OnCopyAllClick" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                Width="26"
                Height="26"
                Padding="0"
                AutomationProperties.AutomationId="negaflow.diagnostics.refresh"
                Click="OnRefreshClick">
                <FontIcon FontSize="13" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Sections" Spacing="14" />
        </ScrollViewer>
    </Grid>
</UserControl>
