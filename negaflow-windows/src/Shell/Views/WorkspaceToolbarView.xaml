<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Negaflow.Shell.Views.WorkspaceToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="TitleBarRoot"
        Height="40"
        Padding="12,6,10,6"
        Background="{ThemeResource NegaflowWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCaptionInsetColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="502" />
            <ColumnDefinition x:Name="RightCaptionInsetColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
            <Button
                x:Name="QuickExportButton"
                Height="24"
                Padding="5,0"
                AutomationProperties.AutomationId="negaflow.quick-export"
                Click="OnQuickExportClick"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontSize="13" Glyph="&#xE945;" />
                    <TextBlock x:Uid="commandQuickExport" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Border Width="1" Height="14" Margin="4,5" Background="{ThemeResource NegaflowDividerBrush}" />
            <Button
                x:Name="ExportButton"
                Height="24"
                Padding="5,0"
                AutomationProperties.AutomationId="negaflow.export"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontSize="13" Glyph="&#xE72D;" />
                    <TextBlock x:Uid="commandExport" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            Margin="12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <FontIcon FontSize="11" Glyph="&#xE72E;" />
            <TextBlock x:Uid="noSelection" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Column="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="LibraryButton"
                    Grid.Column="0"
                    AutomationProperties.AutomationId="negaflow.workspace.library"
                    Click="OnLibraryClick"
                    Style="{StaticResource NegaflowToolbarTextButtonStyle}" />
                <Border Grid.Column="1" Width="1" Height="14" HorizontalAlignment="Center" Background="{ThemeResource NegaflowDividerBrush}" />
                <Button
                    x:Name="DevelopButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="negaflow.workspace.develop"
                    Click="OnDevelopClick"
                    Style="{StaticResource NegaflowToolbarTextButtonStyle}" />
                <Border Grid.Column="3" Width="1" Height="14" HorizontalAlignment="Center" Background="{ThemeResource NegaflowDividerBrush}" />
                <Button
                    x:Name="PrintButton"
                    Grid.Column="4"
                    AutomationProperties.AutomationId="negaflow.workspace.print"
                    Click="OnPrintClick"
                    Style="{StaticResource NegaflowToolbarTextButtonStyle}" />
            </Grid>

            <Border
                Grid.Column="2"
                Padding="1"
                Background="{ThemeResource NegaflowSubtleFillBrush}"
                CornerRadius="7">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="SidebarButton"
                        AutomationProperties.AutomationId="negaflow.panel.sidebar"
                        Click="OnSidebarClick"
                        Style="{StaticResource NegaflowToolbarIconButtonStyle}">
                        <FontIcon FontSize="13" Glyph="&#xE700;" />
                    </Button>
                    <Button
                        x:Name="FilmstripButton"
                        AutomationProperties.AutomationId="negaflow.panel.filmstrip"
                        Click="OnFilmstripClick"
                        Style="{StaticResource NegaflowToolbarIconButtonStyle}">
                        <FontIcon FontSize="13" Glyph="&#xE8A9;" />
                    </Button>
                    <Button
                        x:Name="InspectorButton"
                        AutomationProperties.AutomationId="negaflow.panel.inspector"
                        Click="OnInspectorClick"
                        Style="{StaticResource NegaflowToolbarIconButtonStyle}">
                        <FontIcon FontSize="13" Glyph="&#xE701;" />
                    </Button>
                </StackPanel>
            </Border>

            <Button
                x:Name="AppearanceButton"
                Grid.Column="3"
                Style="{StaticResource NegaflowToolbarIconButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE706;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="SystemAppearanceItem" Click="OnSystemAppearanceClick" />
                        <MenuFlyoutItem x:Name="DarkAppearanceItem" Click="OnDarkAppearanceClick" />
                        <MenuFlyoutItem x:Name="LightAppearanceItem" Click="OnLightAppearanceClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button
                x:Name="UtilityButton"
                Grid.Column="4"
                Style="{StaticResource NegaflowToolbarIconButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="SettingsItem" Click="OnSettingsClick" Icon="Setting" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="DiagnosticsItem" IsEnabled="False" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
