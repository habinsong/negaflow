<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Negaflow.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:sources="using:Negaflow.Shell.Views.Library.Sources"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Pills.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Segments.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NegaflowWindowBrush" Color="#FFF8F8F8" />
                    <SolidColorBrush x:Key="NegaflowPanelBrush" Color="#FFF0F1F3" />
                    <SolidColorBrush x:Key="NegaflowBarBrush" Color="#FFF5F5F6" />
                    <SolidColorBrush x:Key="NegaflowCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowDividerBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="NegaflowCanvasBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="NegaflowSubtleFillBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="NegaflowSelectionBrush" Color="#296B8BFF" />
                    <SolidColorBrush x:Key="NegaflowThumbnailWellBrush" Color="#38808080" />
                    <SolidColorBrush x:Key="NegaflowCardBorderBrush" Color="#2E000000" />
                    <SolidColorBrush x:Key="NegaflowRatingFilledBrush" Color="#FF007AFF" />
                    <SolidColorBrush x:Key="NegaflowRatingEmptyBrush" Color="#73000000" />
                    <SolidColorBrush x:Key="NegaflowAccentBrush" Color="#FF007AFF" />
                    <SolidColorBrush x:Key="NegaflowAccentSoftBrush" Color="#33007AFF" />
                    <SolidColorBrush x:Key="NegaflowHoverFillBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="NegaflowSegmentTrackBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="NegaflowSegmentThumbBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NegaflowWindowBrush" Color="#FF1D1D1D" />
                    <SolidColorBrush x:Key="NegaflowPanelBrush" Color="#FF292A2C" />
                    <SolidColorBrush x:Key="NegaflowBarBrush" Color="#FF242426" />
                    <SolidColorBrush x:Key="NegaflowCardBrush" Color="#FF333436" />
                    <SolidColorBrush x:Key="NegaflowDividerBrush" Color="#32FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowCanvasBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="NegaflowSubtleFillBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowSelectionBrush" Color="#386B8BFF" />
                    <SolidColorBrush x:Key="NegaflowThumbnailWellBrush" Color="#38808080" />
                    <SolidColorBrush x:Key="NegaflowCardBorderBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowRatingFilledBrush" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="NegaflowRatingEmptyBrush" Color="#73FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowAccentBrush" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="NegaflowAccentSoftBrush" Color="#330A84FF" />
                    <SolidColorBrush x:Key="NegaflowHoverFillBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowSegmentTrackBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowSegmentThumbBrush" Color="#FF333436" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NegaflowWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowSubtleFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowThumbnailWellBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowRatingFilledBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowRatingEmptyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowAccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowHoverFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowSegmentTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowSegmentThumbBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!--
                설정 창 컨트롤의 테마 색입니다.

                색을 코드에서 Application.Current.Resources["..."] 로 읽으면 안 됩니다. 그
                조회는 ThemeDictionaries 를 요소의 테마로 풀지 않아서, 앱을 "밝게" 로 두어도
                어두운 값이 나옵니다 - 밝은 모드에서 설정 카드가 통째로 검게 나온 원인입니다.
                Style 세터의 {ThemeResource} 는 요소마다 풀리고 테마가 바뀌면 다시 풀립니다.
            -->
            <!-- macOS ImportGlassAction: 한 줄, 24 high, horizontal padding 6,
                 hover surface radius 12. 긴 번역은 안쪽 Viewbox 가 아래로만 줄입니다.
                 라이브러리 좌측탭과 현상 좌측탭이 같은 막대를 쓰므로 한 곳에만 둡니다. -->
            <Style x:Key="NegaflowImportActionStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <!-- 스캐너 칸만 켜짐 상태가 있습니다. 나머지 값은 위와 같습니다. -->
            <Style x:Key="NegaflowImportToggleStyle" TargetType="primitives:ToggleButton">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <!-- 폴더 목록 한 줄의 색입니다. 코드에서 Application.Current.Resources 로 읽으면
                 ThemeDictionaries 가 요소 테마로 풀리지 않으므로, 위 주의대로 여기서 겁니다. -->
            <Style TargetType="sources:LibraryFolderTreeView">
                <Setter Property="sources:LibraryFolderRowBrushes.AccentBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="sources:LibraryFolderRowBrushes.PrimaryBrush" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="sources:LibraryFolderRowBrushes.SecondaryBrush" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="sources:LibraryFolderRowBrushes.HeaderBackground" Value="{ThemeResource NegaflowSubtleFillBrush}" />
            </Style>
            <Style TargetType="controls:SettingsSection">
                <Setter Property="controls:SettingsBrushes.CardBackground" Value="{ThemeResource NegaflowCardBrush}" />
                <Setter Property="controls:SettingsBrushes.DividerBrush" Value="{ThemeResource NegaflowDividerBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsToggleRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsValueRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsFootnote">
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsBody">
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsSliderRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsPathRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:NegaflowSegmentedPicker">
                <Setter Property="controls:SettingsBrushes.TrackBrush" Value="{ThemeResource NegaflowSegmentTrackBrush}" />
                <Setter Property="controls:SettingsBrushes.ThumbBrush" Value="{ThemeResource NegaflowSegmentThumbBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>


            <Style x:Key="NegaflowToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="74" />
                <Setter Property="MaxWidth" Value="86" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="NegaflowToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="NegaflowSidebarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <!--
                설정창 탭 한 칸입니다. 수치는 맥 스크린샷 실측 - Views/Controls/SettingsLayout.cs.
                칸은 56x48 로 모두 같고, 여덟 칸이 한 덩어리로 가운데 섭니다.
            -->
            <!--
                설정창 탭 한 칸입니다.

                 폭을 고정하면 안 됩니다. macOS 는 탭을 **글자에 맞춰** 넓히고 최소 폭만
                둡니다 — 그래서 "일반"(2자)과 "워크플로우"(5자)의 칸이 다릅니다. 54 로 못박아
                두었더니 한국어에서 "인터페이스"와 "워크플로우"가 서로 겹쳐 붙었고, 독일어처럼
                더 긴 말은 아예 읽을 수 없게 됩니다.

                실측(일반.png): 아이콘 중심 간격 54.7~62(평균 57.2) · 선택 배경 높이 48 ·
                라운딩 10. 최소 54 에 좌우 여백 6 을 주면 그 간격이 그대로 나옵니다.
            -->
            <Style x:Key="NegaflowSettingsCategoryButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="54" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="6,0,6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
