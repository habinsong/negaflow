<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Negaflow.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Negaflow.Shell.Views.Controls"
    xmlns:print="using:Negaflow.Shell.Views.Print.Settings"
    xmlns:sources="using:Negaflow.Shell.Views.Library.Sources"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Pills.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Segments.xaml" />
                <!-- 알약 판형(Pills)을 `BasedOn` 으로 물려받으므로 그 뒤에 옵니다. -->
                <ResourceDictionary Source="ms-appx:///Styles/Export.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Inspector.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NegaflowWindowBrush" Color="#FFF8F8F8" />
                    <SolidColorBrush x:Key="NegaflowPanelBrush" Color="#FFF0F1F3" />
                    <SolidColorBrush x:Key="NegaflowBarBrush" Color="#FFF5F5F6" />
                    <SolidColorBrush x:Key="NegaflowCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowDividerBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="NegaflowCanvasBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="NegaflowSubtleFillBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="NegaflowSelectionBrush" Color="#296B8BFF" />
                    <SolidColorBrush x:Key="NegaflowThumbnailWellBrush" Color="#38808080" />
                    <SolidColorBrush x:Key="NegaflowCardBorderBrush" Color="#2E000000" />
                    <SolidColorBrush x:Key="NegaflowRatingFilledBrush" Color="#FF007AFF" />
                    <SolidColorBrush x:Key="NegaflowRatingEmptyBrush" Color="#73000000" />
                    <SolidColorBrush x:Key="NegaflowAccentBrush" Color="#FF007AFF" />
                    <!-- 파일 목록 한 줄의 글자·아이콘입니다. macOS `Color.primary` 는 밝은
                         테마에서 순검정입니다. WinUI 의 TextFillColorPrimaryBrush 는
                         #E4000000(89%)이라 흐려 보입니다(실측). -->
                    <SolidColorBrush x:Key="NegaflowRowTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="NegaflowAccentSoftBrush" Color="#33007AFF" />
                    <!-- 인화 인스펙터 탭의 고른 칸입니다. macOS `accentColor.opacity(0.16)`. -->
                    <SolidColorBrush x:Key="NegaflowAccentTabBrush" Color="#29007AFF" />
                    <SolidColorBrush x:Key="NegaflowHoverFillBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="NegaflowSegmentTrackBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="NegaflowSegmentThumbBrush" Color="#FFFFFFFF" />
                    <!--
                        macOS `liquidSurface` 한 벌입니다. 어두운 테마 실측
                        (현상뷰_좌측탭_세로탭_내보내기.png): 카드 45,46,47 위의 표면이
                        66,67,68 → 흰색 10%, 두르는 실선은 94,96,97 → 흰색 20%.
                        분리선은 65,66,67 → 흰색 10% 입니다. 밝은 테마는 같은 비율의 검정입니다.
                    -->
                    <SolidColorBrush x:Key="NegaflowGlassFillBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="NegaflowGlassStrokeBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="NegaflowFormDividerBrush" Color="#1A000000" />
                    <!-- 캡슐 분절에서 고른 칸입니다. 밝은 테마는 흰 카드 위 흰 알약입니다. -->
                    <SolidColorBrush x:Key="NegaflowGlassSegmentThumbBrush" Color="#FFFFFFFF" />
                    <!--
                        WinUI 기본 Button/Slider/Toggle/Radio/CheckBox 템플릿은
                        NegaflowAccentBrush가 아니라 SystemAccentColorDark*를 읽습니다.
                        기본 토큰이 Windows 시스템 남색으로 남지 않도록 macOS systemBlue에
                        맞춥니다. 명시적인 하늘색 채널 색상은 이 토큰과 별개라 유지됩니다.
                    -->
                    <Color x:Key="SystemAccentColor">#007AFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#007AFF</Color>
                    <Color x:Key="SystemAccentColorDark2">#007AFF</Color>
                    <Color x:Key="SystemAccentColorDark3">#007AFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NegaflowWindowBrush" Color="#FF1D1D1D" />
                    <SolidColorBrush x:Key="NegaflowPanelBrush" Color="#FF292A2C" />
                    <SolidColorBrush x:Key="NegaflowBarBrush" Color="#FF242426" />
                    <SolidColorBrush x:Key="NegaflowCardBrush" Color="#FF333436" />
                    <SolidColorBrush x:Key="NegaflowDividerBrush" Color="#32FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowCanvasBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="NegaflowSubtleFillBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowSelectionBrush" Color="#386B8BFF" />
                    <SolidColorBrush x:Key="NegaflowThumbnailWellBrush" Color="#38808080" />
                    <SolidColorBrush x:Key="NegaflowCardBorderBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowRatingFilledBrush" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="NegaflowRatingEmptyBrush" Color="#73FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowAccentBrush" Color="#FF0A84FF" />
                    <!-- 어두운 테마에서는 순백입니다. -->
                    <SolidColorBrush x:Key="NegaflowRowTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowAccentSoftBrush" Color="#330A84FF" />
                    <SolidColorBrush x:Key="NegaflowAccentTabBrush" Color="#290A84FF" />
                    <SolidColorBrush x:Key="NegaflowHoverFillBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowSegmentTrackBrush" Color="#12FFFFFF" />
                    <!--
                        macOS `SegmentedPicker` 의 고른 칸은 `.background`(창 바탕)로 채웁니다 —
                        즉 카드보다 **어둡습니다**. 실측(인화뷰_기본.png): 카드 47,49,50 ·
                        트랙 60,61,62 · 고른 칸 38,42,45. 카드와 같은 #333436 을 쓰면 고른 칸이
                        카드에 묻혀 **선택 표시가 아예 보이지 않습니다**(사용자 신고).
                    -->
                    <SolidColorBrush x:Key="NegaflowSegmentThumbBrush" Color="#FF292A2C" />
                    <!-- 위 밝은 테마의 주석과 같은 실측값입니다. -->
                    <SolidColorBrush x:Key="NegaflowGlassFillBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="NegaflowGlassStrokeBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="NegaflowFormDividerBrush" Color="#1AFFFFFF" />
                    <!-- 어두운 테마에서 고른 칸은 카드보다 **어둡습니다**(40,41,42 = 검정 11%). -->
                    <SolidColorBrush x:Key="NegaflowGlassSegmentThumbBrush" Color="#1C000000" />
                    <!-- WinUI 기본 강조색을 macOS의 어두운 테마 systemBlue로 고정합니다. -->
                    <Color x:Key="SystemAccentColor">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorDark2">#0A84FF</Color>
                    <Color x:Key="SystemAccentColorDark3">#0A84FF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NegaflowWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowSubtleFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowThumbnailWellBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowRatingFilledBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowRatingEmptyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowRowTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowAccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowAccentTabBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowHoverFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowSegmentTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowSegmentThumbBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NegaflowGlassFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NegaflowGlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowFormDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NegaflowGlassSegmentThumbBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!--
                설정 창 컨트롤의 테마 색입니다.

                색을 코드에서 Application.Current.Resources["..."] 로 읽으면 안 됩니다. 그
                조회는 ThemeDictionaries 를 요소의 테마로 풀지 않아서, 앱을 "밝게" 로 두어도
                어두운 값이 나옵니다 - 밝은 모드에서 설정 카드가 통째로 검게 나온 원인입니다.
                Style 세터의 {ThemeResource} 는 요소마다 풀리고 테마가 바뀌면 다시 풀립니다.
            -->
            <!-- macOS ImportGlassAction: 한 줄, 24 high, horizontal padding 6,
                 hover surface radius 12. 긴 번역은 안쪽 Viewbox 가 아래로만 줄입니다.
                 라이브러리 좌측탭과 현상 좌측탭이 같은 막대를 쓰므로 한 곳에만 둡니다. -->
            <Style x:Key="NegaflowImportActionStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ImportActionRoot" Background="Transparent" CornerRadius="12">
                                <Border x:Name="ImportActionHover" CornerRadius="12" />
                                <ContentPresenter
                                    x:Name="ImportActionContent"
                                    HorizontalAlignment="Stretch"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ImportActionHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ImportActionHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                                <Setter Target="ImportActionContent.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ImportActionRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 스캐너 칸만 켜짐 상태가 있습니다. 나머지 값은 위와 같습니다. -->
            <Style x:Key="NegaflowImportToggleStyle" TargetType="primitives:ToggleButton">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:ToggleButton">
                            <Grid x:Name="ImportToggleRoot" Background="Transparent" CornerRadius="12">
                                <Border x:Name="ImportToggleHover" CornerRadius="12" />
                                <ContentPresenter
                                    x:Name="ImportToggleContent"
                                    HorizontalAlignment="Stretch"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ImportToggleHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ImportToggleHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                                <Setter Target="ImportToggleContent.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked" />
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ImportToggleHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="ImportToggleHover.Background" Value="{ThemeResource NegaflowHoverFillBrush}" />
                                                <Setter Target="ImportToggleContent.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="ImportToggleRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ImportToggleRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="IndeterminatePointerOver" />
                                        <VisualState x:Name="IndeterminatePressed" />
                                        <VisualState x:Name="IndeterminateDisabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 폴더 목록 한 줄의 색입니다. 코드에서 Application.Current.Resources 로 읽으면
                 ThemeDictionaries 가 요소 테마로 풀리지 않으므로, 위 주의대로 여기서 겁니다. -->
            <Style TargetType="sources:LibraryFolderTreeView">
                <!-- 고른 사진과 그 폴더는 <b>맥이 쓰는 파랑</b>입니다. 라이트·다크 모두
                     같은 계열이며(#007AFF · #0A84FF), Windows 시스템 강조색은 사용자가
                     바꿀 수 있어 맥과 달라지므로 쓰지 않습니다. -->
                <Setter Property="sources:LibraryFolderRowBrushes.AccentBrush" Value="{ThemeResource NegaflowAccentBrush}" />
                <!-- 라이트=검정, 다크=흰색. 두 값 모두 <b>불투명도 100%</b> 입니다 — 흐린
                     회색으로 두면 폴더와 사진 이름이 모두 꺼져 보입니다. 장수와 ✕ 도 같은
                     색입니다(사용자 지시: "아이콘과 텍스트 모두"). -->
                <Setter Property="sources:LibraryFolderRowBrushes.PrimaryBrush" Value="{ThemeResource NegaflowRowTextBrush}" />
                <Setter Property="sources:LibraryFolderRowBrushes.SecondaryBrush" Value="{ThemeResource NegaflowRowTextBrush}" />
                <Setter Property="sources:LibraryFolderRowBrushes.HeaderBackground" Value="{ThemeResource NegaflowSubtleFillBrush}" />
            </Style>
            <Style TargetType="controls:SettingsSection">
                <Setter Property="controls:SettingsBrushes.CardBackground" Value="{ThemeResource NegaflowCardBrush}" />
                <Setter Property="controls:SettingsBrushes.DividerBrush" Value="{ThemeResource NegaflowDividerBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="print:PrintInspectorDivider">
                <Setter Property="controls:SettingsBrushes.DividerBrush" Value="{ThemeResource NegaflowDividerBrush}" />
            </Style>
            <Style TargetType="controls:SettingsRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsToggleRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsValueRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="controls:SettingsBrushes.DangerBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style TargetType="controls:SettingsFootnote">
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsBody">
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsSliderRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:SettingsPathRow">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="controls:NegaflowSegmentedPicker">
                <Setter Property="controls:SettingsBrushes.TrackBrush" Value="{ThemeResource NegaflowSegmentTrackBrush}" />
                <Setter Property="controls:SettingsBrushes.ThumbBrush" Value="{ThemeResource NegaflowSegmentThumbBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="controls:SettingsBrushes.SecondaryForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="NegaflowToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="74" />
                <Setter Property="MaxWidth" Value="86" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="NegaflowToolbarIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="NegaflowSidebarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RailRoot" Background="Transparent" CornerRadius="9">
                                <Border
                                    x:Name="RailSelection"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9" />
                                <ContentPresenter
                                    x:Name="RailContent"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <!-- 선택 음영은 마우스가 올라가도 그대로 둡니다. -->
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RailRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 스캔 카드의 보조 단추는 네모 테두리 없이 가져오기 캡슐과 같은 호버 표면만 냅니다. -->
            <Style
                x:Key="NegaflowScannerPlainButtonStyle"
                BasedOn="{StaticResource NegaflowImportActionStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!--
                설정창 탭 한 칸입니다. 수치는 맥 스크린샷 실측 - Views/Controls/SettingsLayout.cs.
                칸은 56x48 로 모두 같고, 여덟 칸이 한 덩어리로 가운데 섭니다.
            -->
            <!--
                설정창 탭 한 칸입니다.

                 폭을 고정하면 안 됩니다. macOS 는 탭을 **글자에 맞춰** 넓히고 최소 폭만
                둡니다 — 그래서 "일반"(2자)과 "워크플로우"(5자)의 칸이 다릅니다. 54 로 못박아
                두었더니 한국어에서 "인터페이스"와 "워크플로우"가 서로 겹쳐 붙었고, 독일어처럼
                더 긴 말은 아예 읽을 수 없게 됩니다.

                실측(일반.png): 아이콘 중심 간격 54.7~62(평균 57.2) · 선택 배경 높이 48 ·
                라운딩 10. 최소 54 에 좌우 여백 6 을 주면 그 간격이 그대로 나옵니다.
            -->
            <Style x:Key="NegaflowSettingsCategoryButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="54" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="6,0,6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <!--
                필름스트립 칸의 선택 표시입니다. WinUI 기본은 <b>왼쪽 세로 막대</b>인데,
                여기서는 <b>위쪽 가로 막대</b>로 둡니다. 크기·모양·색은 기본과 같습니다 —
                실행 중인 창에서 잰 값(배율 1.5)입니다: 두께 5px=3, 길이 153px=102,
                가장자리에서 6px=4, 끝 테이퍼 1px → 반지름 1.5, 색 #007AFF.
            -->
            <!--
                필름스트립 칸입니다. WinUI 기본 선택 표시(<b>왼쪽 세로 막대</b>)만 끕니다 —
                같은 막대를 칸 템플릿의 <b>위쪽 가로</b>로 다시 그립니다. 프리젠터를 Grid 로
                감싸면 XAML 이 죽습니다(실측: 0xc000027b, Microsoft.UI.Xaml.dll). 그래서
                프리젠터는 템플릿의 뿌리 그대로 둡니다.
            -->
            <Style x:Key="NegaflowFilmstripItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                Control.IsTemplateFocusTarget="True"
                                ContentMargin="{TemplateBinding Padding}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                SelectionIndicatorVisualEnabled="False"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
