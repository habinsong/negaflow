<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <AssemblyName>Negaflow.Shell</AssemblyName>
    <RootNamespace>Negaflow.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- 생성된 Program.Main 을 끄고 Program.cs 에서 두 번째 실행을 넘깁니다.
         창·카탈로그를 만든 뒤에는 늦습니다. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- DeploymentManager 모듈 초기화는 Program.Main 보다 먼저 돌아, 패키지 없이
         exe 를 직접 실행한 두 번째 프로세스가 REGDB_E_CLASSNOTREG (0x80040154) 로
         죽습니다. 선출은 Main 에서 하고, 이긴 프로세스만 Initialize 합니다. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>Assets\Negaflow.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interop\Negaflow.Interop.csproj" />
    <ProjectReference Include="..\Shell.Core\Negaflow.Shell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\presets\*.json"
             Link="presets\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <NativePreset Condition="'$(Platform)' == 'x64' and '$(Configuration)' == 'Debug'">x64-debug</NativePreset>
    <NativePreset Condition="'$(Platform)' == 'x64' and '$(Configuration)' == 'Release'">x64-release</NativePreset>
    <NativePreset Condition="'$(Platform)' == 'ARM64' and '$(Configuration)' == 'Debug'">arm64-debug</NativePreset>
    <NativePreset Condition="'$(Platform)' == 'ARM64' and '$(Configuration)' == 'Release'">arm64-release</NativePreset>
    <NativeLibrarySource>$(MSBuildThisFileDirectory)..\..\out\build\native\$(NativePreset)\$(Configuration)\Negaflow.Native.dll</NativeLibrarySource>
    <!-- 카메라 RAW 디코더. Windows 는 RAW codec 을 기본 제공하지 않으므로 이것이 없으면
         DNG/CR2/NEF 가져오기가 Microsoft Store 확장이 깔린 기계에서만 된다.
         scripts\build-libraw.ps1 이 만든다. -->
    <LibRawLibrarySource>$(MSBuildThisFileDirectory)..\..\out\build\native\$(NativePreset)\Release\libraw.dll</LibRawLibrarySource>
    <!-- libraw 는 `/openmp` 로 빌드해 디모자이크를 코어 수만큼 나눈다(Fuji X-Trans
         14.1 초 → 4.5 초). 그 대가로 `vcomp140.dll` 하나가 늘며, 이것이 없으면
         libraw.dll 자체가 로드되지 않아 RAW 가 통째로 죽는다 — 반드시 함께 놓는다. -->
    <OpenMpRuntimeSource>$(MSBuildThisFileDirectory)..\..\out\build\native\$(NativePreset)\Release\vcomp140.dll</OpenMpRuntimeSource>
  </PropertyGroup>

  <!-- MSIX loose layout과 최종 패키지에 모두 넣는다. Build 뒤 TargetDir에만
       복사하면 패키징은 이미 끝나 ABI 엔진이 빠진 채 앱이 LoadFailed가 된다. -->
  <ItemGroup Condition="Exists('$(NativeLibrarySource)')">
    <Content Include="$(NativeLibrarySource)"
             Link="Negaflow.Native.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- libraw.dll 은 `LoadLibraryExW(LOAD_LIBRARY_SEARCH_APPLICATION_DIR)` 로 열리므로
       실행 파일과 같은 폴더에 있어야 한다. 없어도 빌드는 통과한다 — 그때는 RAW 만
       "no available decoder" 로 끝나고 나머지 형식은 그대로 동작한다. -->
  <ItemGroup Condition="Exists('$(LibRawLibrarySource)')">
    <Content Include="$(LibRawLibrarySource)"
             Link="libraw.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(OpenMpRuntimeSource)')">
    <Content Include="$(OpenMpRuntimeSource)"
             Link="vcomp140.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 셸은 웹 콘텐츠를 렌더링하지 않는데도 WinUI package graph가 WebView2 페이로드
       약 1.6MB를 binplace한다. 배포물에서 빼면 BSD-3-Clause 재배포 의무와 WebView2가
       끌고 오는 하위 third-party notice 사슬이 함께 사라진다. ADR-0022 참조.
       WebView2 XAML 컨트롤을 쓰기 시작하면 이 target을 지워야 한다. -->
  <Target Name="RemoveUnusedWebView2Payload" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2')) Or '%(Filename)' == 'WebView2Loader'" />
    </ItemGroup>
  </Target>

  <!-- Publish 는 Build 출력의 모든 임의 DLL을 자동 수집하지 않는다. 설치 payload가
       native ABI 엔진 없이 만들어지는 것을 막기 위해 Build와 Publish 양쪽에 둔다. -->
  <Target Name="CopyNativeEngine" AfterTargets="Build;Publish" Condition="Exists('$(NativeLibrarySource)')">
    <Copy SourceFiles="$(NativeLibrarySource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NativeLibrarySource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- `winapp run`은 AppX 느슨한 레이아웃에서 실행한다. Content 메타데이터만으로는
       일반 Build 뒤 이 디렉터리에 파일이 생기지 않으므로, ABI 엔진을 명시적으로 동기화한다. -->
  <Target Name="CopyNativeEngineToAppxLayout" AfterTargets="Build"
          Condition="Exists('$(NativeLibrarySource)') And Exists('$(TargetDir)AppX')">
    <Copy SourceFiles="$(NativeLibrarySource)" DestinationFolder="$(TargetDir)AppX"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyApplicationIcon" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets\Negaflow.ico" DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets\Negaflow.ico" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- 설치본에서 XAML 리소스 PRI를 빠뜨리지 않는다. -->
  <Target Name="CopyUnpackagedPriResources" AfterTargets="Publish"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
